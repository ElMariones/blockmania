#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Bronze"
msgstr "Bronze"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Gold"
msgstr "Ouro"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Legendary"
msgstr "Lendário"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Silver"
msgstr "Prata"

#: game/content/achievements.gd:13
msgid "ARCADE & SECRETS"
msgstr "ARCADE E SEGREDOS"

#: game/content/achievements.gd:13
msgid "LEGENDS"
msgstr "LENDAS"

#: game/content/achievements.gd:13
msgid "THE BAG & THE SHOP"
msgstr "A SACOLA E A LOJA"

#: game/content/achievements.gd:13
msgid "THE CAMPAIGN"
msgstr "A CAMPANHA"

#: game/content/achievements.gd:13
msgid "THE SCOREBOARD"
msgstr "O PLACAR"

#: game/content/achievements.gd:21
msgid "Clear your first line."
msgstr "Limpe sua primeira linha."

#: game/content/achievements.gd:21
msgid "First Crack"
msgstr "Primeira rachadura"

#: game/content/achievements.gd:21
msgid "It's a start. A very satisfying start."
msgstr "É um começo. Um começo muito satisfatório."

#: game/content/achievements.gd:22
msgid "The target never stood a chance."
msgstr "A meta não teve a menor chance."

#: game/content/achievements.gd:22
msgid "Warmed Up"
msgstr "Aquecido"

#: game/content/achievements.gd:22
msgid "Win a round."
msgstr "Vença uma rodada."

#: game/content/achievements.gd:23
msgid "Boss Buster"
msgstr "Caça-chefes"

#: game/content/achievements.gd:23
msgid "Defeat a boss."
msgstr "Derrote um chefe."

#: game/content/achievements.gd:23
msgid "They always look bigger on the poster."
msgstr "No pôster eles sempre parecem maiores."

#: game/content/achievements.gd:24
msgid "Intermission is over. Back to your seats."
msgstr "O intervalo acabou. Voltem aos seus lugares."

#: game/content/achievements.gd:24
msgid "Reach Act 2 (round 5)."
msgstr "Chegue ao ato 2 (rodada 5)."

#: game/content/achievements.gd:24
msgid "Second Act"
msgstr "Segundo ato"

#: game/content/achievements.gd:25
msgid "Final Act"
msgstr "Ato final"

#: game/content/achievements.gd:25
msgid "Reach Act 3 (round 9)."
msgstr "Chegue ao ato 3 (rodada 9)."

#: game/content/achievements.gd:25
msgid "The curtain is starting to twitch."
msgstr "A cortina está começando a tremer."

#: game/content/achievements.gd:26
msgid "Blink and you missed it."
msgstr "Piscou, perdeu."

#: game/content/achievements.gd:26
msgid "Speedrunner"
msgstr "Speedrunner"

#: game/content/achievements.gd:26
msgid "Win a round in five placements or fewer."
msgstr "Vença uma rodada em cinco jogadas ou menos."

#: game/content/achievements.gd:27
msgid "BLOCKMANIA!"
msgstr "BLOCKMANIA!"

#: game/content/achievements.gd:27
msgid "Beat the game: win round 12."
msgstr "Zere o jogo: vença a rodada 12."

#: game/content/achievements.gd:27
msgid "Twelve rounds, three bosses, one very full board."
msgstr "Doze rodadas, três chefes e um tabuleiro bem cheio."

#: game/content/achievements.gd:28
msgid "A good builder never blames the Kit."
msgstr "Um bom construtor nunca culpa o kit."

#: game/content/achievements.gd:28
msgid "Beat the game with any Kit other than the Standard Kit."
msgstr "Zere o jogo com qualquer kit que não seja o Kit padrão."

#: game/content/achievements.gd:28
msgid "Different Tools"
msgstr "Outras ferramentas"

#: game/content/achievements.gd:29 game/content/tips.gd:33
msgid "Overtime"
msgstr "Prorrogação"

#: game/content/achievements.gd:29
msgid "The arcade was supposed to close an hour ago."
msgstr "O fliperama devia ter fechado há uma hora."

#: game/content/achievements.gd:29
msgid "Win a round in Overtime (after beating the game, keep playing)."
msgstr "Vença uma rodada na prorrogação (depois de zerar o jogo, continue jogando)."

#: game/content/achievements.gd:30
msgid "Every target is a cliff now."
msgstr "Agora toda meta é um penhasco."

#: game/content/achievements.gd:30
msgid "Reach round 20 in Overtime."
msgstr "Chegue à rodada 20 na prorrogação."

#: game/content/achievements.gd:30
msgid "Sudden Death"
msgstr "Morte súbita"

#: game/content/achievements.gd:31
msgid "No Off Switch"
msgstr "Sem botão de desligar"

#: game/content/achievements.gd:31
msgid "Reach round 30 in Overtime."
msgstr "Chegue à rodada 30 na prorrogação."

#: game/content/achievements.gd:31
msgid "Somebody unplug this thing."
msgstr "Alguém tire isso da tomada."

#: game/content/achievements.gd:32
msgid "Broke the Machine"
msgstr "Máquina quebrada"

#: game/content/achievements.gd:32
msgid "ERR ERR ERR. Please insert more digits."
msgstr "ERR ERR ERR. Insira mais dígitos, por favor."

#: game/content/achievements.gd:32
msgid "Score a single placement past the machine's limit (1,000,000,000,000,000 points)."
msgstr "Passe do limite da máquina com uma única jogada (1 000 000 000 000 000 pontos)."

#: game/content/achievements.gd:32
msgid "Some scores are too big for any machine."
msgstr "Algumas pontuações são grandes demais para qualquer máquina."

#: game/content/achievements.gd:34
msgid "Blue Period"
msgstr "Fase azul"

#: game/content/achievements.gd:34
msgid "Feeling a little blue? Feeling VERY blue."
msgstr "Meio pra baixo? Não: MUITO azul."

#: game/content/achievements.gd:34
msgid "Have 10 or more blue pieces in your bag."
msgstr "Tenha 10 ou mais peças azuis na sacola."

#: game/content/achievements.gd:35
msgid "Have 10 or more Square pieces (2x2 or 3x3) in your bag."
msgstr "Tenha 10 ou mais peças Quadrado (2x2 ou 3x3) na sacola."

#: game/content/achievements.gd:35
msgid "Square Dance"
msgstr "Quadrilha"

#: game/content/achievements.gd:35
msgid "Swing your partner, stack your blocks."
msgstr "Gire o par, empilhe os blocos."

#: game/content/achievements.gd:36
msgid "Full Spectrum"
msgstr "Espectro completo"

#: game/content/achievements.gd:36
msgid "Have at least five pieces of every color in your bag."
msgstr "Tenha pelo menos cinco peças de cada cor na sacola."

#: game/content/achievements.gd:36
msgid "Taste the whole toybox."
msgstr "Prove o baú de brinquedos inteiro."

#: game/content/achievements.gd:37
msgid "Have 40 or more pieces in your bag."
msgstr "Tenha 40 ou mais peças na sacola."

#: game/content/achievements.gd:37
msgid "Packrat"
msgstr "Acumulador"

#: game/content/achievements.gd:37
msgid "You never know when you'll need a spare T."
msgstr "Nunca se sabe quando vai precisar de um T reserva."

#: game/content/achievements.gd:38
msgid "Only the essentials."
msgstr "Só o essencial."

#: game/content/achievements.gd:38
msgid "Shrink your bag to 14 pieces or fewer."
msgstr "Reduza a sacola para 14 peças ou menos."

#: game/content/achievements.gd:38
msgid "Travel Light"
msgstr "Viajando leve"

#: game/content/achievements.gd:39
msgid "Alchemist"
msgstr "Alquimista"

#: game/content/achievements.gd:39
msgid "Own pieces of all five materials at once: Chrome, Neon, Gold, Glass and Prism."
msgstr "Tenha ao mesmo tempo peças dos cinco materiais: cromo, neon, ouro, vidro e prisma."

#: game/content/achievements.gd:39
msgid "Plastic into gold, gold into glass."
msgstr "Plástico em ouro, ouro em vidro."

#: game/content/achievements.gd:40
msgid "Own pieces with all four stamps at once: Encore, Refund, Tip and Memory."
msgstr "Tenha ao mesmo tempo peças com os quatro selos: Bis, Reembolso, Gorjeta e Memória."

#: game/content/achievements.gd:40
msgid "Signed, sealed, stamped four times."
msgstr "Assinado, lacrado e carimbado quatro vezes."

#: game/content/achievements.gd:40
msgid "Special Delivery"
msgstr "Entrega especial"

#: game/content/achievements.gd:41
msgid "Fill every Joker slot."
msgstr "Preencha todos os espaços de Curinga."

#: game/content/achievements.gd:41
msgid "Full House"
msgstr "Lotação esgotada"

#: game/content/achievements.gd:41
msgid "No vacancies at the Joker hotel."
msgstr "Não há vagas no hotel dos Curingas."

#: game/content/achievements.gd:42
msgid "Hold three Rare Jokers at the same time."
msgstr "Tenha três Curingas raros ao mesmo tempo."

#: game/content/achievements.gd:42
msgid "Only the finest cardboard."
msgstr "Só o papelão mais fino."

#: game/content/achievements.gd:42
msgid "Rare Taste"
msgstr "Gosto refinado"

#: game/content/achievements.gd:43
msgid "Master Plan"
msgstr "Plano mestre"

#: game/content/achievements.gd:43
msgid "Raise a shape family to Schematic level 3."
msgstr "Leve uma família de formas ao nível 3 de projeto."

#: game/content/achievements.gd:43
msgid "The blueprints have blueprints."
msgstr "Os projetos têm projetos."

#: game/content/achievements.gd:44
msgid "Hold 50 or more Credits."
msgstr "Tenha 50 créditos ou mais."

#: game/content/achievements.gd:44
msgid "Oink."
msgstr "Oinc."

#: game/content/achievements.gd:44
msgid "Piggy Bank"
msgstr "Cofrinho"

#: game/content/achievements.gd:45
msgid "Even a wallet has a limit."
msgstr "Até uma carteira tem limite."

#: game/content/achievements.gd:45
msgid "Hold the maximum 99 Credits."
msgstr "Tenha o máximo de 99 créditos."

#: game/content/achievements.gd:45
msgid "Scrooge"
msgstr "Pão-duro"

#: game/content/achievements.gd:45
msgid "Swimming in coins is harder than it looks."
msgstr "Nadar em moedas é mais difícil do que parece."

#: game/content/achievements.gd:47
msgid "Big Hit"
msgstr "Golpe forte"

#: game/content/achievements.gd:47
msgid "Ka-chunk."
msgstr "Ka-chunk."

#: game/content/achievements.gd:47
msgid "Score 1,000 points with one placement."
msgstr "Faça 1 000 pontos com uma jogada."

#: game/content/achievements.gd:48
msgid "Mega Hit"
msgstr "Mega golpe"

#: game/content/achievements.gd:48
msgid "Score 10,000 points with one placement."
msgstr "Faça 10 000 pontos com uma jogada."

#: game/content/achievements.gd:48
msgid "The receipt printer is sweating."
msgstr "A impressora de recibos está suando."

#: game/content/achievements.gd:49
msgid "Giga Hit"
msgstr "Giga golpe"

#: game/content/achievements.gd:49
msgid "Score 1,000,000 points with one placement."
msgstr "Faça 1 000 000 de pontos com uma jogada."

#: game/content/achievements.gd:49
msgid "That's a lot of zeros for one little piece."
msgstr "É muito zero para uma peça tão pequena."

#: game/content/achievements.gd:50
msgid "Clear three lines with one placement."
msgstr "Limpe três linhas com uma jogada."

#: game/content/achievements.gd:50
msgid "Stacked high and cleared clean."
msgstr "Bem empilhado, bem limpo."

#: game/content/achievements.gd:50
msgid "Triple Decker"
msgstr "Três andares"

#: game/content/achievements.gd:51
msgid "Clear four or more lines with one placement."
msgstr "Limpe quatro ou mais linhas com uma jogada."

#: game/content/achievements.gd:51
msgid "Four-Alarm Fire"
msgstr "Alerta máximo"

#: game/content/achievements.gd:51
msgid "Somebody call the block brigade."
msgstr "Alguém chame a brigada dos blocos."

#: game/content/achievements.gd:52
msgid "Clear a row and a column with one placement."
msgstr "Limpe uma fileira e uma coluna com uma jogada."

#: game/content/achievements.gd:52
msgid "Crossroads"
msgstr "Encruzilhada"

#: game/content/achievements.gd:52
msgid "X marks the spot."
msgstr "O X marca o lugar."

#: game/content/achievements.gd:53
msgid "Don't touch the board, it's hot."
msgstr "Não toque no tabuleiro, está quente."

#: game/content/achievements.gd:53
msgid "Reach the maximum combo (x4)."
msgstr "Alcance o combo máximo (x4)."

#: game/content/achievements.gd:53
msgid "Red Hot"
msgstr "Em brasa"

#: game/content/achievements.gd:54
msgid "Finish a round with at least three times its target."
msgstr "Termine uma rodada com pelo menos o triplo da meta."

#: game/content/achievements.gd:54
msgid "Overkill"
msgstr "Exagero"

#: game/content/achievements.gd:54
msgid "The target asked for a little. You gave a lot."
msgstr "A meta pediu pouco. Você deu muito."

#: game/content/achievements.gd:55
msgid "By a Thread"
msgstr "Por um fio"

#: game/content/achievements.gd:55
msgid "Close. So close. Close enough!"
msgstr "Perto. Muito perto. Perto o bastante!"

#: game/content/achievements.gd:55
msgid "Win a round with your very last placement."
msgstr "Vença uma rodada com sua última jogada."

#: game/content/achievements.gd:56
msgid "Leave the board completely empty after a clear (campaign)."
msgstr "Deixe o tabuleiro totalmente vazio depois de uma limpeza (campanha)."

#: game/content/achievements.gd:56
msgid "Spotless"
msgstr "Impecável"

#: game/content/achievements.gd:56
msgid "You could eat off this board."
msgstr "Dá para comer em cima deste tabuleiro."

#: game/content/achievements.gd:57
msgid "Get dealt a Grand Slam Tray Hand."
msgstr "Receba uma mão Grand Slam na bandeja."

#: game/content/achievements.gd:57 game/rules/hands.gd:17
msgid "Grand Slam"
msgstr "Grand Slam"

#: game/content/achievements.gd:57
msgid "Three of a kind, one color, all the lights."
msgstr "Trinca, uma cor, todas as luzes."

#: game/content/achievements.gd:58
msgid "Full Deck"
msgstr "Baralho completo"

#: game/content/achievements.gd:58
msgid "See all five Tray Hands (across any runs)."
msgstr "Veja as cinco mãos da bandeja (em quaisquer partidas)."

#: game/content/achievements.gd:58
msgid "Twins, Staircase, Monochrome, Triplets, Grand Slam. Collected."
msgstr "Gêmeos, Escada, Monocromo, Trigêmeos, Grand Slam. Coleção completa."

#: game/content/achievements.gd:60
msgid "Arcade Rookie"
msgstr "Novato do fliperama"

#: game/content/achievements.gd:60
msgid "Put your initials in. Go on."
msgstr "Coloque suas iniciais. Vai lá."

#: game/content/achievements.gd:60
msgid "Score 5,000 points in one Endless game."
msgstr "Faça 5 000 pontos em uma partida do Infinito."

#: game/content/achievements.gd:61
msgid "Arcade Regular"
msgstr "Frequentador do fliperama"

#: game/content/achievements.gd:61
msgid "Score 25,000 points in one Endless game."
msgstr "Faça 25 000 pontos em uma partida do Infinito."

#: game/content/achievements.gd:61
msgid "The cabinet knows your name."
msgstr "A máquina já sabe seu nome."

#: game/content/achievements.gd:62
msgid "Arcade Legend"
msgstr "Lenda do fliperama"

#: game/content/achievements.gd:62
msgid "Score 100,000 points in one Endless game."
msgstr "Faça 100 000 pontos em uma partida do Infinito."

#: game/content/achievements.gd:62
msgid "They're going to name the cabinet after you."
msgstr "Vão dar seu nome à máquina."

#: game/content/achievements.gd:63
msgid "Blockstorm"
msgstr "Tempestade de blocos"

#: game/content/achievements.gd:63
msgid "Reach the x10 combo in Endless."
msgstr "Alcance o combo x10 no Infinito."

#: game/content/achievements.gd:63
msgid "Ten out of ten. No notes."
msgstr "Nota dez. Sem observações."

#: game/content/achievements.gd:64
msgid "Ahh. That new-board smell."
msgstr "Ahh. Esse cheirinho de tabuleiro novo."

#: game/content/achievements.gd:64
msgid "Clear the whole board in Endless."
msgstr "Limpe o tabuleiro inteiro no Infinito."

#: game/content/achievements.gd:64
msgid "Fresh Start"
msgstr "Recomeço"

#: game/content/achievements.gd:65
msgid "BL...CKM...NIA? Where did everything go?"
msgstr "BL...CKM...NIA? Para onde foi tudo?"

#: game/content/achievements.gd:65
msgid "Have every letter of the BLOCKMANIA logo blown up at once."
msgstr "Exploda ao mesmo tempo todas as letras do logo BLOCKMANIA."

#: game/content/achievements.gd:65
msgid "The title looks awfully fragile."
msgstr "O título parece terrivelmente frágil."

#: game/content/achievements.gd:65
msgid "Vandal"
msgstr "Vândalo"

#: game/content/achievements.gd:66
msgid "Night Shift"
msgstr "Turno da noite"

#: game/content/achievements.gd:66
msgid "Place a piece between midnight and 5 AM."
msgstr "Coloque uma peça entre meia-noite e 5 da manhã."

#: game/content/achievements.gd:66
msgid "Some players only come out after dark."
msgstr "Alguns jogadores só aparecem depois que escurece."

#: game/content/achievements.gd:66
msgid "The blocks glow brighter at night. Probably."
msgstr "À noite os blocos brilham mais. Provavelmente."

#: game/content/achievements.gd:67
msgid "Look Ma, No Lines"
msgstr "Olha, mãe, sem linhas"

#: game/content/achievements.gd:67
msgid "Technically, the rules never said you HAD to."
msgstr "Tecnicamente, as regras nunca disseram que você PRECISAVA."

#: game/content/achievements.gd:67
msgid "Who needs lines anyway?"
msgstr "Quem precisa de linhas, afinal?"

#: game/content/achievements.gd:67
msgid "Win a campaign round without clearing a single line."
msgstr "Vença uma rodada da campanha sem limpar uma única linha."

#: game/content/achievements.gd:68
msgid "Butterfingers"
msgstr "Mão furada"

#: game/content/achievements.gd:68
msgid "Handle with care."
msgstr "Frágil, manuseie com cuidado."

#: game/content/achievements.gd:68
msgid "Shatter a Glass piece."
msgstr "Quebre uma peça de vidro."

#: game/content/achievements.gd:68
msgid "That one's coming out of your allowance."
msgstr "Essa vai sair da sua mesada."

#: game/content/achievements.gd:69
msgid "In case of emergency, break something."
msgstr "Em caso de emergência, quebre algo."

#: game/content/achievements.gd:69
msgid "Through the Window"
msgstr "Pela janela"

#: game/content/achievements.gd:69
msgid "Throw an Emergency Brick."
msgstr "Arremesse um tijolo de emergência."

#: game/content/achievements.gd:69
msgid "Who's paying for that?"
msgstr "Quem vai pagar por isso?"

#: game/content/achievements.gd:70
msgid "Always read the small text."
msgstr "Leia sempre as letras miúdas."

#: game/content/achievements.gd:70
msgid "Get a lost round replayed by Insurance Policy."
msgstr "Faça a Apólice de Seguro repetir uma rodada perdida."

#: game/content/achievements.gd:70
msgid "Terms and conditions apply. Luckily, they applied to you."
msgstr "Sujeito a termos e condições. Por sorte, eles valeram para você."

#: game/content/achievements.gd:70
msgid "The Fine Print"
msgstr "As letras miúdas"

#: game/content/achievements.gd:71
msgid "Block Maniac"
msgstr "Blocomaníaco"

#: game/content/achievements.gd:71
msgid "The whole trophy case. Every last shelf. Take a bow."
msgstr "A vitrine inteira. Até a última prateleira. Faça uma reverência."

#: game/content/achievements.gd:71
msgid "Unlock every other achievement."
msgstr "Desbloqueie todas as outras conquistas."

#: game/content/achievements.gd:73
msgid "It hums a little when you hold it."
msgstr "Ele zumbe um pouco quando você o segura."

#: game/content/achievements.gd:73
msgid "Once Upon a Legend"
msgstr "Era uma vez uma lenda"

#: game/content/achievements.gd:73
msgid "Own a Legendary Joker."
msgstr "Tenha um Curinga lendário."

#: game/content/achievements.gd:74
msgid "Double Legend"
msgstr "Lenda dupla"

#: game/content/achievements.gd:74
msgid "One legend is a story. Two is a problem."
msgstr "Uma lenda é uma história. Duas são um problema."

#: game/content/achievements.gd:74
msgid "Own two Legendary Jokers at the same time."
msgstr "Tenha dois Curingas lendários ao mesmo tempo."

#: game/content/achievements.gd:74
msgid "The rack has never looked so smug."
msgstr "A estante nunca pareceu tão convencida."

#: game/content/achievements.gd:75
msgid "Own each of the four Legendary Jokers (across any runs)."
msgstr "Tenha cada um dos quatro Curingas lendários (em quaisquer partidas)."

#: game/content/achievements.gd:75
msgid "Pantheon"
msgstr "Panteão"

#: game/content/achievements.gd:75
msgid "The Avalanche, the Mirrors, the Stone and the Star. All accounted for."
msgstr "A Avalanche, os Espelhos, a Pedra e a Estrela. Todos presentes."

#: game/content/achievements.gd:76
msgid "Chain Reaction"
msgstr "Reação em cadeia"

#: game/content/achievements.gd:76
msgid "Chain three clear waves in one placement with The Avalanche."
msgstr "Encadeie três ondas de limpeza em uma jogada com A Avalanche."

#: game/content/achievements.gd:76
msgid "Nobody touch anything. Let it fall."
msgstr "Ninguém toca em nada. Deixa cair."

#: game/content/achievements.gd:77
msgid "How many of you are in there?"
msgstr "Quantos de você tem aí dentro?"

#: game/content/achievements.gd:77
msgid "Mirror World"
msgstr "Mundo espelhado"

#: game/content/achievements.gd:77
msgid "Score a placement where Hall of Mirrors doubles four other Jokers."
msgstr "Pontue uma jogada em que o Salão dos Espelhos duplica outros quatro Curingas."

#: game/content/achievements.gd:78
msgid "Chrome, neon, gold and glass. Very little plastic left."
msgstr "Cromo, neon, ouro e vidro. Quase não sobrou plástico."

#: game/content/achievements.gd:78
msgid "Have 15 or more pieces with a material in your bag."
msgstr "Tenha 15 ou mais peças com material na sacola."

#: game/content/achievements.gd:78
msgid "Heavy Metal"
msgstr "Heavy metal"

#: game/content/achievements.gd:79
msgid "Eighteen lines and one very bright star."
msgstr "Dezoito linhas e uma estrela muito brilhante."

#: game/content/achievements.gd:79
msgid "Going Nova"
msgstr "Rumo à nova"

#: game/content/achievements.gd:79
msgid "Score with Supernova at x10 Mult or more."
msgstr "Pontue com Supernova em x10 Mult ou mais."

#: game/content/achievements.gd:80
msgid "Grow Snowball to x2 Mult or more."
msgstr "Faça a Bola de Neve crescer até x2 Mult ou mais."

#: game/content/achievements.gd:80
msgid "It started as a pebble of snow."
msgstr "Começou como um floquinho de neve."

#: game/content/achievements.gd:80
msgid "Snowed In"
msgstr "Nevado"

#: game/content/achievements.gd:81
msgid "Compound Growth"
msgstr "Juros compostos"

#: game/content/achievements.gd:81
msgid "Earn the maximum interest (+5 Credits) after a round."
msgstr "Ganhe os juros máximos (+5 créditos) depois de uma rodada."

#: game/content/achievements.gd:81
msgid "Your Credits have been working harder than you."
msgstr "Seus créditos trabalharam mais que você."

#: game/content/achievements.gd:82
msgid "Have seven Joker slots."
msgstr "Tenha sete espaços de Curinga."

#: game/content/achievements.gd:82
msgid "Two Rack Extenders and a lot of shelf brackets."
msgstr "Dois extensores de estante e muitas mãos-francesas."

#: game/content/achievements.gd:82
msgid "Wide Rack"
msgstr "Estante larga"

#: game/content/achievements.gd:83
msgid "Billionaire"
msgstr "Bilionário"

#: game/content/achievements.gd:83
msgid "Nine zeros. The counter had to borrow some."
msgstr "Nove zeros. O contador teve que pegar alguns emprestados."

#: game/content/achievements.gd:83
msgid "Score 1,000,000,000 points with one placement."
msgstr "Faça 1 000 000 000 de pontos com uma jogada."

#: game/content/achievements.gd:84
msgid "Even legends have bad days."
msgstr "Até as lendas têm dias ruins."

