msgstr "Łowca grubej zwierzyny"

#: game/content/jokers.gd:85
msgid "Rainbow Road"
msgstr "Tęczowa droga"

#: game/content/jokers.gd:85
msgid "x1.75 Mult when the board holds all six block colors before the placement."
msgstr "x1.75 Mult, gdy przed ruchem na planszy są wszystkie sześć kolorów kostek."

