#: game/content/feats.gd:8
msgid "Clear a row and a column in the same placement."
msgstr "Usuń wiersz i kolumnę w tym samym ruchu."

#: game/content/feats.gd:8
msgid "Crossfire"
msgstr "Ogień krzyżowy"

#: game/content/feats.gd:9
msgid "Clear lines on two placements in a row."
msgstr "Usuwaj linie w dwóch ruchach z rzędu."

#: game/content/feats.gd:9
msgid "Double Tap"
msgstr "Podwójne uderzenie"

#: game/content/feats.gd:10
msgid "Clear three or more lines in one placement."
msgstr "Usuń trzy lub więcej linii jednym ruchem."

#: game/content/feats.gd:10
msgid "Hat Trick"
msgstr "Hat trick"

#: game/content/feats.gd:11
msgid "Clean Board"
msgstr "Czysta plansza"

#: game/content/feats.gd:11
msgid "Leave the board completely empty."
msgstr "Zostaw planszę całkowicie pustą."

#: game/content/feats.gd:12
msgid "Fill a one-block hole (closed on all four sides) and clear a line with it."
msgstr "Wypełnij dziurę na jedną kostkę (zamkniętą z czterech stron) i usuń nią linię."

#: game/content/feats.gd:12
msgid "Needle Threader"
msgstr "Nawlekacz"

#: game/content/feats.gd:13
msgid "Clear a line with your last placement."
msgstr "Usuń linię swoim ostatnim ruchem."

#: game/content/feats.gd:13
msgid "Last Breath"
msgstr "Ostatni oddech"

#: game/content/holo.gd:18
msgid "Negative Film"
msgstr "Klisza negatyw"

#: game/content/holo.gd:19
msgid "A random Joker that is not Negative turns Negative: it no longer takes a Joker slot."
msgstr "Losowy Joker, który nie jest negatywem, staje się negatywem: nie zajmuje już miejsca na Jokera."

#: game/content/holo.gd:20
msgid "AGAIN Seal"
msgstr "Pieczęć JESZCZE"

#: game/content/holo.gd:21
msgid "A random scoring Joker gains AGAIN: after all your Jokers have scored, it triggers once more."
msgstr "Losowy punktujący Joker zyskuje JESZCZE: gdy wszystkie twoje Jokery zapunktują, aktywuje się jeszcze raz."

#: game/content/holo.gd:22
msgid "Master Schematic"
msgstr "Schemat mistrza"

#: game/content/holo.gd:23
msgid "Every shape family in your bag gains a level (+25 Chips, +0.25 Mult per level)."
msgstr "Każda rodzina kształtów w worku zyskuje poziom (+25 Żetonów, +0.25 Mult za poziom)."

#: game/content/holo.gd:24
msgid "Master Tuning"
msgstr "Strojenie mistrza"

#: game/content/holo.gd:25
#, c-format
msgid "Every scoring Joker below its top level gains a level (+50% of its effect)."
msgstr "Każdy punktujący Joker poniżej maksymalnego poziomu zyskuje poziom (+50% efektu)."

#: game/content/holo.gd:26
msgid "Legend Crate"
msgstr "Skrzynia legend"

#: game/content/holo.gd:27
msgid "The Legendary Joker shown on this card joins your rack. Needs a free Joker slot."
msgstr "Legendarny Joker z tej karty dołącza do stojaka. Wymaga wolnego miejsca na Jokera."

#: game/content/holo.gd:28
msgid "Hologram"
msgstr "Hologram"

#: game/content/holo.gd:29
msgid "A random Joker that is not Legendary gets a Negative copy (the copy takes no slot)."
msgstr "Losowy nielegendarny Joker dostaje negatywną kopię (kopia nie zajmuje miejsca)."

#: game/content/holo.gd:68
#, c-format
msgid "Legend Crate: %s"
msgstr "Skrzynia legend: %s"

#: game/content/jokers.gd:17
msgid "Common"
msgstr "Zwykły"

#: game/content/jokers.gd:17
msgid "Legendary"
msgstr "Legendarny"

#: game/content/jokers.gd:17
msgid "Rare"
msgstr "Rzadki"

#: game/content/jokers.gd:17
msgid "Uncommon"
msgstr "Niezwykły"

#: game/content/jokers.gd:23
msgid "+50 Chips when exactly one line clears."
msgstr "+50 Żetonów, gdy usunięta zostanie dokładnie jedna linia."

#: game/content/jokers.gd:23
msgid "Clean Sweep"
msgstr "Porządki"

#: game/content/jokers.gd:24
msgid "+100 Chips when two or more lines clear together; +100 more if they cross (a row and a column)."
msgstr "+100 Żetonów, gdy razem usunięte zostaną dwie lub więcej linii; +100 więcej, jeśli się krzyżują (wiersz i kolumna)."

#: game/content/jokers.gd:24
msgid "Crossbar"
msgstr "Poprzeczka"

#: game/content/jokers.gd:25
msgid "+15 Chips per placed cell when placing a shape of 1-3 cells."
msgstr "+15 Żetonów za każde położone pole, gdy kładziesz kształt z 1-3 pól."

#: game/content/jokers.gd:25
msgid "Small Change"
msgstr "Drobne"

#: game/content/jokers.gd:26
msgid "+100 Chips when placing a shape of 5 or more cells."
msgstr "+100 Żetonów, gdy kładziesz kształt z 5 lub więcej pól."

#: game/content/jokers.gd:26
msgid "Heavy Hand"
msgstr "Ciężka ręka"

#: game/content/jokers.gd:27
msgid "First Strike"
msgstr "Pierwszy cios"

#: game/content/jokers.gd:27
msgid "The first clearing placement each round gains +150 Chips."
msgstr "Pierwszy usuwający ruch w każdej rundzie zyskuje +150 Żetonów."

#: game/content/jokers.gd:28
msgid "+40 Chips if the placed shape touches no occupied cell diagonally (checked before placement)."
msgstr "+40 Żetonów, jeśli położony kształt nie dotyka po skosie żadnego zajętego pola (sprawdzane przed ruchem)."

#: game/content/jokers.gd:28
msgid "Neat Freak"
msgstr "Pedant"

#: game/content/jokers.gd:29
msgid "+60 Chips if any placed cell occupies a board corner."
msgstr "+60 Żetonów, jeśli któreś położone pole zajmuje róg planszy."

#: game/content/jokers.gd:29
msgid "Corner Office"
msgstr "Narożny gabinet"

#: game/content/jokers.gd:30
msgid "Blue Mood"
msgstr "Niebieski nastrój"

#: game/content/jokers.gd:30
msgid "Blue shapes gain +2 Mult."
msgstr "Niebieskie kształty zyskują +2 Mult."

#: game/content/jokers.gd:31
msgid "+1 Mult per current combo level on clearing placements."
msgstr "+1 Mult za każdy obecny poziom komba przy usuwających ruchach."

#: game/content/jokers.gd:31
msgid "Chain Link"
msgstr "Ogniwo"

#: game/content/jokers.gd:32
msgid "+2 Credits after a round won with at least two placements unused."
msgstr "+2 kredyty po wygranej rundzie z co najmniej dwoma niewykorzystanymi ruchami."

#. rules text (shown through BMLoc.tf)
#: game/content/jokers.gd:32 game/run/run.gd:1401
msgid "Spare Parts"
msgstr "Części zamienne"

#: game/content/jokers.gd:33
msgid "Once per round, when no offered shape fits and no tray Refresh is available, replace one unplaced shape with a Single before defeat is checked."
msgstr "Raz na rundę, gdy żaden oferowany kształt się nie mieści i nie ma już wymiany tacy, zamienia nieułożony kształt na Jedynkę, zanim sprawdzona zostanie porażka."

#: game/content/jokers.gd:33
msgid "Tiny Insurance"
msgstr "Mała polisa"

#: game/content/jokers.gd:34
msgid "Second Look"
msgstr "Drugie spojrzenie"

#: game/content/jokers.gd:34
msgid "The first Refresh each round also grants +1 placement."
msgstr "Pierwsza wymiana w każdej rundzie daje też +1 ruch."

#: game/content/jokers.gd:35
msgid "+2 Mult on every clearing placement; +3 more when two or more lines clear."
msgstr "+2 Mult przy każdym usuwającym ruchu; +3 więcej, gdy usuniesz naraz dwie lub więcej linii."

#: game/content/jokers.gd:35
msgid "Wide Awake"
msgstr "Czujny"

#: game/content/jokers.gd:36
msgid "+0.5 Mult when the board has at least 44 empty cells before placement."
msgstr "+0.5 Mult, gdy przed ruchem plansza ma co najmniej 44 puste pola."

#: game/content/jokers.gd:36
msgid "Hollow Point"
msgstr "Pusty środek"

#: game/content/jokers.gd:37
msgid "+0.5 Mult for every eight occupied cells before placement (max +2)."
msgstr "+0.5 Mult za każde osiem zajętych pól przed ruchem (maks. +2)."

#: game/content/jokers.gd:37
msgid "Pressure Cooker"
msgstr "Szybkowar"

#: game/content/jokers.gd:38
msgid "Every third placed shape in a round gets x1.5 Mult."
msgstr "Co trzeci położony kształt w rundzie otrzymuje x1.5 Mult."

#: game/content/jokers.gd:38
msgid "Golden Ratio"
msgstr "Złota proporcja"

#: game/content/jokers.gd:39
msgid "Color Cycle"
msgstr "Cykl kolorów"

