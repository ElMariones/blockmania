msgid "T-Rex"
msgstr "T-Rex"

#: game/content/jokers.gd:117
msgid "Lightning Bolt"
msgstr "Piorun"

#: game/content/jokers.gd:117
msgid "Zigzag pieces gain x1 Mult plus x0.25 for each Zigzag in your bag (max x3)."
msgstr "Klocki Zygzak zyskują x1 Mult plus x0.25 za każdy klocek Zygzak w worku (maks. x3)."

