msgstr "+2 Mult, gdy kładziesz klocek Jedynka."

#: game/content/jokers.gd:108
msgid "Lone Wolf"
msgstr "Samotny wilk"

#: game/content/jokers.gd:109
msgid "+60 Chips when placing a T piece."
msgstr "+60 Żetonów, gdy kładziesz klocek T."

#: game/content/jokers.gd:109
msgid "Tee Time"
msgstr "Pora na tee"

#: game/content/jokers.gd:110
msgid "+2 Mult when placing a Zigzag piece."
msgstr "+2 Mult, gdy kładziesz klocek Zygzak."

#: game/content/jokers.gd:110
msgid "Zigzagger"
msgstr "Zygzakowiec"

#: game/content/jokers.gd:111
msgid "+80 Chips when placing a Plus piece."
msgstr "+80 Żetonów, gdy kładziesz klocek Krzyż."

#: game/content/jokers.gd:111
