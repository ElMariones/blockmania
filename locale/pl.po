msgstr "+60 Żetonów, gdy kładziesz klocek L 3 lub L 4."

#: game/content/jokers.gd:49
msgid "Architect"
msgstr "Architekt"

#: game/content/jokers.gd:50
msgid "+15 Chips per cell when placing a Bar piece."
msgstr "+15 Żetonów za pole, gdy kładziesz klocek Belka."

#: game/content/jokers.gd:50
msgid "Straight Edge"
msgstr "Prosta linijka"

#: game/content/jokers.gd:51
msgid "+2 Mult when placing a Square piece."
msgstr "+2 Mult, gdy kładziesz klocek Kwadrat."

#: game/content/jokers.gd:51
msgid "Square Deal"
msgstr "Uczciwy układ"

#: game/content/jokers.gd:52
msgid "+80 Chips when this placement empties the tray."
msgstr "+80 Żetonów, gdy ten ruch opróżnia tacę."

#: game/content/jokers.gd:52
msgid "Last Piece"
msgstr "Ostatni klocek"

#: game/content/jokers.gd:53
msgid "+40 Chips when placing a stamped piece."
msgstr "+40 Żetonów, gdy kładziesz klocek z pieczątką."

#: game/content/jokers.gd:53
msgid "Postmaster"
msgstr "Poczmistrz"

#: game/content/jokers.gd:54
msgid "+0.25 Mult for each piece your bag has below 24 (max +3)."
msgstr "+0.25 Mult za każdy klocek, którego brakuje workowi do 24 (maks. +3)."

#: game/content/jokers.gd:54
msgid "Lean Bag"
msgstr "Chudy worek"

#: game/content/jokers.gd:55
msgid "+5 Chips for each upgraded piece (material or stamp) in your bag."
msgstr "+5 Żetonów za każdy ulepszony klocek (materiał lub pieczątka) w worku."

#: game/content/jokers.gd:55
msgid "Foundry"
msgstr "Odlewnia"

#: game/content/jokers.gd:56
msgid "Neon Sign"
msgstr "Neon reklamowy"

#: game/content/jokers.gd:56
msgid "Neon cells cleared give an extra +0.5 Mult each."
msgstr "Każde usunięte pole neonowe daje dodatkowo +0.5 Mult."

