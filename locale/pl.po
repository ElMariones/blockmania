#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Bronze"
msgstr "Brązowy"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Gold"
msgstr "Złoty"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Legendary"
msgstr "Legendarny"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Silver"
msgstr "Srebrny"

#: game/content/achievements.gd:13
msgid "ARCADE & SECRETS"
msgstr "ARCADE I SEKRETY"

#: game/content/achievements.gd:13
msgid "LEGENDS"
msgstr "LEGENDY"

#: game/content/achievements.gd:13
msgid "THE BAG & THE SHOP"
msgstr "WOREK I SKLEP"

#: game/content/achievements.gd:13
msgid "THE CAMPAIGN"
msgstr "KAMPANIA"

#: game/content/achievements.gd:13
msgid "THE SCOREBOARD"
msgstr "TABLICA WYNIKÓW"

#: game/content/achievements.gd:21
msgid "Clear your first line."
msgstr "Usuń swoją pierwszą linię."

#: game/content/achievements.gd:21
msgid "First Crack"
msgstr "Pierwsza rysa"

#: game/content/achievements.gd:21
msgid "It's a start. A very satisfying start."
msgstr "To dopiero początek. Bardzo satysfakcjonujący początek."

#: game/content/achievements.gd:22
msgid "The target never stood a chance."
msgstr "Cel nie miał najmniejszych szans."

#: game/content/achievements.gd:22
msgid "Warmed Up"
msgstr "Rozgrzewka"

#: game/content/achievements.gd:22
msgid "Win a round."
msgstr "Wygraj rundę."

#: game/content/achievements.gd:23
msgid "Boss Buster"
msgstr "Pogromca bossów"

#: game/content/achievements.gd:23
msgid "Defeat a boss."
msgstr "Pokonaj bossa."

#: game/content/achievements.gd:23
msgid "They always look bigger on the poster."
msgstr "Na plakacie zawsze wyglądają na większych."

#: game/content/achievements.gd:24
msgid "Intermission is over. Back to your seats."
msgstr "Koniec przerwy. Proszę wrócić na miejsca."

#: game/content/achievements.gd:24
msgid "Reach Act 2 (round 5)."
msgstr "Dotrzyj do aktu 2 (runda 5)."

#: game/content/achievements.gd:24
msgid "Second Act"
msgstr "Akt drugi"

#: game/content/achievements.gd:25
msgid "Final Act"
msgstr "Akt ostatni"

#: game/content/achievements.gd:25
msgid "Reach Act 3 (round 9)."
msgstr "Dotrzyj do aktu 3 (runda 9)."

#: game/content/achievements.gd:25
msgid "The curtain is starting to twitch."
msgstr "Kurtyna zaczyna drgać."

#: game/content/achievements.gd:26
msgid "Blink and you missed it."
msgstr "Mrugniesz i po wszystkim."

#: game/content/achievements.gd:26
msgid "Speedrunner"
msgstr "Speedrunner"

#: game/content/achievements.gd:26
msgid "Win a round in five placements or fewer."
msgstr "Wygraj rundę w pięciu ruchach lub mniej."

#: game/content/achievements.gd:27
msgid "BLOCKMANIA!"
msgstr "BLOCKMANIA!"

#: game/content/achievements.gd:27
msgid "Beat the game: win round 12."
msgstr "Ukończ grę: wygraj rundę 12."

#: game/content/achievements.gd:27
msgid "Twelve rounds, three bosses, one very full board."
msgstr "Dwanaście rund, trzech bossów i jedna bardzo pełna plansza."

#: game/content/achievements.gd:28
msgid "A good builder never blames the Kit."
msgstr "Dobry budowniczy nigdy nie zwala winy na zestaw."

#: game/content/achievements.gd:28
msgid "Beat the game with any Kit other than the Standard Kit."
msgstr "Ukończ grę dowolnym zestawem innym niż standardowy."

#: game/content/achievements.gd:28
msgid "Different Tools"
msgstr "Inne narzędzia"

#: game/content/achievements.gd:29 game/content/tips.gd:33
msgid "Overtime"
msgstr "Dogrywka"

#: game/content/achievements.gd:29
msgid "The arcade was supposed to close an hour ago."
msgstr "Salon gier miał być zamknięty godzinę temu."

#: game/content/achievements.gd:29
msgid "Win a round in Overtime (after beating the game, keep playing)."
msgstr "Wygraj rundę w dogrywce (po ukończeniu gry graj dalej)."

#: game/content/achievements.gd:30
msgid "Every target is a cliff now."
msgstr "Teraz każdy cel to urwisko."

#: game/content/achievements.gd:30
msgid "Reach round 20 in Overtime."
msgstr "Dotrzyj do rundy 20 w dogrywce."

#: game/content/achievements.gd:30
msgid "Sudden Death"
msgstr "Nagła śmierć"

#: game/content/achievements.gd:31
msgid "No Off Switch"
msgstr "Bez wyłącznika"

#: game/content/achievements.gd:31
msgid "Reach round 30 in Overtime."
msgstr "Dotrzyj do rundy 30 w dogrywce."

#: game/content/achievements.gd:31
msgid "Somebody unplug this thing."
msgstr "Niech ktoś to wyłączy z prądu."

#: game/content/achievements.gd:32
msgid "Broke the Machine"
msgstr "Zepsuta maszyna"

#: game/content/achievements.gd:32
msgid "ERR ERR ERR. Please insert more digits."
msgstr "ERR ERR ERR. Proszę wrzucić więcej cyfr."

#: game/content/achievements.gd:32
msgid "Score a single placement past the machine's limit (1,000,000,000,000,000 points)."
msgstr "Przekrocz limit maszyny jednym ruchem (1 000 000 000 000 000 punktów)."

#: game/content/achievements.gd:32
msgid "Some scores are too big for any machine."
msgstr "Niektóre wyniki są za duże dla każdej maszyny."

#: game/content/achievements.gd:34
msgid "Blue Period"
msgstr "Okres błękitny"

#: game/content/achievements.gd:34
msgid "Feeling a little blue? Feeling VERY blue."
msgstr "Trochę smutno? Nie: BARDZO niebiesko."

#: game/content/achievements.gd:34
msgid "Have 10 or more blue pieces in your bag."
msgstr "Miej w worku 10 lub więcej niebieskich klocków."

#: game/content/achievements.gd:35
msgid "Have 10 or more Square pieces (2x2 or 3x3) in your bag."
msgstr "Miej w worku 10 lub więcej klocków Kwadrat (2x2 lub 3x3)."

#: game/content/achievements.gd:35
msgid "Square Dance"
msgstr "Kadryl"

#: game/content/achievements.gd:35
msgid "Swing your partner, stack your blocks."
msgstr "Zakręć partnerką, ułóż klocki."

#: game/content/achievements.gd:36
msgid "Full Spectrum"
msgstr "Pełne spektrum"

#: game/content/achievements.gd:36
msgid "Have at least five pieces of every color in your bag."
msgstr "Miej w worku co najmniej pięć klocków każdego koloru."

#: game/content/achievements.gd:36
msgid "Taste the whole toybox."
msgstr "Spróbuj całej skrzyni z zabawkami."

#: game/content/achievements.gd:37
msgid "Have 40 or more pieces in your bag."
msgstr "Miej w worku 40 lub więcej klocków."

#: game/content/achievements.gd:37
msgid "Packrat"
msgstr "Chomik"

#: game/content/achievements.gd:37
msgid "You never know when you'll need a spare T."
msgstr "Nigdy nie wiesz, kiedy przyda się zapasowe T."

#: game/content/achievements.gd:38
msgid "Only the essentials."
msgstr "Tylko to, co niezbędne."

#: game/content/achievements.gd:38
msgid "Shrink your bag to 14 pieces or fewer."
msgstr "Zmniejsz worek do 14 klocków lub mniej."

#: game/content/achievements.gd:38
msgid "Travel Light"
msgstr "Na lekko"

#: game/content/achievements.gd:39
msgid "Alchemist"
msgstr "Alchemik"

#: game/content/achievements.gd:39
msgid "Own pieces of all five materials at once: Chrome, Neon, Gold, Glass and Prism."
msgstr "Miej jednocześnie klocki ze wszystkich pięciu materiałów: chrom, neon, złoto, szkło i pryzmat."

#: game/content/achievements.gd:39
msgid "Plastic into gold, gold into glass."
msgstr "Plastik w złoto, złoto w szkło."

#: game/content/achievements.gd:40
msgid "Own pieces with all four stamps at once: Encore, Refund, Tip and Memory."
msgstr "Miej jednocześnie klocki ze wszystkimi czterema pieczątkami: Bis, Zwrot, Napiwek i Pamięć."

#: game/content/achievements.gd:40
msgid "Signed, sealed, stamped four times."
msgstr "Podpisane, zapieczętowane, czterokrotnie ostemplowane."

#: game/content/achievements.gd:40
msgid "Special Delivery"
msgstr "Przesyłka specjalna"

#: game/content/achievements.gd:41
msgid "Fill every Joker slot."
msgstr "Zapełnij wszystkie miejsca na Jokery."

#: game/content/achievements.gd:41
msgid "Full House"
msgstr "Brak miejsc"

#: game/content/achievements.gd:41
msgid "No vacancies at the Joker hotel."
msgstr "W hotelu dla Jokerów nie ma wolnych pokoi."

#: game/content/achievements.gd:42
msgid "Hold three Rare Jokers at the same time."
msgstr "Miej jednocześnie trzy rzadkie Jokery."

#: game/content/achievements.gd:42
msgid "Only the finest cardboard."
msgstr "Tylko najlepsza tektura."

#: game/content/achievements.gd:42
msgid "Rare Taste"
msgstr "Wyrafinowany gust"

#: game/content/achievements.gd:43
msgid "Master Plan"
msgstr "Genialny plan"

#: game/content/achievements.gd:43
msgid "Raise a shape family to Schematic level 3."
msgstr "Podnieś rodzinę kształtów do 3. poziomu schematu."

#: game/content/achievements.gd:43
msgid "The blueprints have blueprints."
msgstr "Schematy mają swoje schematy."

#: game/content/achievements.gd:44
msgid "Hold 50 or more Credits."
msgstr "Miej 50 lub więcej kredytów."

#: game/content/achievements.gd:44
msgid "Oink."
msgstr "Chrum."

#: game/content/achievements.gd:44
msgid "Piggy Bank"
msgstr "Skarbonka"

#: game/content/achievements.gd:45
msgid "Even a wallet has a limit."
msgstr "Nawet portfel ma swój limit."

#: game/content/achievements.gd:45
msgid "Hold the maximum 99 Credits."
msgstr "Miej maksymalnie 99 kredytów."

#: game/content/achievements.gd:45
msgid "Scrooge"
msgstr "Sknera"

#: game/content/achievements.gd:45
msgid "Swimming in coins is harder than it looks."
msgstr "Pływanie w monetach jest trudniejsze, niż wygląda."

#: game/content/achievements.gd:47
msgid "Big Hit"
msgstr "Mocne uderzenie"

#: game/content/achievements.gd:47
msgid "Ka-chunk."
msgstr "Ka-czank."

#: game/content/achievements.gd:47
msgid "Score 1,000 points with one placement."
msgstr "Zdobądź 1 000 punktów jednym ruchem."

#: game/content/achievements.gd:48
msgid "Mega Hit"
msgstr "Mega uderzenie"

#: game/content/achievements.gd:48
msgid "Score 10,000 points with one placement."
msgstr "Zdobądź 10 000 punktów jednym ruchem."

#: game/content/achievements.gd:48
msgid "The receipt printer is sweating."
msgstr "Drukarka paragonów się poci."

#: game/content/achievements.gd:49
msgid "Giga Hit"
msgstr "Giga uderzenie"

#: game/content/achievements.gd:49
msgid "Score 1,000,000 points with one placement."
msgstr "Zdobądź 1 000 000 punktów jednym ruchem."

#: game/content/achievements.gd:49
msgid "That's a lot of zeros for one little piece."
msgstr "Sporo zer jak na taki mały klocek."

#: game/content/achievements.gd:50
msgid "Clear three lines with one placement."
msgstr "Usuń trzy linie jednym ruchem."

#: game/content/achievements.gd:50
msgid "Stacked high and cleared clean."
msgstr "Wysoko ułożone, czysto usunięte."

#: game/content/achievements.gd:50
msgid "Triple Decker"
msgstr "Trzy piętra"

#: game/content/achievements.gd:51
msgid "Clear four or more lines with one placement."
msgstr "Usuń cztery lub więcej linii jednym ruchem."

#: game/content/achievements.gd:51
msgid "Four-Alarm Fire"
msgstr "Czerwony alarm"

#: game/content/achievements.gd:51
msgid "Somebody call the block brigade."
msgstr "Niech ktoś wezwie straż klockową."

#: game/content/achievements.gd:52
msgid "Clear a row and a column with one placement."
msgstr "Usuń wiersz i kolumnę jednym ruchem."

#: game/content/achievements.gd:52
msgid "Crossroads"
msgstr "Skrzyżowanie"

#: game/content/achievements.gd:52
msgid "X marks the spot."
msgstr "X oznacza miejsce."

#: game/content/achievements.gd:53
msgid "Don't touch the board, it's hot."
msgstr "Nie dotykaj planszy, jest gorąca."

#: game/content/achievements.gd:53
msgid "Reach the maximum combo (x4)."
msgstr "Osiągnij maksymalne kombo (x4)."

#: game/content/achievements.gd:53
msgid "Red Hot"
msgstr "Rozgrzany do czerwoności"

#: game/content/achievements.gd:54
msgid "Finish a round with at least three times its target."
msgstr "Zakończ rundę z co najmniej trzykrotnością celu."

#: game/content/achievements.gd:54
msgid "Overkill"
msgstr "Przesada"

#: game/content/achievements.gd:54
msgid "The target asked for a little. You gave a lot."
msgstr "Cel prosił o odrobinę. Ty dałeś mnóstwo."

#: game/content/achievements.gd:55
msgid "By a Thread"
msgstr "O włos"

#: game/content/achievements.gd:55
msgid "Close. So close. Close enough!"
msgstr "Blisko. Bardzo blisko. Wystarczająco blisko!"

#: game/content/achievements.gd:55
msgid "Win a round with your very last placement."
msgstr "Wygraj rundę swoim ostatnim ruchem."

#: game/content/achievements.gd:56
msgid "Leave the board completely empty after a clear (campaign)."
msgstr "Zostaw planszę całkowicie pustą po usunięciu linii (kampania)."

#: game/content/achievements.gd:56
msgid "Spotless"
msgstr "Bez skazy"

#: game/content/achievements.gd:56
msgid "You could eat off this board."
msgstr "Z tej planszy można by jeść."

#: game/content/achievements.gd:57
msgid "Get dealt a Grand Slam Tray Hand."
msgstr "Otrzymaj na tacy układ Wielki Szlem."

#: game/content/achievements.gd:57 game/rules/hands.gd:17
msgid "Grand Slam"
msgstr "Wielki Szlem"

#: game/content/achievements.gd:57
msgid "Three of a kind, one color, all the lights."
msgstr "Trzy takie same, jeden kolor i wszystkie światła."

#: game/content/achievements.gd:58
msgid "Full Deck"
msgstr "Pełna talia"

#: game/content/achievements.gd:58
msgid "See all five Tray Hands (across any runs)."
msgstr "Zobacz wszystkie pięć układów tacy (w dowolnych rozgrywkach)."

#: game/content/achievements.gd:58
msgid "Twins, Staircase, Monochrome, Triplets, Grand Slam. Collected."
msgstr "Bliźniaki, Schodki, Monochrom, Trojaczki, Wielki Szlem. Zebrane."

#: game/content/achievements.gd:60
msgid "Arcade Rookie"
msgstr "Nowicjusz salonu gier"

#: game/content/achievements.gd:60
msgid "Put your initials in. Go on."
msgstr "Wpisz swoje inicjały. No dalej."

#: game/content/achievements.gd:60
msgid "Score 5,000 points in one Endless game."
msgstr "Zdobądź 5 000 punktów w jednej grze Bez końca."

#: game/content/achievements.gd:61
msgid "Arcade Regular"
msgstr "Bywalec salonu gier"

#: game/content/achievements.gd:61
msgid "Score 25,000 points in one Endless game."
msgstr "Zdobądź 25 000 punktów w jednej grze Bez końca."

#: game/content/achievements.gd:61
msgid "The cabinet knows your name."
msgstr "Automat zna już twoje imię."

#: game/content/achievements.gd:62
msgid "Arcade Legend"
msgstr "Legenda salonu gier"

#: game/content/achievements.gd:62
msgid "Score 100,000 points in one Endless game."
msgstr "Zdobądź 100 000 punktów w jednej grze Bez końca."

#: game/content/achievements.gd:62
msgid "They're going to name the cabinet after you."
msgstr "Nazwą automat na twoją cześć."

#: game/content/achievements.gd:63
msgid "Blockstorm"
msgstr "Klockowa burza"

#: game/content/achievements.gd:63
msgid "Reach the x10 combo in Endless."
msgstr "Osiągnij kombo x10 w trybie Bez końca."

#: game/content/achievements.gd:63
msgid "Ten out of ten. No notes."
msgstr "Dziesięć na dziesięć. Bez uwag."

#: game/content/achievements.gd:64
msgid "Ahh. That new-board smell."
msgstr "Ach. Ten zapach nowej planszy."

#: game/content/achievements.gd:64
msgid "Clear the whole board in Endless."
msgstr "Wyczyść całą planszę w trybie Bez końca."

#: game/content/achievements.gd:64
msgid "Fresh Start"
msgstr "Czysta karta"

#: game/content/achievements.gd:65
msgid "BL...CKM...NIA? Where did everything go?"
msgstr "BL...CKM...NIA? Gdzie się wszystko podziało?"

#: game/content/achievements.gd:65
msgid "Have every letter of the BLOCKMANIA logo blown up at once."
msgstr "Wysadź naraz wszystkie litery logo BLOCKMANIA."

#: game/content/achievements.gd:65
msgid "The title looks awfully fragile."
msgstr "Tytuł wygląda strasznie krucho."

#: game/content/achievements.gd:65
msgid "Vandal"
msgstr "Wandal"

#: game/content/achievements.gd:66
msgid "Night Shift"
msgstr "Nocna zmiana"

#: game/content/achievements.gd:66
msgid "Place a piece between midnight and 5 AM."
msgstr "Połóż klocek między północą a 5 rano."

#: game/content/achievements.gd:66
msgid "Some players only come out after dark."
msgstr "Niektórzy gracze wychodzą dopiero po zmroku."

#: game/content/achievements.gd:66
msgid "The blocks glow brighter at night. Probably."
msgstr "Nocą klocki świecą jaśniej. Chyba."

#: game/content/achievements.gd:67
msgid "Look Ma, No Lines"
msgstr "Patrz, mamo, bez linii"

#: game/content/achievements.gd:67
msgid "Technically, the rules never said you HAD to."
msgstr "Technicznie rzecz biorąc, zasady nigdy nie mówiły, że TRZEBA."

#: game/content/achievements.gd:67
msgid "Who needs lines anyway?"
msgstr "Komu potrzebne linie?"

#: game/content/achievements.gd:67
msgid "Win a campaign round without clearing a single line."
msgstr "Wygraj rundę kampanii bez usunięcia ani jednej linii."

#: game/content/achievements.gd:68
msgid "Butterfingers"
msgstr "Dziurawe ręce"

#: game/content/achievements.gd:68
msgid "Handle with care."
msgstr "Ostrożnie, szkło."

#: game/content/achievements.gd:68
msgid "Shatter a Glass piece."
msgstr "Rozbij szklany klocek."

#: game/content/achievements.gd:68
msgid "That one's coming out of your allowance."
msgstr "To pójdzie z twojego kieszonkowego."

#: game/content/achievements.gd:69
msgid "In case of emergency, break something."
msgstr "W razie wypadku coś rozbij."

#: game/content/achievements.gd:69
msgid "Through the Window"
msgstr "Przez okno"

#: game/content/achievements.gd:69
msgid "Throw an Emergency Brick."
msgstr "Rzuć cegłą awaryjną."

#: game/content/achievements.gd:69
msgid "Who's paying for that?"
msgstr "Kto za to zapłaci?"

#: game/content/achievements.gd:70
msgid "Always read the small text."
msgstr "Zawsze czytaj drobny druk."

#: game/content/achievements.gd:70
msgid "Get a lost round replayed by Insurance Policy."
msgstr "Niech Polisa ubezpieczeniowa powtórzy przegraną rundę."

#: game/content/achievements.gd:70
msgid "Terms and conditions apply. Luckily, they applied to you."
msgstr "Obowiązuje regulamin. Na szczęście obowiązywał ciebie."

#: game/content/achievements.gd:70
msgid "The Fine Print"
msgstr "Drobny druk"

#: game/content/achievements.gd:71
msgid "Block Maniac"
msgstr "Blokomaniak"

#: game/content/achievements.gd:71
msgid "The whole trophy case. Every last shelf. Take a bow."
msgstr "Cała gablota. Każda półka. Ukłoń się."

#: game/content/achievements.gd:71
msgid "Unlock every other achievement."
msgstr "Odblokuj wszystkie pozostałe osiągnięcia."

#: game/content/achievements.gd:73
msgid "It hums a little when you hold it."
msgstr "Lekko brzęczy, gdy go trzymasz."

#: game/content/achievements.gd:73
msgid "Once Upon a Legend"
msgstr "Dawno temu była legenda"

#: game/content/achievements.gd:73
msgid "Own a Legendary Joker."
msgstr "Miej legendarnego Jokera."

#: game/content/achievements.gd:74
msgid "Double Legend"
msgstr "Podwójna legenda"

#: game/content/achievements.gd:74
msgid "One legend is a story. Two is a problem."
msgstr "Jedna legenda to opowieść. Dwie to problem."

#: game/content/achievements.gd:74
msgid "Own two Legendary Jokers at the same time."
msgstr "Miej jednocześnie dwa legendarne Jokery."

#: game/content/achievements.gd:74
msgid "The rack has never looked so smug."
msgstr "Stojak jeszcze nigdy nie wyglądał na tak zadowolony z siebie."

#: game/content/achievements.gd:75
msgid "Own each of the four Legendary Jokers (across any runs)."
msgstr "Miej każdego z czterech legendarnych Jokerów (w dowolnych rozgrywkach)."

#: game/content/achievements.gd:75
msgid "Pantheon"
msgstr "Panteon"

#: game/content/achievements.gd:75
msgid "The Avalanche, the Mirrors, the Stone and the Star. All accounted for."
msgstr "Lawina, Lustra, Kamień i Gwiazda. Wszyscy obecni."

#: game/content/achievements.gd:76
msgid "Chain Reaction"
msgstr "Reakcja łańcuchowa"

#: game/content/achievements.gd:76
msgid "Chain three clear waves in one placement with The Avalanche."
msgstr "Połącz trzy fale usuwania w jednym ruchu z Lawiną."

#: game/content/achievements.gd:76
msgid "Nobody touch anything. Let it fall."
msgstr "Niech nikt niczego nie dotyka. Niech spada."

#: game/content/achievements.gd:77
msgid "How many of you are in there?"
msgstr "Ilu was tam jest?"

#: game/content/achievements.gd:77
msgid "Mirror World"
msgstr "Lustrzany świat"

#: game/content/achievements.gd:77
msgid "Score a placement where Hall of Mirrors doubles four other Jokers."
msgstr "Zdobądź punkty ruchem, w którym Sala Luster podwaja cztery inne Jokery."

#: game/content/achievements.gd:78
msgid "Chrome, neon, gold and glass. Very little plastic left."
msgstr "Chrom, neon, złoto i szkło. Plastiku prawie nie zostało."

#: game/content/achievements.gd:78
msgid "Have 15 or more pieces with a material in your bag."
msgstr "Miej w worku 15 lub więcej klocków z materiałem."

#: game/content/achievements.gd:78
msgid "Heavy Metal"
msgstr "Heavy metal"

#: game/content/achievements.gd:79
msgid "Eighteen lines and one very bright star."
msgstr "Osiemnaście linii i jedna bardzo jasna gwiazda."

#: game/content/achievements.gd:79
msgid "Going Nova"
msgstr "Ku nowej"

#: game/content/achievements.gd:79
msgid "Score with Supernova at x10 Mult or more."
msgstr "Zdobądź punkty z Supernową przy x10 Mult lub więcej."

#: game/content/achievements.gd:80
msgid "Grow Snowball to x2 Mult or more."
msgstr "Powiększ Kulę śnieżną do x2 Mult lub więcej."

#: game/content/achievements.gd:80
msgid "It started as a pebble of snow."
msgstr "Zaczęło się od płatka śniegu."

#: game/content/achievements.gd:80
msgid "Snowed In"
msgstr "Zasypany"

#: game/content/achievements.gd:81
msgid "Compound Growth"
msgstr "Procent składany"

#: game/content/achievements.gd:81
msgid "Earn the maximum interest (+5 Credits) after a round."
msgstr "Zdobądź po rundzie maksymalne odsetki (+5 kredytów)."

#: game/content/achievements.gd:81
msgid "Your Credits have been working harder than you."
msgstr "Twoje kredyty pracowały ciężej niż ty."

#: game/content/achievements.gd:82
msgid "Have seven Joker slots."
msgstr "Miej siedem miejsc na Jokery."

#: game/content/achievements.gd:82
msgid "Two Rack Extenders and a lot of shelf brackets."
msgstr "Dwie przedłużki stojaka i mnóstwo wsporników."

#: game/content/achievements.gd:82
msgid "Wide Rack"
msgstr "Szeroki stojak"

#: game/content/achievements.gd:83
msgid "Billionaire"
msgstr "Miliarder"

#: game/content/achievements.gd:83
msgid "Nine zeros. The counter had to borrow some."
msgstr "Dziewięć zer. Licznik musiał kilka pożyczyć."

#: game/content/achievements.gd:83
msgid "Score 1,000,000,000 points with one placement."
msgstr "Zdobądź 1 000 000 000 punktów jednym ruchem."

#: game/content/achievements.gd:84
msgid "Even legends have bad days."
msgstr "Nawet legendy mają gorsze dni."

#: game/content/achievements.gd:84
msgid "Fallen Hero"
msgstr "Upadły bohater"

#: game/content/achievements.gd:84
msgid "Lose a run while owning a Legendary Joker."
msgstr "Przegraj rozgrywkę, mając legendarnego Jokera."

#: game/content/achievements.gd:84
msgid "They'll write songs about it. Sad ones."
msgstr "Napiszą o tym piosenki. Smutne."

#: game/content/bosses.gd:7
msgid "Cramped Cabinet"
msgstr "Ciasna Szafa"

#: game/content/bosses.gd:7
msgid "The Cramped Cabinet"
msgstr "Ciasna Szafa"

#: game/content/bosses.gd:8
msgid "The round begins with four fixed occupied cells. They clear normally and score no placement Chips."
msgstr "Runda zaczyna się z czterema stale zajętymi polami. Usuwa się je normalnie i nie dają Żetonów za ruch."

#: game/content/bosses.gd:9
msgid "The round begins with seven fixed occupied cells. They clear normally and score no placement Chips."
msgstr "Runda zaczyna się z siedmioma stale zajętymi polami. Usuwa się je normalnie i nie dają Żetonów za ruch."

#: game/content/bosses.gd:10
msgid "Favor small shapes or board-clearing tools."
msgstr "Postaw na małe kształty lub narzędzia czyszczące planszę."

#: game/content/bosses.gd:11
msgid "Taxman"
msgstr "Poborca"

#: game/content/bosses.gd:11
msgid "The Taxman"
msgstr "Poborca"

#: game/content/bosses.gd:12
msgid "The first line cleared by each placement grants 60 instead of 100 base Chips."
msgstr "Pierwsza linia usunięta każdym ruchem daje 60 zamiast 100 bazowych Żetonów."

#: game/content/bosses.gd:13
msgid "The first line cleared by each placement grants 30 instead of 100 base Chips, and multi-line Mult is halved."
msgstr "Pierwsza linia usunięta każdym ruchem daje 30 zamiast 100 bazowych Żetonów, a Mult za wiele linii jest o połowę mniejszy."

#: game/content/bosses.gd:14
msgid "Pursue double clears and flat Chip Jokers."
msgstr "Celuj w podwójne usunięcia i Jokery ze stałymi Żetonami."

#: game/content/bosses.gd:15
msgid "Color Blind"
msgstr "Daltonista"

#: game/content/bosses.gd:15
msgid "The Color Blind"
msgstr "Daltonista"

#: game/content/bosses.gd:16
msgid "Effects that name a block color are disabled this round."
msgstr "Efekty, które nazywają kolor kostki, są w tej rundzie wyłączone."

#: game/content/bosses.gd:17
msgid "Effects that name a block color are disabled, and you have two fewer placements."
msgstr "Efekty, które nazywają kolor kostki, są wyłączone, a ty masz o dwa ruchy mniej."

#: game/content/bosses.gd:18
msgid "Diversify beyond color-dependent scoring."
msgstr "Nie opieraj punktacji tylko na kolorach."

#: game/content/bosses.gd:21
msgid "Echo Chamber"
msgstr "Komora Echa"

#: game/content/bosses.gd:21
msgid "The Echo Chamber"
msgstr "Komora Echa"

#: game/content/bosses.gd:22
msgid "Extra clear waves after the first score half Chips before Jokers."
msgstr "Dodatkowe fale usuwania po pierwszej dają połowę Żetonów przed Jokerami."

#: game/content/bosses.gd:23
msgid "Prefer immediate clears over chained board effects."
msgstr "Wybieraj natychmiastowe usunięcia zamiast efektów łańcuchowych."

#: game/content/bosses.gd:24
msgid "Lockdown"
msgstr "Blokada"

#: game/content/bosses.gd:24
msgid "The Lockdown"
msgstr "Blokada"

#: game/content/bosses.gd:25
msgid "The free Refresh and Second Tray are unavailable this round."
msgstr "Darmowa wymiana i Druga taca są w tej rundzie niedostępne."

#: game/content/bosses.gd:26
msgid "Refresh, Second Tray, Coffee Break and Hold are all unavailable this round."
msgstr "Wymiana, Druga taca, Przerwa na kawę i Schowek są w tej rundzie niedostępne."

#: game/content/bosses.gd:27
msgid "Plan tray order and preserve board space."
msgstr "Zaplanuj kolejność tacy i zostaw miejsce na planszy."

#: game/content/bosses.gd:28
msgid "The Warden"
msgstr "Strażnik"

#: game/content/bosses.gd:28
msgid "Warden"
msgstr "Strażnik"

#: game/content/bosses.gd:29
msgid "One tray slot starts barred: its piece can't be played until you clear a line. Deals skip the barred slot."
msgstr "Jedno miejsce na tacy jest na starcie zablokowane: jego klocka nie można zagrać, dopóki nie usuniesz linii. Rozdanie pomija zablokowane miejsce."

#: game/content/bosses.gd:30
msgid "Two tray slots start barred. Each clearing placement frees one. Deals skip barred slots."
msgstr "Dwa miejsca na tacy są na starcie zablokowane. Każdy ruch, który usuwa linię, uwalnia jedno. Rozdanie pomija zablokowane miejsca."

#: game/content/bosses.gd:31
msgid "Open with a quick clear using the other two slots."
msgstr "Zacznij od szybkiego usunięcia linii pozostałymi dwoma miejscami."

#: game/content/bosses.gd:32
msgid "The Undertaker"
msgstr "Grabarz"

#: game/content/bosses.gd:32
msgid "Undertaker"
msgstr "Grabarz"

#: game/content/bosses.gd:33
msgid "After every 4th placement, a tombstone rises on an empty cell. It clears with its line like any block."
msgstr "Po co 4. ruchu na pustym polu wyrasta nagrobek. Usuwa się go razem z linią jak każdą kostkę."

#: game/content/bosses.gd:34
msgid "After every 3rd placement, a tombstone rises on an empty cell. It clears with its line like any block."
msgstr "Po co 3. ruchu na pustym polu wyrasta nagrobek. Usuwa się go razem z linią jak każdą kostkę."

#: game/content/bosses.gd:35
msgid "Clear often and keep lanes open."
msgstr "Usuwaj często i trzymaj wolne korytarze."

#: game/content/bosses.gd:36
msgid "Last Call"
msgstr "Ostatnie Wezwanie"

#: game/content/bosses.gd:36
msgid "The Last Call"
msgstr "Ostatnie Wezwanie"

#: game/content/bosses.gd:37
msgid "Only 12 placements. Each multi-line placement gains +50 Chips."
msgstr "Tylko 12 ruchów. Każdy ruch usuwający wiele linii zyskuje +50 Żetonów."

#: game/content/bosses.gd:38
msgid "Only 10 placements. Each multi-line placement gains +50 Chips."
msgstr "Tylko 10 ruchów. Każdy ruch usuwający wiele linii zyskuje +50 Żetonów."

#: game/content/bosses.gd:39
msgid "Prepare efficient shapes and simultaneous clears."
msgstr "Przygotuj wydajne kształty i jednoczesne usunięcia."

#: game/content/consumables.gd:11
msgid "Add +40 Chips per round number to the next placement this round."
msgstr "Dodaje +40 Żetonów za każdy numer rundy do następnego ruchu w tej rundzie."

#. rules text (shown through BMLoc.tf)
#: game/content/consumables.gd:11 game/rules/resolver.gd:225
msgid "Polish"
msgstr "Polerka"

#: game/content/consumables.gd:12
msgid "Add +1 Mult per act to the next placement this round."
msgstr "Dodaje +1 Mult za każdy akt do następnego ruchu w tej rundzie."

#. rules text (shown through BMLoc.tf)
#: game/content/consumables.gd:12 game/rules/resolver.gd:256
msgid "Spark"
msgstr "Iskra"

#: game/content/consumables.gd:13
msgid "Eraser"
msgstr "Gumka"

#: game/content/consumables.gd:13
msgid "Remove up to three blocks of your choice from the board."
msgstr "Usuń z planszy do trzech wybranych kostek."

#: game/content/consumables.gd:14
msgid "Refresh the current tray without spending the round's free Refresh."
msgstr "Wymienia obecną tacę bez zużywania darmowej wymiany w rundzie."

#. rules text (shown through BMLoc.tf)
#: game/content/consumables.gd:14 game/run/run.gd:773
msgid "Second Tray"
msgstr "Druga taca"

#: game/content/consumables.gd:15
msgid "Extra Turn"
msgstr "Dodatkowa tura"

#: game/content/consumables.gd:15
msgid "Gain two placements this round (maximum 20 remaining)."
msgstr "Zyskaj w tej rundzie dwa ruchy (maksymalnie 20 pozostałych)."

#: game/content/consumables.gd:16
msgid "Lucky Paint"
msgstr "Szczęśliwa farba"

#: game/content/consumables.gd:16
msgid "Recolor one tray piece to a color of your choice. Its shape is unchanged."
msgstr "Przemaluj klocek z tacy na wybrany kolor. Jego kształt się nie zmienia."

#: game/content/consumables.gd:17
msgid "Color Purge"
msgstr "Czystka kolorów"

#: game/content/consumables.gd:17
msgid "Remove every block of one color from the board. Stone is immune."
msgstr "Usuń z planszy wszystkie kostki jednego koloru. Kamień jest odporny."

#: game/content/consumables.gd:18
msgid "Emergency Brick"
msgstr "Cegła awaryjna"

#: game/content/consumables.gd:18
msgid "Throw a brick at a tray slot: it becomes a temporary one-block piece. A piece it hits goes to the discard pile."
msgstr "Rzuć cegłą w miejsce na tacy: staje się tymczasowym klockiem z jednej kostki. Trafiony klocek trafia na stos odrzuconych."

#: game/content/consumables.gd:20
msgid "The next placement this round gets x2 Mult."
msgstr "Następny ruch w tej rundzie otrzymuje x2 Mult."

#. rules text (shown through BMLoc.tf)
#: game/content/consumables.gd:20 game/rules/resolver.gd:278
msgid "Turbo"
msgstr "Turbo"

#: game/content/consumables.gd:21
msgid "Level up the shape family of a tray piece, like a Schematic (+25 Chips, +0.25 Mult per level)."
msgstr "Podnosi poziom rodziny kształtów klocka z tacy, jak Schemat (+25 Żetonów, +0.25 Mult za poziom)."

#: game/content/consumables.gd:21
msgid "Tune-Up"
msgstr "Tuning"

#: game/content/consumables.gd:22
msgid "Coin Roll"
msgstr "Rulon monet"

#: game/content/consumables.gd:22
msgid "Gain Credits equal to the round number (max 12)."
msgstr "Zyskaj tyle kredytów, ile wynosi numer rundy (maks. 12)."

#: game/content/consumables.gd:24
msgid "1 in 5 chance: a random Uncommon or better Joker joins your rack. Needs a free Joker slot."
msgstr "Szansa 1 na 5: losowy niezwykły lub lepszy Joker dołącza do stojaka. Wymaga wolnego miejsca na Jokera."

#: game/content/consumables.gd:24
msgid "Lucky Draw"
msgstr "Loteria"

#: game/content/consumables.gd:25
msgid "A random stamp goes on a random unstamped piece in your bag, for good."
msgstr "Losowa pieczątka trafia na stałe na losowy klocek bez pieczątki w worku."

#: game/content/consumables.gd:25
msgid "Mystery Stamp"
msgstr "Tajna pieczątka"

#: game/content/consumables.gd:26
msgid "1 in 5 chance to double your Credits (at most +20). Otherwise nothing."
msgstr "Szansa 1 na 5 na podwojenie kredytów (najwyżej +20). W przeciwnym razie nic."

#: game/content/consumables.gd:26
msgid "Double Down"
msgstr "Podwojenie"

#: game/content/consumables.gd:27
msgid "Phantom Line"
msgstr "Linia widmo"

#: game/content/consumables.gd:27
msgid "The next placement that clears a line counts one extra line (Chips, Mult, refills and Jokers)."
msgstr "Następny ruch, który usunie linię, liczy się jako o jedną linię więcej (Żetony, Mult, zwroty ruchów i Jokery)."

#: game/content/consumables.gd:30
msgid "Punch"
msgstr "Cios"

#: game/content/consumables.gd:30
msgid "Smash a plus-shaped area: remove up to 5 blocks around the cell you hit."
msgstr "Uderz w obszar w kształcie krzyża: usuwa do 5 kostek wokół trafionego pola."

#: game/content/consumables.gd:31
msgid "+1 Refresh this round."
msgstr "+1 wymiana w tej rundzie."

#: game/content/consumables.gd:31
msgid "Coffee Break"
msgstr "Przerwa na kawę"

#. rules text (shown through BMLoc.tf)
#: game/content/consumables.gd:32 game/run/run.gd:1403
msgid "Cash Out"
msgstr "Wypłata"

#: game/content/consumables.gd:32
msgid "Gain 4 Credits after this round if it is won."
msgstr "Zyskaj 4 kredyty po tej rundzie, jeśli ją wygrasz."

#: game/content/consumables.gd:33
msgid "Blueprint"
msgstr "Szkic"

#: game/content/consumables.gd:33
msgid "Swap one tray piece for a temporary 1-3 cell piece you choose."
msgstr "Zamień klocek z tacy na wybrany tymczasowy klocek z 1-3 pól."

