msgstr "Plusik"

#: game/content/jokers.gd:112
msgid "Singles gain x1 Mult plus x0.3 for each Single in your bag (max x3)."
msgstr "Klocki Jedynka zyskują x1 Mult plus x0.3 za każdy klocek Jedynka w worku (maks. x3)."

#: game/content/jokers.gd:112
msgid "Solitaire"
msgstr "Soliter"

#: game/content/jokers.gd:113
msgid "Bar pieces gain x1 Mult plus x0.1 for each Bar in your bag (max x3)."
msgstr "Klocki Belka zyskują x1 Mult plus x0.1 za każdy klocek Belka w worku (maks. x3)."

#: game/content/jokers.gd:113
msgid "Barbell"
msgstr "Sztanga"

#: game/content/jokers.gd:114
msgid "Elbow Room"
msgstr "Swoboda łokci"

#: game/content/jokers.gd:114
msgid "L pieces gain x1 Mult plus x0.15 for each L piece in your bag (max x3)."
msgstr "Klocki L zyskują x1 Mult plus x0.15 za każdy klocek L w worku (maks. x3)."

#: game/content/jokers.gd:115
msgid "Square pieces gain x1 Mult plus x0.25 for each Square in your bag (max x3)."
msgstr "Klocki Kwadrat zyskują x1 Mult plus x0.25 za każdy klocek Kwadrat w worku (maks. x3)."

#: game/content/jokers.gd:115
msgid "Town Square"
msgstr "Rynek"

#: game/content/jokers.gd:116
msgid "T pieces gain x1 Mult plus x0.25 for each T piece in your bag (max x3)."
msgstr "Klocki T zyskują x1 Mult plus x0.25 za każdy klocek T w worku (maks. x3)."

