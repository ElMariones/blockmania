msgid "Foundry"
msgstr "Gießerei"

#: game/content/jokers.gd:56
msgid "Neon Sign"
msgstr "Leuchtreklame"

#: game/content/jokers.gd:56
msgid "Neon cells cleared give an extra +0.5 Mult each."
msgstr "Jedes abgeräumte Neonfeld gibt zusätzlich +0.5 Mult."

