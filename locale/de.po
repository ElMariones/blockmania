msgstr "Abendrot"

#: game/content/jokers.gd:104
msgid "Solar Flare"
msgstr "Sonneneruption"

#: game/content/jokers.gd:104
msgid "Yellow shapes gain x1 Mult plus x0.15 for each Yellow piece in your bag (max x3)."
msgstr "Gelbe Formen erhalten x1 Mult plus x0.15 für jedes gelbe Teil in deinem Beutel (max. x3)."

#: game/content/jokers.gd:105
