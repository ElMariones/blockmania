msgstr "Alarmstufe Rot"

#: game/content/jokers.gd:97
msgid "Red shapes gain +2 Mult."
msgstr "Rote Formen erhalten +2 Mult."

#: game/content/jokers.gd:98
msgid "Citrus Twist"
msgstr "Zitrusdreh"

#: game/content/jokers.gd:98
msgid "Orange shapes gain +2 Mult."
msgstr "Orange Formen erhalten +2 Mult."

#: game/content/jokers.gd:99
msgid "Lemon Drop"
