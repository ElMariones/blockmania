msgid "Collector"
msgstr "Sammler"

#: game/content/jokers.gd:60
msgid "x0.1 Mult for each different shape family in your bag beyond 6 (x1.4 with 10 families)."
msgstr "x0.1 Mult für jede verschiedene Formfamilie in deinem Beutel über 6 hinaus (x1.4 bei 10 Familien)."

