msgstr "Glückssträhne"

#: game/content/jokers.gd:84
msgid "+1 Mult for each block over 4 in the placed piece."
msgstr "+1 Mult für jeden Block über 4 im gelegten Teil."

#: game/content/jokers.gd:84
msgid "Big Game Hunter"
msgstr "Großwildjäger"

#: game/content/jokers.gd:85
msgid "Rainbow Road"
msgstr "Regenbogenstraße"

#: game/content/jokers.gd:85
