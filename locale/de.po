msgid "Solo Act"
msgstr "Solonummer"

#: game/content/jokers.gd:86
msgid "x1 Mult plus x0.75 for each empty Joker slot."
msgstr "x1 Mult plus x0.75 für jeden leeren Joker-Platz."

#: game/content/jokers.gd:87
msgid "Double Stamp"
msgstr "Doppelstempel"

#: game/content/jokers.gd:87
msgid "Stamps trigger twice: Encore x4, Tip +4 Credits, Refund +2 placements, Memory two Sparks."
msgstr "Stempel lösen doppelt aus: Zugabe x4, Trinkgeld +4 Credits, Rückgabe +2 Züge, Gedächtnis zwei Funken."

