msgstr "+0.5 Mult pro Bauplan-Stufe der Familie des gelegten Teils."

#: game/content/jokers.gd:57
msgid "Specialist"
msgstr "Spezialist"

#: game/content/jokers.gd:58
msgid "+0.1 Mult for each piece in the discard pile before placement (max +1)."
msgstr "+0.1 Mult für jedes Teil auf dem Ablagestapel vor dem Zug (max. +1)."

