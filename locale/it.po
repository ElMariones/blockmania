msgid "+2 Mult when placing a Zigzag piece."
msgstr "+2 Mult quando piazzi un pezzo Zigzag."

#: game/content/jokers.gd:110
msgid "Zigzagger"
msgstr "Zigzagante"

#: game/content/jokers.gd:111
msgid "+80 Chips when placing a Plus piece."
msgstr "+80 Fiches quando piazzi un pezzo Croce."

#: game/content/jokers.gd:111
msgid "Plus Side"
msgstr "Lato positivo"

#: game/content/jokers.gd:112
msgid "Singles gain x1 Mult plus x0.3 for each Single in your bag (max x3)."
msgstr "I pezzi Singolo ottengono x1 Mult più x0.3 per ogni pezzo Singolo nel sacco (max x3)."

#: game/content/jokers.gd:112
msgid "Solitaire"
msgstr "Solitario"

#: game/content/jokers.gd:113
msgid "Bar pieces gain x1 Mult plus x0.1 for each Bar in your bag (max x3)."
msgstr "I pezzi Barra ottengono x1 Mult più x0.1 per ogni pezzo Barra nel sacco (max x3)."

#: game/content/jokers.gd:113
msgid "Barbell"
msgstr "Bilanciere"

#: game/content/jokers.gd:114
msgid "Elbow Room"
msgstr "Spazio di manovra"

#: game/content/jokers.gd:114
