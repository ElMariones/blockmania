#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Bronze"
msgstr "Bronzo"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Gold"
msgstr "Oro"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Legendary"
msgstr "Leggendario"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Silver"
msgstr "Argento"

#: game/content/achievements.gd:13
msgid "ARCADE & SECRETS"
msgstr "ARCADE E SEGRETI"

#: game/content/achievements.gd:13
msgid "LEGENDS"
msgstr "LEGGENDE"

#: game/content/achievements.gd:13
msgid "THE BAG & THE SHOP"
msgstr "IL SACCO E IL NEGOZIO"

#: game/content/achievements.gd:13
msgid "THE CAMPAIGN"
msgstr "LA CAMPAGNA"

#: game/content/achievements.gd:13
msgid "THE SCOREBOARD"
msgstr "IL TABELLONE"

#: game/content/achievements.gd:21
msgid "Clear your first line."
msgstr "Elimina la tua prima linea."

#: game/content/achievements.gd:21
msgid "First Crack"
msgstr "Prima crepa"

#: game/content/achievements.gd:21
msgid "It's a start. A very satisfying start."
msgstr "È un inizio. Un inizio molto soddisfacente."

#: game/content/achievements.gd:22
msgid "The target never stood a chance."
msgstr "L'obiettivo non ha avuto scampo."

#: game/content/achievements.gd:22
msgid "Warmed Up"
msgstr "Riscaldamento"

#: game/content/achievements.gd:22
msgid "Win a round."
msgstr "Vinci un round."

#: game/content/achievements.gd:23
msgid "Boss Buster"
msgstr "Spaccaboss"

#: game/content/achievements.gd:23
msgid "Defeat a boss."
msgstr "Sconfiggi un boss."

#: game/content/achievements.gd:23
msgid "They always look bigger on the poster."
msgstr "Sul manifesto sembrano sempre più grossi."

#: game/content/achievements.gd:24
msgid "Intermission is over. Back to your seats."
msgstr "L'intervallo è finito. Tornate ai vostri posti."

#: game/content/achievements.gd:24
msgid "Reach Act 2 (round 5)."
msgstr "Raggiungi l'atto 2 (round 5)."

#: game/content/achievements.gd:24
msgid "Second Act"
msgstr "Secondo atto"

#: game/content/achievements.gd:25
msgid "Final Act"
msgstr "Atto finale"

#: game/content/achievements.gd:25
msgid "Reach Act 3 (round 9)."
msgstr "Raggiungi l'atto 3 (round 9)."

#: game/content/achievements.gd:25
msgid "The curtain is starting to twitch."
msgstr "Il sipario comincia a fremere."

#: game/content/achievements.gd:26
msgid "Blink and you missed it."
msgstr "Un battito di ciglia e te lo sei perso."

#: game/content/achievements.gd:26
msgid "Speedrunner"
msgstr "Speedrunner"

#: game/content/achievements.gd:26
msgid "Win a round in five placements or fewer."
msgstr "Vinci un round in cinque mosse o meno."

#: game/content/achievements.gd:27
msgid "BLOCKMANIA!"
msgstr "BLOCKMANIA!"

#: game/content/achievements.gd:27
msgid "Beat the game: win round 12."
msgstr "Finisci il gioco: vinci il round 12."

#: game/content/achievements.gd:27
msgid "Twelve rounds, three bosses, one very full board."
msgstr "Dodici round, tre boss e una plancia pienissima."

#: game/content/achievements.gd:28
msgid "A good builder never blames the Kit."
msgstr "Un bravo costruttore non dà mai la colpa al kit."

#: game/content/achievements.gd:28
msgid "Beat the game with any Kit other than the Standard Kit."
msgstr "Finisci il gioco con un kit diverso dal Kit standard."

#: game/content/achievements.gd:28
msgid "Different Tools"
msgstr "Attrezzi diversi"

#: game/content/achievements.gd:29 game/content/tips.gd:33
msgid "Overtime"
msgstr "Supplementari"

#: game/content/achievements.gd:29
msgid "The arcade was supposed to close an hour ago."
msgstr "La sala giochi doveva chiudere un'ora fa."

#: game/content/achievements.gd:29
msgid "Win a round in Overtime (after beating the game, keep playing)."
msgstr "Vinci un round nei supplementari (dopo aver finito il gioco, continua a giocare)."

#: game/content/achievements.gd:30
msgid "Every target is a cliff now."
msgstr "Ogni obiettivo ora è uno strapiombo."

#: game/content/achievements.gd:30
msgid "Reach round 20 in Overtime."
msgstr "Raggiungi il round 20 nei supplementari."

#: game/content/achievements.gd:30
msgid "Sudden Death"
msgstr "Morte improvvisa"

#: game/content/achievements.gd:31
msgid "No Off Switch"
msgstr "Senza interruttore"

#: game/content/achievements.gd:31
msgid "Reach round 30 in Overtime."
msgstr "Raggiungi il round 30 nei supplementari."

#: game/content/achievements.gd:31
msgid "Somebody unplug this thing."
msgstr "Qualcuno stacchi la spina a questo affare."

#: game/content/achievements.gd:32
msgid "Broke the Machine"
msgstr "Macchina rotta"

#: game/content/achievements.gd:32
msgid "ERR ERR ERR. Please insert more digits."
msgstr "ERR ERR ERR. Inserire altre cifre, prego."

#: game/content/achievements.gd:32
msgid "Score a single placement past the machine's limit (1,000,000,000,000,000 points)."
msgstr "Supera il limite della macchina con una sola mossa (1 000 000 000 000 000 punti)."

#: game/content/achievements.gd:32
msgid "Some scores are too big for any machine."
msgstr "Certi punteggi sono troppo grandi per qualsiasi macchina."

#: game/content/achievements.gd:34
msgid "Blue Period"
msgstr "Periodo blu"

#: game/content/achievements.gd:34
msgid "Feeling a little blue? Feeling VERY blue."
msgstr "Un po' giù di morale? No: MOLTO blu."

#: game/content/achievements.gd:34
msgid "Have 10 or more blue pieces in your bag."
msgstr "Tieni almeno 10 pezzi blu nel sacco."

#: game/content/achievements.gd:35
msgid "Have 10 or more Square pieces (2x2 or 3x3) in your bag."
msgstr "Tieni almeno 10 pezzi Quadrato (2x2 o 3x3) nel sacco."

#: game/content/achievements.gd:35
msgid "Square Dance"
msgstr "Quadriglia"

#: game/content/achievements.gd:35
msgid "Swing your partner, stack your blocks."
msgstr "Fai girare la dama, impila i blocchi."

#: game/content/achievements.gd:36
msgid "Full Spectrum"
msgstr "Spettro completo"

#: game/content/achievements.gd:36
msgid "Have at least five pieces of every color in your bag."
msgstr "Tieni almeno cinque pezzi di ogni colore nel sacco."

#: game/content/achievements.gd:36
msgid "Taste the whole toybox."
msgstr "Assaggia tutto il baule dei giocattoli."

#: game/content/achievements.gd:37
msgid "Have 40 or more pieces in your bag."
msgstr "Tieni almeno 40 pezzi nel sacco."

#: game/content/achievements.gd:37
msgid "Packrat"
msgstr "Accumulatore"

#: game/content/achievements.gd:37
msgid "You never know when you'll need a spare T."
msgstr "Non si sa mai quando servirà una T di scorta."

#: game/content/achievements.gd:38
msgid "Only the essentials."
msgstr "Solo l'essenziale."

#: game/content/achievements.gd:38
msgid "Shrink your bag to 14 pieces or fewer."
msgstr "Riduci il sacco a 14 pezzi o meno."

#: game/content/achievements.gd:38
msgid "Travel Light"
msgstr "Bagaglio leggero"

#: game/content/achievements.gd:39
msgid "Alchemist"
msgstr "Alchimista"

#: game/content/achievements.gd:39
msgid "Own pieces of all five materials at once: Chrome, Neon, Gold, Glass and Prism."
msgstr "Possiedi insieme pezzi di tutti e cinque i materiali: cromo, neon, oro, vetro e prisma."

#: game/content/achievements.gd:39
msgid "Plastic into gold, gold into glass."
msgstr "La plastica in oro, l'oro in vetro."

#: game/content/achievements.gd:40
msgid "Own pieces with all four stamps at once: Encore, Refund, Tip and Memory."
msgstr "Possiedi insieme pezzi con tutti e quattro i timbri: Bis, Rimborso, Mancia e Memoria."

#: game/content/achievements.gd:40
msgid "Signed, sealed, stamped four times."
msgstr "Firmato, sigillato e timbrato quattro volte."

#: game/content/achievements.gd:40
msgid "Special Delivery"
msgstr "Consegna speciale"

#: game/content/achievements.gd:41
msgid "Fill every Joker slot."
msgstr "Riempi tutti gli slot dei Jolly."

#: game/content/achievements.gd:41
msgid "Full House"
msgstr "Tutto esaurito"

#: game/content/achievements.gd:41
msgid "No vacancies at the Joker hotel."
msgstr "Nessuna camera libera all'hotel dei Jolly."

#: game/content/achievements.gd:42
msgid "Hold three Rare Jokers at the same time."
msgstr "Tieni tre Jolly rari allo stesso tempo."

#: game/content/achievements.gd:42
msgid "Only the finest cardboard."
msgstr "Solo il cartone più pregiato."

#: game/content/achievements.gd:42
msgid "Rare Taste"
msgstr "Gusto raffinato"

#: game/content/achievements.gd:43
msgid "Master Plan"
msgstr "Piano geniale"

#: game/content/achievements.gd:43
msgid "Raise a shape family to Schematic level 3."
msgstr "Porta una famiglia di forme al livello di progetto 3."

#: game/content/achievements.gd:43
msgid "The blueprints have blueprints."
msgstr "I progetti hanno dei progetti."

#: game/content/achievements.gd:44
msgid "Hold 50 or more Credits."
msgstr "Tieni almeno 50 crediti."

#: game/content/achievements.gd:44
msgid "Oink."
msgstr "Oink."

#: game/content/achievements.gd:44
msgid "Piggy Bank"
msgstr "Salvadanaio"

#: game/content/achievements.gd:45
msgid "Even a wallet has a limit."
msgstr "Anche un portafoglio ha un limite."

#: game/content/achievements.gd:45
msgid "Hold the maximum 99 Credits."
msgstr "Tieni il massimo di 99 crediti."

#: game/content/achievements.gd:45
msgid "Scrooge"
msgstr "Paperone"

#: game/content/achievements.gd:45
msgid "Swimming in coins is harder than it looks."
msgstr "Nuotare nelle monete è più difficile di quanto sembri."

#: game/content/achievements.gd:47
msgid "Big Hit"
msgstr "Colpo grosso"

#: game/content/achievements.gd:47
msgid "Ka-chunk."
msgstr "Ka-ciunk."

#: game/content/achievements.gd:47
msgid "Score 1,000 points with one placement."
msgstr "Fai 1 000 punti con una mossa."

#: game/content/achievements.gd:48
msgid "Mega Hit"
msgstr "Mega colpo"

#: game/content/achievements.gd:48
msgid "Score 10,000 points with one placement."
msgstr "Fai 10 000 punti con una mossa."

#: game/content/achievements.gd:48
msgid "The receipt printer is sweating."
msgstr "La stampante degli scontrini sta sudando."

#: game/content/achievements.gd:49
msgid "Giga Hit"
msgstr "Giga colpo"

#: game/content/achievements.gd:49
msgid "Score 1,000,000 points with one placement."
msgstr "Fai 1 000 000 di punti con una mossa."

#: game/content/achievements.gd:49
msgid "That's a lot of zeros for one little piece."
msgstr "Sono tanti zeri per un pezzo così piccolo."

#: game/content/achievements.gd:50
msgid "Clear three lines with one placement."
msgstr "Elimina tre linee con una mossa."

#: game/content/achievements.gd:50
msgid "Stacked high and cleared clean."
msgstr "Impilato in alto, ripulito a fondo."

#: game/content/achievements.gd:50
msgid "Triple Decker"
msgstr "Tre piani"

#: game/content/achievements.gd:51
msgid "Clear four or more lines with one placement."
msgstr "Elimina quattro o più linee con una mossa."

#: game/content/achievements.gd:51
msgid "Four-Alarm Fire"
msgstr "Allarme rosso"

#: game/content/achievements.gd:51
msgid "Somebody call the block brigade."
msgstr "Qualcuno chiami i pompieri dei blocchi."

#: game/content/achievements.gd:52
msgid "Clear a row and a column with one placement."
msgstr "Elimina una riga e una colonna con una mossa."

#: game/content/achievements.gd:52
msgid "Crossroads"
msgstr "Crocevia"

#: game/content/achievements.gd:52
msgid "X marks the spot."
msgstr "La X segna il punto."

#: game/content/achievements.gd:53
msgid "Don't touch the board, it's hot."
msgstr "Non toccare la plancia, scotta."

#: game/content/achievements.gd:53
msgid "Reach the maximum combo (x4)."
msgstr "Raggiungi la combo massima (x4)."

#: game/content/achievements.gd:53
msgid "Red Hot"
msgstr "Rovente"

#: game/content/achievements.gd:54
msgid "Finish a round with at least three times its target."
msgstr "Finisci un round con almeno il triplo del suo obiettivo."

#: game/content/achievements.gd:54
msgid "Overkill"
msgstr "Esagerato"

#: game/content/achievements.gd:54
msgid "The target asked for a little. You gave a lot."
msgstr "L'obiettivo chiedeva poco. Tu hai dato tantissimo."

#: game/content/achievements.gd:55
msgid "By a Thread"
msgstr "Per un pelo"

#: game/content/achievements.gd:55
msgid "Close. So close. Close enough!"
msgstr "Vicino. Vicinissimo. Abbastanza vicino!"

#: game/content/achievements.gd:55
msgid "Win a round with your very last placement."
msgstr "Vinci un round con la tua ultimissima mossa."

#: game/content/achievements.gd:56
msgid "Leave the board completely empty after a clear (campaign)."
msgstr "Lascia la plancia completamente vuota dopo un'eliminazione (campagna)."

#: game/content/achievements.gd:56
msgid "Spotless"
msgstr "Immacolato"

#: game/content/achievements.gd:56
msgid "You could eat off this board."
msgstr "Su questa plancia ci si potrebbe mangiare."

#: game/content/achievements.gd:57
msgid "Get dealt a Grand Slam Tray Hand."
msgstr "Ricevi una mano Grande Slam dal vassoio."

#: game/content/achievements.gd:57 game/rules/hands.gd:17
msgid "Grand Slam"
msgstr "Grande Slam"

#: game/content/achievements.gd:57
msgid "Three of a kind, one color, all the lights."
msgstr "Tris, un solo colore e tutte le luci accese."

#: game/content/achievements.gd:58
msgid "Full Deck"
msgstr "Mazzo completo"

#: game/content/achievements.gd:58
msgid "See all five Tray Hands (across any runs)."
msgstr "Scopri tutte e cinque le mani del vassoio (in qualsiasi partita)."

#: game/content/achievements.gd:58
msgid "Twins, Staircase, Monochrome, Triplets, Grand Slam. Collected."
msgstr "Gemelli, Scala, Monocromo, Tris, Grande Slam. Collezione completa."

#: game/content/achievements.gd:60
msgid "Arcade Rookie"
msgstr "Novellino della sala giochi"

#: game/content/achievements.gd:60
msgid "Put your initials in. Go on."
msgstr "Metti le tue iniziali. Dai."

#: game/content/achievements.gd:60
msgid "Score 5,000 points in one Endless game."
msgstr "Fai 5 000 punti in una partita Infinita."

#: game/content/achievements.gd:61
msgid "Arcade Regular"
msgstr "Habitué della sala giochi"

#: game/content/achievements.gd:61
msgid "Score 25,000 points in one Endless game."
msgstr "Fai 25 000 punti in una partita Infinita."

#: game/content/achievements.gd:61
msgid "The cabinet knows your name."
msgstr "Il cabinato conosce il tuo nome."

#: game/content/achievements.gd:62
msgid "Arcade Legend"
msgstr "Leggenda della sala giochi"

#: game/content/achievements.gd:62
msgid "Score 100,000 points in one Endless game."
msgstr "Fai 100 000 punti in una partita Infinita."

#: game/content/achievements.gd:62
msgid "They're going to name the cabinet after you."
msgstr "Daranno il tuo nome al cabinato."

#: game/content/achievements.gd:63
msgid "Blockstorm"
msgstr "Tempesta di blocchi"

#: game/content/achievements.gd:63
msgid "Reach the x10 combo in Endless."
msgstr "Raggiungi la combo x10 in modalità Infinita."

#: game/content/achievements.gd:63
msgid "Ten out of ten. No notes."
msgstr "Dieci su dieci. Nessun appunto."

#: game/content/achievements.gd:64
msgid "Ahh. That new-board smell."
msgstr "Ahh. Quel profumo di plancia nuova."

#: game/content/achievements.gd:64
msgid "Clear the whole board in Endless."
msgstr "Svuota tutta la plancia in modalità Infinita."

#: game/content/achievements.gd:64
msgid "Fresh Start"
msgstr "Si ricomincia"

#: game/content/achievements.gd:65
msgid "BL...CKM...NIA? Where did everything go?"
msgstr "BL...CKM...NIA? Dov'è finito tutto?"

#: game/content/achievements.gd:65
msgid "Have every letter of the BLOCKMANIA logo blown up at once."
msgstr "Fai esplodere insieme tutte le lettere del logo BLOCKMANIA."

#: game/content/achievements.gd:65
msgid "The title looks awfully fragile."
msgstr "Il titolo sembra terribilmente fragile."

#: game/content/achievements.gd:65
msgid "Vandal"
msgstr "Vandalo"

#: game/content/achievements.gd:66
msgid "Night Shift"
msgstr "Turno di notte"

#: game/content/achievements.gd:66
msgid "Place a piece between midnight and 5 AM."
msgstr "Piazza un pezzo tra mezzanotte e le 5 del mattino."

#: game/content/achievements.gd:66
msgid "Some players only come out after dark."
msgstr "Alcuni giocatori escono solo col buio."

#: game/content/achievements.gd:66
msgid "The blocks glow brighter at night. Probably."
msgstr "Di notte i blocchi brillano di più. Probabilmente."

#: game/content/achievements.gd:67
msgid "Look Ma, No Lines"
msgstr "Guarda, mamma, senza linee"

#: game/content/achievements.gd:67
msgid "Technically, the rules never said you HAD to."
msgstr "Tecnicamente, le regole non hanno mai detto che DOVEVI farlo."

#: game/content/achievements.gd:67
msgid "Who needs lines anyway?"
msgstr "Chi ha bisogno delle linee, poi?"

#: game/content/achievements.gd:67
msgid "Win a campaign round without clearing a single line."
msgstr "Vinci un round della campagna senza eliminare nemmeno una linea."

#: game/content/achievements.gd:68
msgid "Butterfingers"
msgstr "Mani di burro"

#: game/content/achievements.gd:68
msgid "Handle with care."
msgstr "Maneggiare con cura."

#: game/content/achievements.gd:68
msgid "Shatter a Glass piece."
msgstr "Frantuma un pezzo di vetro."

#: game/content/achievements.gd:68
msgid "That one's coming out of your allowance."
msgstr "Questo te lo scalo dalla paghetta."

#: game/content/achievements.gd:69
msgid "In case of emergency, break something."
msgstr "In caso di emergenza, rompi qualcosa."

#: game/content/achievements.gd:69
msgid "Through the Window"
msgstr "Dalla finestra"

#: game/content/achievements.gd:69
msgid "Throw an Emergency Brick."
msgstr "Lancia un mattone d'emergenza."

#: game/content/achievements.gd:69
msgid "Who's paying for that?"
msgstr "E chi paga adesso?"

#: game/content/achievements.gd:70
msgid "Always read the small text."
msgstr "Leggi sempre le clausole in piccolo."

#: game/content/achievements.gd:70
msgid "Get a lost round replayed by Insurance Policy."
msgstr "Fatti rigiocare un round perso dalla Polizza assicurativa."

#: game/content/achievements.gd:70
msgid "Terms and conditions apply. Luckily, they applied to you."
msgstr "Si applicano termini e condizioni. Per fortuna, si applicavano a te."

#: game/content/achievements.gd:70
msgid "The Fine Print"
msgstr "Le clausole in piccolo"

#: game/content/achievements.gd:71
msgid "Block Maniac"
msgstr "Blockmaniaco"

#: game/content/achievements.gd:71
msgid "The whole trophy case. Every last shelf. Take a bow."
msgstr "Tutta la vetrina. Fino all'ultimo ripiano. Inchinati."

#: game/content/achievements.gd:71
msgid "Unlock every other achievement."
msgstr "Sblocca tutti gli altri obiettivi."

#: game/content/achievements.gd:73
msgid "It hums a little when you hold it."
msgstr "Ronza un po' quando lo tieni in mano."

#: game/content/achievements.gd:73
msgid "Once Upon a Legend"
msgstr "C'era una volta una leggenda"

#: game/content/achievements.gd:73
msgid "Own a Legendary Joker."
msgstr "Possiedi un Jolly leggendario."

#: game/content/achievements.gd:74
msgid "Double Legend"
msgstr "Doppia leggenda"

#: game/content/achievements.gd:74
msgid "One legend is a story. Two is a problem."
msgstr "Una leggenda è una storia. Due sono un problema."

#: game/content/achievements.gd:74
msgid "Own two Legendary Jokers at the same time."
msgstr "Possiedi due Jolly leggendari allo stesso tempo."

#: game/content/achievements.gd:74
msgid "The rack has never looked so smug."
msgstr "La rastrelliera non è mai sembrata così fiera."

#: game/content/achievements.gd:75
msgid "Own each of the four Legendary Jokers (across any runs)."
msgstr "Possiedi ciascuno dei quattro Jolly leggendari (in qualsiasi partita)."

#: game/content/achievements.gd:75
msgid "Pantheon"
msgstr "Pantheon"

#: game/content/achievements.gd:75
msgid "The Avalanche, the Mirrors, the Stone and the Star. All accounted for."
msgstr "La Valanga, gli Specchi, la Pietra e la Stella. Tutti presenti."

#: game/content/achievements.gd:76
msgid "Chain Reaction"
msgstr "Reazione a catena"

#: game/content/achievements.gd:76
msgid "Chain three clear waves in one placement with The Avalanche."
msgstr "Concatena tre ondate di eliminazione in una mossa con La Valanga."

#: game/content/achievements.gd:76
msgid "Nobody touch anything. Let it fall."
msgstr "Nessuno tocchi niente. Lasciala cadere."

#: game/content/achievements.gd:77
msgid "How many of you are in there?"
msgstr "Quanti di te ci sono lì dentro?"

#: game/content/achievements.gd:77
msgid "Mirror World"
msgstr "Mondo allo specchio"

#: game/content/achievements.gd:77
msgid "Score a placement where Hall of Mirrors doubles four other Jokers."
msgstr "Fai punti con una mossa in cui la Galleria degli specchi raddoppia altri quattro Jolly."

#: game/content/achievements.gd:78
msgid "Chrome, neon, gold and glass. Very little plastic left."
msgstr "Cromo, neon, oro e vetro. Di plastica ne è rimasta poca."

#: game/content/achievements.gd:78
msgid "Have 15 or more pieces with a material in your bag."
msgstr "Tieni almeno 15 pezzi con un materiale nel sacco."

#: game/content/achievements.gd:78
msgid "Heavy Metal"
msgstr "Heavy metal"

#: game/content/achievements.gd:79
msgid "Eighteen lines and one very bright star."
msgstr "Diciotto linee e una stella luminosissima."

#: game/content/achievements.gd:79
msgid "Going Nova"
msgstr "Verso la nova"

#: game/content/achievements.gd:79
msgid "Score with Supernova at x10 Mult or more."
msgstr "Fai punti con Supernova a x10 Mult o più."

#: game/content/achievements.gd:80
msgid "Grow Snowball to x2 Mult or more."
msgstr "Fai crescere Palla di neve fino a x2 Mult o più."

#: game/content/achievements.gd:80
msgid "It started as a pebble of snow."
msgstr "È cominciata con un fiocco di neve."

#: game/content/achievements.gd:80
msgid "Snowed In"
msgstr "Innevato"

#: game/content/achievements.gd:81
msgid "Compound Growth"
msgstr "Crescita composta"

#: game/content/achievements.gd:81
msgid "Earn the maximum interest (+5 Credits) after a round."
msgstr "Ottieni l'interesse massimo (+5 crediti) dopo un round."

#: game/content/achievements.gd:81
msgid "Your Credits have been working harder than you."
msgstr "I tuoi crediti hanno lavorato più di te."

#: game/content/achievements.gd:82
msgid "Have seven Joker slots."
msgstr "Abbi sette slot per i Jolly."

#: game/content/achievements.gd:82
msgid "Two Rack Extenders and a lot of shelf brackets."
msgstr "Due prolunghe per rastrelliera e tante staffe."

#: game/content/achievements.gd:82
msgid "Wide Rack"
msgstr "Rastrelliera larga"

#: game/content/achievements.gd:83
msgid "Billionaire"
msgstr "Miliardario"

#: game/content/achievements.gd:83
msgid "Nine zeros. The counter had to borrow some."
msgstr "Nove zeri. Il contatore ha dovuto prenderne qualcuno in prestito."

#: game/content/achievements.gd:83
msgid "Score 1,000,000,000 points with one placement."
msgstr "Fai 1 000 000 000 di punti con una mossa."

#: game/content/achievements.gd:84
msgid "Even legends have bad days."
msgstr "Anche le leggende hanno le loro giornate storte."

#: game/content/achievements.gd:84
msgid "Fallen Hero"
msgstr "Eroe caduto"

#: game/content/achievements.gd:84
msgid "Lose a run while owning a Legendary Joker."
msgstr "Perdi una partita mentre possiedi un Jolly leggendario."

#: game/content/achievements.gd:84
msgid "They'll write songs about it. Sad ones."
msgstr "Ci scriveranno delle canzoni. Tristi."

#: game/content/bosses.gd:7
msgid "Cramped Cabinet"
msgstr "Armadio Angusto"

#: game/content/bosses.gd:7
msgid "The Cramped Cabinet"
msgstr "L'Armadio Angusto"

#: game/content/bosses.gd:8
msgid "The round begins with four fixed occupied cells. They clear normally and score no placement Chips."
msgstr "Il round inizia con quattro caselle occupate fisse. Si eliminano normalmente e non danno Fiches di piazzamento."

#: game/content/bosses.gd:9
msgid "The round begins with seven fixed occupied cells. They clear normally and score no placement Chips."
msgstr "Il round inizia con sette caselle occupate fisse. Si eliminano normalmente e non danno Fiches di piazzamento."

#: game/content/bosses.gd:10
msgid "Favor small shapes or board-clearing tools."
msgstr "Preferisci forme piccole o strumenti che liberano la plancia."

#: game/content/bosses.gd:11
msgid "Taxman"
msgstr "Esattore"

#: game/content/bosses.gd:11
msgid "The Taxman"
msgstr "L'Esattore"

#: game/content/bosses.gd:12
msgid "The first line cleared by each placement grants 60 instead of 100 base Chips."
msgstr "La prima linea eliminata da ogni mossa dà 60 Fiches base invece di 100."

#: game/content/bosses.gd:13
msgid "The first line cleared by each placement grants 30 instead of 100 base Chips, and multi-line Mult is halved."
msgstr "La prima linea eliminata da ogni mossa dà 30 Fiches base invece di 100, e il Mult multilinea è dimezzato."

#: game/content/bosses.gd:14
msgid "Pursue double clears and flat Chip Jokers."
msgstr "Punta sulle eliminazioni doppie e sui Jolly a Fiches fisse."

#: game/content/bosses.gd:15
msgid "Color Blind"
msgstr "Daltonico"

#: game/content/bosses.gd:15
msgid "The Color Blind"
msgstr "Il Daltonico"

#: game/content/bosses.gd:16
msgid "Effects that name a block color are disabled this round."
msgstr "Gli effetti che citano un colore dei blocchi sono disattivati in questo round."

#: game/content/bosses.gd:17
msgid "Effects that name a block color are disabled, and you have two fewer placements."
msgstr "Gli effetti che citano un colore dei blocchi sono disattivati e hai due mosse in meno."

#: game/content/bosses.gd:18
msgid "Diversify beyond color-dependent scoring."
msgstr "Non puntare tutto sui colori."

#: game/content/bosses.gd:21
msgid "Echo Chamber"
msgstr "Camera dell'Eco"

#: game/content/bosses.gd:21
msgid "The Echo Chamber"
msgstr "La Camera dell'Eco"

#: game/content/bosses.gd:22
msgid "Extra clear waves after the first score half Chips before Jokers."
msgstr "Le ondate di eliminazione dopo la prima danno metà Fiches prima dei Jolly."

#: game/content/bosses.gd:23
msgid "Prefer immediate clears over chained board effects."
msgstr "Preferisci eliminazioni immediate agli effetti a catena."

#: game/content/bosses.gd:24
msgid "Lockdown"
msgstr "Blocco"

#: game/content/bosses.gd:24
msgid "The Lockdown"
msgstr "Il Blocco"

#: game/content/bosses.gd:25
msgid "The free Refresh and Second Tray are unavailable this round."
msgstr "La rimescolata gratuita e il Secondo vassoio non sono disponibili in questo round."

#: game/content/bosses.gd:26
msgid "Refresh, Second Tray, Coffee Break and Hold are all unavailable this round."
msgstr "Rimescolata, Secondo vassoio, Pausa caffè e Riserva non sono disponibili in questo round."

#: game/content/bosses.gd:27
msgid "Plan tray order and preserve board space."
msgstr "Pianifica l'ordine del vassoio e conserva spazio sulla plancia."

#: game/content/bosses.gd:28
msgid "The Warden"
msgstr "Il Carceriere"

#: game/content/bosses.gd:28
msgid "Warden"
msgstr "Carceriere"

#: game/content/bosses.gd:29
msgid "One tray slot starts barred: its piece can't be played until you clear a line. Deals skip the barred slot."
msgstr "Uno slot del vassoio parte sbarrato: il suo pezzo non si può giocare finché non elimini una linea. Le distribuzioni saltano lo slot sbarrato."

#: game/content/bosses.gd:30
msgid "Two tray slots start barred. Each clearing placement frees one. Deals skip barred slots."
msgstr "Due slot del vassoio partono sbarrati. Ogni mossa che elimina una linea ne libera uno. Le distribuzioni saltano gli slot sbarrati."

#: game/content/bosses.gd:31
msgid "Open with a quick clear using the other two slots."
msgstr "Apri con un'eliminazione rapida usando gli altri due slot."

#: game/content/bosses.gd:32
msgid "The Undertaker"
msgstr "Il Becchino"

#: game/content/bosses.gd:32
msgid "Undertaker"
msgstr "Becchino"

#: game/content/bosses.gd:33
msgid "After every 4th placement, a tombstone rises on an empty cell. It clears with its line like any block."
msgstr "Ogni 4 mosse spunta una lapide su una casella vuota. Si elimina con la sua linea come qualsiasi blocco."

#: game/content/bosses.gd:34
msgid "After every 3rd placement, a tombstone rises on an empty cell. It clears with its line like any block."
msgstr "Ogni 3 mosse spunta una lapide su una casella vuota. Si elimina con la sua linea come qualsiasi blocco."

#: game/content/bosses.gd:35
msgid "Clear often and keep lanes open."
msgstr "Elimina spesso e tieni aperti i corridoi."

#: game/content/bosses.gd:36
msgid "Last Call"
msgstr "Ultimo Giro"

#: game/content/bosses.gd:36
msgid "The Last Call"
msgstr "L'Ultimo Giro"

#: game/content/bosses.gd:37
msgid "Only 12 placements. Each multi-line placement gains +50 Chips."
msgstr "Solo 12 mosse. Ogni mossa multilinea ottiene +50 Fiches."

#: game/content/bosses.gd:38
msgid "Only 10 placements. Each multi-line placement gains +50 Chips."
msgstr "Solo 10 mosse. Ogni mossa multilinea ottiene +50 Fiches."

#: game/content/bosses.gd:39
msgid "Prepare efficient shapes and simultaneous clears."
msgstr "Prepara forme efficienti ed eliminazioni simultanee."

#: game/content/consumables.gd:11
msgid "Add +40 Chips per round number to the next placement this round."
msgstr "Aggiunge +40 Fiches per numero di round alla prossima mossa di questo round."

#. rules text (shown through BMLoc.tf)
#: game/content/consumables.gd:11 game/rules/resolver.gd:225
msgid "Polish"
msgstr "Lucidante"

#: game/content/consumables.gd:12
msgid "Add +1 Mult per act to the next placement this round."
msgstr "Aggiunge +1 Mult per atto alla prossima mossa di questo round."

#. rules text (shown through BMLoc.tf)
#: game/content/consumables.gd:12 game/rules/resolver.gd:256
msgid "Spark"
msgstr "Scintilla"

#: game/content/consumables.gd:13
msgid "Eraser"
msgstr "Gomma"

#: game/content/consumables.gd:13
msgid "Remove up to three blocks of your choice from the board."
msgstr "Rimuove dalla plancia fino a tre blocchi a tua scelta."

#: game/content/consumables.gd:14
msgid "Refresh the current tray without spending the round's free Refresh."
msgstr "Rimescola il vassoio attuale senza usare la rimescolata gratuita del round."

#. rules text (shown through BMLoc.tf)
#: game/content/consumables.gd:14 game/run/run.gd:773
msgid "Second Tray"
msgstr "Secondo vassoio"

#: game/content/consumables.gd:15
msgid "Extra Turn"
msgstr "Turno extra"

#: game/content/consumables.gd:15
msgid "Gain two placements this round (maximum 20 remaining)."
msgstr "Ottieni due mosse in questo round (massimo 20 rimanenti)."

#: game/content/consumables.gd:16
msgid "Lucky Paint"
msgstr "Vernice fortunata"

#: game/content/consumables.gd:16
msgid "Recolor one tray piece to a color of your choice. Its shape is unchanged."
msgstr "Ricolora un pezzo del vassoio del colore che vuoi. La forma non cambia."

#: game/content/consumables.gd:17
msgid "Color Purge"
msgstr "Epurazione di colore"

#: game/content/consumables.gd:17
msgid "Remove every block of one color from the board. Stone is immune."
msgstr "Rimuove dalla plancia tutti i blocchi di un colore. La pietra è immune."

#: game/content/consumables.gd:18
msgid "Emergency Brick"
msgstr "Mattone d'emergenza"

#: game/content/consumables.gd:18
msgid "Throw a brick at a tray slot: it becomes a temporary one-block piece. A piece it hits goes to the discard pile."
msgstr "Lancia un mattone su uno slot del vassoio: diventa un pezzo temporaneo da un blocco. Il pezzo colpito finisce negli scarti."

#: game/content/consumables.gd:20
msgid "The next placement this round gets x2 Mult."
msgstr "La prossima mossa di questo round ottiene x2 Mult."

#. rules text (shown through BMLoc.tf)
#: game/content/consumables.gd:20 game/rules/resolver.gd:278
msgid "Turbo"
msgstr "Turbo"

#: game/content/consumables.gd:21
msgid "Level up the shape family of a tray piece, like a Schematic (+25 Chips, +0.25 Mult per level)."
msgstr "Fa salire di livello la famiglia di forme di un pezzo del vassoio, come un Progetto (+25 Fiches, +0.25 Mult per livello)."

#: game/content/consumables.gd:21
msgid "Tune-Up"
msgstr "Messa a punto"

#: game/content/consumables.gd:22
msgid "Coin Roll"
msgstr "Rotolo di monete"

#: game/content/consumables.gd:22
msgid "Gain Credits equal to the round number (max 12)."
msgstr "Ottieni tanti crediti quanto il numero del round (max 12)."

#: game/content/consumables.gd:24
msgid "1 in 5 chance: a random Uncommon or better Joker joins your rack. Needs a free Joker slot."
msgstr "1 possibilità su 5: un Jolly casuale non comune o migliore entra nella tua rastrelliera. Serve uno slot Jolly libero."

#: game/content/consumables.gd:24
msgid "Lucky Draw"
msgstr "Estrazione"

#: game/content/consumables.gd:25
msgid "A random stamp goes on a random unstamped piece in your bag, for good."
msgstr "Un timbro casuale va su un pezzo senza timbro del sacco, per sempre."

#: game/content/consumables.gd:25
msgid "Mystery Stamp"
msgstr "Timbro misterioso"

#: game/content/consumables.gd:26
msgid "1 in 5 chance to double your Credits (at most +20). Otherwise nothing."
msgstr "1 possibilità su 5 di raddoppiare i crediti (al massimo +20). Altrimenti niente."

#: game/content/consumables.gd:26
msgid "Double Down"
msgstr "Raddoppio"

#: game/content/consumables.gd:27
msgid "Phantom Line"
msgstr "Linea fantasma"

#: game/content/consumables.gd:27
msgid "The next placement that clears a line counts one extra line (Chips, Mult, refills and Jokers)."
msgstr "La prossima mossa che elimina una linea conta una linea in più (Fiches, Mult, ricariche e Jolly)."

#: game/content/consumables.gd:30
msgid "Punch"
msgstr "Pugno"

#: game/content/consumables.gd:30
msgid "Smash a plus-shaped area: remove up to 5 blocks around the cell you hit."
msgstr "Colpisci un'area a croce: rimuove fino a 5 blocchi attorno alla casella colpita."

#: game/content/consumables.gd:31
msgid "+1 Refresh this round."
msgstr "+1 rimescolata in questo round."

#: game/content/consumables.gd:31
msgid "Coffee Break"
msgstr "Pausa caffè"

#. rules text (shown through BMLoc.tf)
#: game/content/consumables.gd:32 game/run/run.gd:1403
msgid "Cash Out"
msgstr "Incasso"

#: game/content/consumables.gd:32
msgid "Gain 4 Credits after this round if it is won."
msgstr "Ottieni 4 crediti dopo questo round, se lo vinci."

#: game/content/consumables.gd:33
msgid "Blueprint"
msgstr "Bozza"

#: game/content/consumables.gd:33
msgid "Swap one tray piece for a temporary 1-3 cell piece you choose."
msgstr "Sostituisci un pezzo del vassoio con un pezzo temporaneo da 1-3 caselle a tua scelta."

#: game/content/consumables.gd:125
#, c-format
msgid "+%s Chips"
msgstr "+%s Fiches"

#: game/content/consumables.gd:127
#, c-format
msgid "+%s Mult"
msgstr "+%s Mult"

#: game/content/consumables.gd:129
#, c-format
msgid "+%d Credit"
msgid_plural "+%d Credits"
msgstr[0] "+%d credito"
msgstr[1] "+%d crediti"

#: game/content/consumables.gd:131
#, c-format
msgid "Win +%d"
msgstr "Vincita +%d"

#: game/content/consumables.gd:134
#, c-format
msgid "%d free Joker slot"
msgid_plural "%d free Joker slots"
msgstr[0] "%d slot Jolly libero"
msgstr[1] "%d slot Jolly liberi"

#: game/content/consumables.gd:137
#, c-format
msgid "%d unstamped piece"
msgid_plural "%d unstamped pieces"
msgstr[0] "%d pezzo senza timbro"
msgstr[1] "%d pezzi senza timbro"

#: game/content/feats.gd:8
msgid "Clear a row and a column in the same placement."
msgstr "Elimina una riga e una colonna con la stessa mossa."

#: game/content/feats.gd:8
msgid "Crossfire"
msgstr "Fuoco incrociato"

#: game/content/feats.gd:9
msgid "Clear lines on two placements in a row."
msgstr "Elimina linee in due mosse di fila."

#: game/content/feats.gd:9
msgid "Double Tap"
msgstr "Doppio colpo"

#: game/content/feats.gd:10
msgid "Clear three or more lines in one placement."
msgstr "Elimina tre o più linee con una mossa."

#: game/content/feats.gd:10
msgid "Hat Trick"
msgstr "Tripletta"

#: game/content/feats.gd:11
msgid "Clean Board"
msgstr "Plancia pulita"

#: game/content/feats.gd:11
msgid "Leave the board completely empty."
msgstr "Lascia la plancia completamente vuota."

#: game/content/feats.gd:12
msgid "Fill a one-block hole (closed on all four sides) and clear a line with it."
msgstr "Riempi un buco da un blocco (chiuso su tutti e quattro i lati) ed elimina una linea con esso."

#: game/content/feats.gd:12
msgid "Needle Threader"
msgstr "Infila-ago"

#: game/content/feats.gd:13
msgid "Clear a line with your last placement."
msgstr "Elimina una linea con la tua ultima mossa."

#: game/content/feats.gd:13
msgid "Last Breath"
msgstr "Ultimo respiro"

#: game/content/holo.gd:18
msgid "Negative Film"
msgstr "Pellicola negativa"

#: game/content/holo.gd:19
msgid "A random Joker that is not Negative turns Negative: it no longer takes a Joker slot."
msgstr "Un Jolly casuale non negativo diventa negativo: non occupa più uno slot Jolly."

#: game/content/holo.gd:20
msgid "AGAIN Seal"
msgstr "Sigillo ANCORA"

#: game/content/holo.gd:21
msgid "A random scoring Joker gains AGAIN: after all your Jokers have scored, it triggers once more."
msgstr "Un Jolly di punteggio casuale ottiene ANCORA: dopo che tutti i tuoi Jolly hanno segnato, si attiva un'altra volta."

#: game/content/holo.gd:22
msgid "Master Schematic"
msgstr "Progetto maestro"

#: game/content/holo.gd:23
msgid "Every shape family in your bag gains a level (+25 Chips, +0.25 Mult per level)."
msgstr "Ogni famiglia di forme del sacco sale di un livello (+25 Fiches, +0.25 Mult per livello)."

#: game/content/holo.gd:24
msgid "Master Tuning"
msgstr "Accordatura maestra"

#: game/content/holo.gd:25
#, c-format
msgid "Every scoring Joker below its top level gains a level (+50% of its effect)."
msgstr "Ogni Jolly di punteggio sotto il livello massimo sale di un livello (effetto +50%)."

#: game/content/holo.gd:26
msgid "Legend Crate"
msgstr "Cassa leggendaria"

#: game/content/holo.gd:27
msgid "The Legendary Joker shown on this card joins your rack. Needs a free Joker slot."
msgstr "Il Jolly leggendario di questa carta entra nella tua rastrelliera. Serve uno slot Jolly libero."

#: game/content/holo.gd:28
msgid "Hologram"
msgstr "Ologramma"

#: game/content/holo.gd:29
msgid "A random Joker that is not Legendary gets a Negative copy (the copy takes no slot)."
msgstr "Un Jolly casuale non leggendario riceve una copia negativa (la copia non occupa slot)."

#: game/content/holo.gd:68
#, c-format
msgid "Legend Crate: %s"
msgstr "Cassa leggendaria: %s"

#: game/content/jokers.gd:17
msgid "Common"
msgstr "Comune"

#: game/content/jokers.gd:17
msgid "Legendary"
msgstr "Leggendario"

#: game/content/jokers.gd:17
msgid "Rare"
msgstr "Raro"

#: game/content/jokers.gd:17
msgid "Uncommon"
msgstr "Non comune"

#: game/content/jokers.gd:23
msgid "+50 Chips when exactly one line clears."
msgstr "+50 Fiches quando si elimina esattamente una linea."

#: game/content/jokers.gd:23
msgid "Clean Sweep"
msgstr "Colpo di scopa"

#: game/content/jokers.gd:24
msgid "+100 Chips when two or more lines clear together; +100 more if they cross (a row and a column)."
msgstr "+100 Fiches quando si eliminano insieme due o più linee; +100 in più se si incrociano (una riga e una colonna)."

#: game/content/jokers.gd:24
msgid "Crossbar"
msgstr "Traversa"

#: game/content/jokers.gd:25
msgid "+15 Chips per placed cell when placing a shape of 1-3 cells."
msgstr "+15 Fiches per casella piazzata quando piazzi una forma da 1-3 caselle."

#: game/content/jokers.gd:25
msgid "Small Change"
msgstr "Spiccioli"

#: game/content/jokers.gd:26
msgid "+100 Chips when placing a shape of 5 or more cells."
msgstr "+100 Fiches quando piazzi una forma da 5 o più caselle."

#: game/content/jokers.gd:26
msgid "Heavy Hand"
msgstr "Mano pesante"

#: game/content/jokers.gd:27
msgid "First Strike"
msgstr "Primo colpo"

#: game/content/jokers.gd:27
msgid "The first clearing placement each round gains +150 Chips."
msgstr "La prima mossa che elimina in ogni round ottiene +150 Fiches."

#: game/content/jokers.gd:28
msgid "+40 Chips if the placed shape touches no occupied cell diagonally (checked before placement)."
msgstr "+40 Fiches se la forma piazzata non tocca in diagonale nessuna casella occupata (verificato prima della mossa)."

#: game/content/jokers.gd:28
msgid "Neat Freak"
msgstr "Maniaco dell'ordine"

#: game/content/jokers.gd:29
msgid "+60 Chips if any placed cell occupies a board corner."
msgstr "+60 Fiches se una casella piazzata occupa un angolo della plancia."

#: game/content/jokers.gd:29
msgid "Corner Office"
msgstr "Ufficio d'angolo"

#: game/content/jokers.gd:30
msgid "Blue Mood"
msgstr "Umore blu"

#: game/content/jokers.gd:30
msgid "Blue shapes gain +2 Mult."
msgstr "Le forme blu ottengono +2 Mult."

#: game/content/jokers.gd:31
msgid "+1 Mult per current combo level on clearing placements."
msgstr "+1 Mult per ogni livello di combo attuale nelle mosse che eliminano."

#: game/content/jokers.gd:31
msgid "Chain Link"
msgstr "Anello di catena"

#: game/content/jokers.gd:32
msgid "+2 Credits after a round won with at least two placements unused."
msgstr "+2 crediti dopo un round vinto con almeno due mosse inutilizzate."

#. rules text (shown through BMLoc.tf)
#: game/content/jokers.gd:32 game/run/run.gd:1401
msgid "Spare Parts"
msgstr "Pezzi di ricambio"

#: game/content/jokers.gd:33
msgid "Once per round, when no offered shape fits and no tray Refresh is available, replace one unplaced shape with a Single before defeat is checked."
msgstr "Una volta per round, quando nessuna forma offerta entra e non resta nessuna rimescolata, sostituisce una forma non piazzata con un Singolo prima di controllare la sconfitta."

#: game/content/jokers.gd:33
msgid "Tiny Insurance"
msgstr "Mini assicurazione"

#: game/content/jokers.gd:34
msgid "Second Look"
msgstr "Seconda occhiata"

#: game/content/jokers.gd:34
msgid "The first Refresh each round also grants +1 placement."
msgstr "La prima rimescolata di ogni round dà anche +1 mossa."

#: game/content/jokers.gd:35
msgid "+2 Mult on every clearing placement; +3 more when two or more lines clear."
msgstr "+2 Mult su ogni mossa che elimina; +3 in più quando si eliminano due o più linee."

#: game/content/jokers.gd:35
msgid "Wide Awake"
msgstr "Sveglissimo"

#: game/content/jokers.gd:36
msgid "+0.5 Mult when the board has at least 44 empty cells before placement."
msgstr "+0.5 Mult quando la plancia ha almeno 44 caselle vuote prima della mossa."

#: game/content/jokers.gd:36
msgid "Hollow Point"
msgstr "Punta cava"

#: game/content/jokers.gd:37
msgid "+0.5 Mult for every eight occupied cells before placement (max +2)."
msgstr "+0.5 Mult ogni otto caselle occupate prima della mossa (max +2)."

#: game/content/jokers.gd:37
msgid "Pressure Cooker"
msgstr "Pentola a pressione"

#: game/content/jokers.gd:38
msgid "Every third placed shape in a round gets x1.5 Mult."
msgstr "Una forma piazzata su tre in un round ottiene x1.5 Mult."

#: game/content/jokers.gd:38
msgid "Golden Ratio"
msgstr "Sezione aurea"

#: game/content/jokers.gd:39
msgid "Color Cycle"
msgstr "Ciclo di colori"

#: game/content/jokers.gd:39
msgid "When the last three placed shapes this round all have different colors, the third gains x1.75 Mult."
msgstr "Quando le ultime tre forme piazzate in questo round hanno tutte colori diversi, la terza ottiene x1.75 Mult."

#: game/content/jokers.gd:40
msgid "After the first clear each round, remove one block of your choice (use it from the Items row). The removal scores nothing."
msgstr "Dopo la prima eliminazione di ogni round, rimuovi un blocco a tua scelta (usalo dalla fila degli oggetti). La rimozione non dà punti."

#: game/content/jokers.gd:40
msgid "Patch Panel"
msgstr "Pannello toppe"

#: game/content/jokers.gd:41
msgid "+1 placement per round. The first placement of each round gains no cell Chips."
msgstr "+1 mossa per round. La prima mossa di ogni round non dà Fiches per casella."

#: game/content/jokers.gd:41
msgid "Long Game"
msgstr "Lungo termine"

#: game/content/jokers.gd:42
msgid "+0.25 Mult for each Joker sold this run (max +2). Selling this card ends its bonus."
msgstr "+0.25 Mult per ogni Jolly venduto in questa partita (max +2). Vendere questa carta ne annulla il bonus."

#: game/content/jokers.gd:42
msgid "Fire Sale"
msgstr "Svendita"

#: game/content/jokers.gd:43
msgid "Jackpot Window"
msgstr "Sportello del jackpot"

#: game/content/jokers.gd:43
msgid "x2.5 Mult when two lines clear in one placement; x5 Mult for three or more."
msgstr "x2.5 Mult quando si eliminano due linee in una mossa; x5 Mult con tre o più."

#: game/content/jokers.gd:44
msgid "Mirror Maze"
msgstr "Labirinto di specchi"

#: game/content/jokers.gd:44
msgid "The first row clear each round also clears the mirrored row's occupied cells for +50 Chips. The mirrored removal cannot chain."
msgstr "La prima riga eliminata in ogni round elimina anche le caselle occupate della riga speculare, per +50 Fiches. La rimozione speculare non si concatena."

#: game/content/jokers.gd:45
msgid "Compound Interest"
msgstr "Interesse composto"

#: game/content/jokers.gd:45
msgid "Every second clearing placement in a round gets x1.75 Mult."
msgstr "Una mossa che elimina su due in un round ottiene x1.75 Mult."

#: game/content/jokers.gd:46
msgid "Last Stand"
msgstr "Ultima resistenza"

#: game/content/jokers.gd:46
msgid "Placements made with four or fewer placements left gain x2.5 Mult."
msgstr "Le mosse fatte con quattro o meno mosse rimaste ottengono x2.5 Mult."

#: game/content/jokers.gd:48
msgid "+1 Chip for each piece in your bag."
msgstr "+1 Fiche per ogni pezzo nel tuo sacco."

#: game/content/jokers.gd:48
msgid "Hoarder"
msgstr "Accaparratore"

#: game/content/jokers.gd:49
msgid "+60 Chips when placing an L 3 or L 4 piece."
msgstr "+60 Fiches quando piazzi un pezzo L 3 o L 4."

#: game/content/jokers.gd:49
msgid "Architect"
msgstr "Architetto"

#: game/content/jokers.gd:50
msgid "+15 Chips per cell when placing a Bar piece."
