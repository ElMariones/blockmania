msgid "Locksmith"
msgstr "Slotenmaker"

#: game/content/jokers.gd:67
msgid "Countdown"
msgstr "Aftellen"

#: game/content/jokers.gd:67
msgid "x1.5 Mult on the third of three placements in a row with fewer blocks each time (like 5, 4, 3)."
msgstr "x1.5 Mult op de derde van drie zetten achter elkaar met telkens minder blokken (zoals 5, 4, 3)."

