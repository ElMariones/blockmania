#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Bronze"
msgstr "Brons"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Gold"
msgstr "Goud"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Legendary"
msgstr "Legendarisch"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Silver"
msgstr "Zilver"

#: game/content/achievements.gd:13
msgid "ARCADE & SECRETS"
msgstr "ARCADE & GEHEIMEN"

#: game/content/achievements.gd:13
msgid "LEGENDS"
msgstr "LEGENDES"

#: game/content/achievements.gd:13
msgid "THE BAG & THE SHOP"
msgstr "DE ZAK & DE WINKEL"

#: game/content/achievements.gd:13
msgid "THE CAMPAIGN"
msgstr "DE CAMPAGNE"

#: game/content/achievements.gd:13
msgid "THE SCOREBOARD"
msgstr "HET SCOREBORD"

#: game/content/achievements.gd:21
msgid "Clear your first line."
msgstr "Speel je eerste lijn weg."

#: game/content/achievements.gd:21
msgid "First Crack"
msgstr "Eerste barst"

#: game/content/achievements.gd:21
msgid "It's a start. A very satisfying start."
msgstr "Het is een begin. Een heel bevredigend begin."

#: game/content/achievements.gd:22
msgid "The target never stood a chance."
msgstr "Het doel had geen schijn van kans."

#: game/content/achievements.gd:22
msgid "Warmed Up"
msgstr "Opgewarmd"

#: game/content/achievements.gd:22
msgid "Win a round."
msgstr "Win een ronde."

#: game/content/achievements.gd:23
msgid "Boss Buster"
msgstr "Baasbreker"

#: game/content/achievements.gd:23
msgid "Defeat a boss."
msgstr "Versla een baas."

#: game/content/achievements.gd:23
msgid "They always look bigger on the poster."
msgstr "Op de poster lijken ze altijd groter."

#: game/content/achievements.gd:24
msgid "Intermission is over. Back to your seats."
msgstr "De pauze is voorbij. Terug naar je plaats."

#: game/content/achievements.gd:24
msgid "Reach Act 2 (round 5)."
msgstr "Bereik akte 2 (ronde 5)."

#: game/content/achievements.gd:24
msgid "Second Act"
msgstr "Tweede akte"

#: game/content/achievements.gd:25
msgid "Final Act"
msgstr "Laatste akte"

#: game/content/achievements.gd:25
msgid "Reach Act 3 (round 9)."
msgstr "Bereik akte 3 (ronde 9)."

#: game/content/achievements.gd:25
msgid "The curtain is starting to twitch."
msgstr "Het doek begint te trillen."

#: game/content/achievements.gd:26
msgid "Blink and you missed it."
msgstr "Even knipperen en je hebt het gemist."

#: game/content/achievements.gd:26
msgid "Speedrunner"
msgstr "Speedrunner"

#: game/content/achievements.gd:26
msgid "Win a round in five placements or fewer."
msgstr "Win een ronde in vijf zetten of minder."

#: game/content/achievements.gd:27
msgid "BLOCKMANIA!"
msgstr "BLOCKMANIA!"

#: game/content/achievements.gd:27
msgid "Beat the game: win round 12."
msgstr "Speel het spel uit: win ronde 12."

#: game/content/achievements.gd:27
msgid "Twelve rounds, three bosses, one very full board."
msgstr "Twaalf rondes, drie bazen en één heel vol bord."

#: game/content/achievements.gd:28
msgid "A good builder never blames the Kit."
msgstr "Een goede bouwer geeft nooit de kit de schuld."

#: game/content/achievements.gd:28
msgid "Beat the game with any Kit other than the Standard Kit."
msgstr "Speel het spel uit met een andere kit dan de standaardkit."

#: game/content/achievements.gd:28
msgid "Different Tools"
msgstr "Ander gereedschap"

#: game/content/achievements.gd:29 game/content/tips.gd:33
msgid "Overtime"
msgstr "Verlenging"

#: game/content/achievements.gd:29
msgid "The arcade was supposed to close an hour ago."
msgstr "De speelhal had een uur geleden al dicht moeten gaan."

#: game/content/achievements.gd:29
msgid "Win a round in Overtime (after beating the game, keep playing)."
msgstr "Win een ronde in de verlenging (speel na het uitspelen gewoon door)."

#: game/content/achievements.gd:30
msgid "Every target is a cliff now."
msgstr "Elk doel is nu een steile wand."

#: game/content/achievements.gd:30
msgid "Reach round 20 in Overtime."
msgstr "Bereik ronde 20 in de verlenging."

#: game/content/achievements.gd:30
msgid "Sudden Death"
msgstr "Sudden death"

#: game/content/achievements.gd:31
msgid "No Off Switch"
msgstr "Geen uitknop"

#: game/content/achievements.gd:31
msgid "Reach round 30 in Overtime."
msgstr "Bereik ronde 30 in de verlenging."

#: game/content/achievements.gd:31
msgid "Somebody unplug this thing."
msgstr "Kan iemand de stekker eruit trekken?"

#: game/content/achievements.gd:32
msgid "Broke the Machine"
msgstr "Machine stuk"

#: game/content/achievements.gd:32
msgid "ERR ERR ERR. Please insert more digits."
msgstr "ERR ERR ERR. Werp meer cijfers in."

#: game/content/achievements.gd:32
msgid "Score a single placement past the machine's limit (1,000,000,000,000,000 points)."
msgstr "Ga met één enkele zet over de limiet van de machine (1 000 000 000 000 000 punten)."

#: game/content/achievements.gd:32
msgid "Some scores are too big for any machine."
msgstr "Sommige scores zijn te groot voor elke machine."

#: game/content/achievements.gd:34
msgid "Blue Period"
msgstr "Blauwe periode"

#: game/content/achievements.gd:34
msgid "Feeling a little blue? Feeling VERY blue."
msgstr "Een beetje somber? Nee: HEEL blauw."

#: game/content/achievements.gd:34
msgid "Have 10 or more blue pieces in your bag."
msgstr "Heb 10 of meer blauwe stukken in je zak."

#: game/content/achievements.gd:35
msgid "Have 10 or more Square pieces (2x2 or 3x3) in your bag."
msgstr "Heb 10 of meer Vierkant-stukken (2x2 of 3x3) in je zak."

#: game/content/achievements.gd:35
msgid "Square Dance"
msgstr "Vierkantsdans"

#: game/content/achievements.gd:35
msgid "Swing your partner, stack your blocks."
msgstr "Draai je partner rond, stapel je blokken."

#: game/content/achievements.gd:36
msgid "Full Spectrum"
msgstr "Volledig spectrum"

#: game/content/achievements.gd:36
msgid "Have at least five pieces of every color in your bag."
msgstr "Heb minstens vijf stukken van elke kleur in je zak."

#: game/content/achievements.gd:36
msgid "Taste the whole toybox."
msgstr "Proef de hele speelgoedkist."

#: game/content/achievements.gd:37
msgid "Have 40 or more pieces in your bag."
msgstr "Heb 40 of meer stukken in je zak."

#: game/content/achievements.gd:37
msgid "Packrat"
msgstr "Hamsteraar"

#: game/content/achievements.gd:37
msgid "You never know when you'll need a spare T."
msgstr "Je weet nooit wanneer je een reserve-T nodig hebt."

#: game/content/achievements.gd:38
msgid "Only the essentials."
msgstr "Alleen het hoognodige."

#: game/content/achievements.gd:38
msgid "Shrink your bag to 14 pieces or fewer."
msgstr "Maak je zak kleiner tot 14 stukken of minder."

#: game/content/achievements.gd:38
msgid "Travel Light"
msgstr "Licht bepakt"

#: game/content/achievements.gd:39
msgid "Alchemist"
msgstr "Alchemist"

#: game/content/achievements.gd:39
msgid "Own pieces of all five materials at once: Chrome, Neon, Gold, Glass and Prism."
msgstr "Bezit tegelijk stukken van alle vijf materialen: chroom, neon, goud, glas en prisma."

#: game/content/achievements.gd:39
msgid "Plastic into gold, gold into glass."
msgstr "Van plastic naar goud, van goud naar glas."

#: game/content/achievements.gd:40
msgid "Own pieces with all four stamps at once: Encore, Refund, Tip and Memory."
msgstr "Bezit tegelijk stukken met alle vier stempels: Toegift, Teruggave, Fooi en Geheugen."

#: game/content/achievements.gd:40
msgid "Signed, sealed, stamped four times."
msgstr "Getekend, verzegeld en vier keer gestempeld."

#: game/content/achievements.gd:40
msgid "Special Delivery"
msgstr "Speciale levering"

#: game/content/achievements.gd:41
msgid "Fill every Joker slot."
msgstr "Vul elk Joker-vak."

#: game/content/achievements.gd:41
msgid "Full House"
msgstr "Volgeboekt"

#: game/content/achievements.gd:41
msgid "No vacancies at the Joker hotel."
msgstr "Geen kamers meer vrij in het Joker-hotel."

#: game/content/achievements.gd:42
msgid "Hold three Rare Jokers at the same time."
msgstr "Heb drie zeldzame Jokers tegelijk."

#: game/content/achievements.gd:42
msgid "Only the finest cardboard."
msgstr "Alleen het fijnste karton."

#: game/content/achievements.gd:42
msgid "Rare Taste"
msgstr "Verfijnde smaak"

#: game/content/achievements.gd:43
msgid "Master Plan"
msgstr "Meesterplan"

#: game/content/achievements.gd:43
msgid "Raise a shape family to Schematic level 3."
msgstr "Breng een vormfamilie naar bouwtekeningniveau 3."

#: game/content/achievements.gd:43
msgid "The blueprints have blueprints."
msgstr "De bouwtekeningen hebben bouwtekeningen."

#: game/content/achievements.gd:44
msgid "Hold 50 or more Credits."
msgstr "Heb 50 of meer credits."

#: game/content/achievements.gd:44
msgid "Oink."
msgstr "Knor."

#: game/content/achievements.gd:44
msgid "Piggy Bank"
msgstr "Spaarvarken"

#: game/content/achievements.gd:45
msgid "Even a wallet has a limit."
msgstr "Zelfs een portemonnee heeft een grens."

#: game/content/achievements.gd:45
msgid "Hold the maximum 99 Credits."
msgstr "Heb het maximum van 99 credits."

#: game/content/achievements.gd:45
msgid "Scrooge"
msgstr "Vrek"

#: game/content/achievements.gd:45
msgid "Swimming in coins is harder than it looks."
msgstr "Zwemmen in munten is lastiger dan het lijkt."

#: game/content/achievements.gd:47
msgid "Big Hit"
msgstr "Voltreffer"

#: game/content/achievements.gd:47
msgid "Ka-chunk."
msgstr "Ka-tsjonk."

#: game/content/achievements.gd:47
msgid "Score 1,000 points with one placement."
msgstr "Scoor 1 000 punten met één zet."

#: game/content/achievements.gd:48
msgid "Mega Hit"
msgstr "Megatreffer"

#: game/content/achievements.gd:48
msgid "Score 10,000 points with one placement."
msgstr "Scoor 10 000 punten met één zet."

#: game/content/achievements.gd:48
msgid "The receipt printer is sweating."
msgstr "De bonnetjesprinter zweet."

#: game/content/achievements.gd:49
msgid "Giga Hit"
msgstr "Gigatreffer"

#: game/content/achievements.gd:49
msgid "Score 1,000,000 points with one placement."
msgstr "Scoor 1 000 000 punten met één zet."

#: game/content/achievements.gd:49
msgid "That's a lot of zeros for one little piece."
msgstr "Dat zijn veel nullen voor zo'n klein stukje."

#: game/content/achievements.gd:50
msgid "Clear three lines with one placement."
msgstr "Speel drie lijnen weg met één zet."

#: game/content/achievements.gd:50
msgid "Stacked high and cleared clean."
msgstr "Hoog gestapeld, schoon weggespeeld."

#: game/content/achievements.gd:50
msgid "Triple Decker"
msgstr "Driedekker"

#: game/content/achievements.gd:51
msgid "Clear four or more lines with one placement."
msgstr "Speel vier of meer lijnen weg met één zet."

#: game/content/achievements.gd:51
msgid "Four-Alarm Fire"
msgstr "Groot alarm"

#: game/content/achievements.gd:51
msgid "Somebody call the block brigade."
msgstr "Bel de blokkenbrandweer!"

#: game/content/achievements.gd:52
msgid "Clear a row and a column with one placement."
msgstr "Speel een rij en een kolom weg met één zet."

#: game/content/achievements.gd:52
msgid "Crossroads"
msgstr "Kruispunt"

#: game/content/achievements.gd:52
msgid "X marks the spot."
msgstr "X markeert de plek."

#: game/content/achievements.gd:53
msgid "Don't touch the board, it's hot."
msgstr "Niet aan het bord zitten, het is heet."

#: game/content/achievements.gd:53
msgid "Reach the maximum combo (x4)."
msgstr "Bereik de maximale combo (x4)."

#: game/content/achievements.gd:53
msgid "Red Hot"
msgstr "Gloeiend heet"

#: game/content/achievements.gd:54
msgid "Finish a round with at least three times its target."
msgstr "Eindig een ronde met minstens drie keer het doel."

#: game/content/achievements.gd:54
msgid "Overkill"
msgstr "Overkill"

#: game/content/achievements.gd:54
msgid "The target asked for a little. You gave a lot."
msgstr "Het doel vroeg om een beetje. Jij gaf heel veel."

#: game/content/achievements.gd:55
msgid "By a Thread"
msgstr "Op het nippertje"

#: game/content/achievements.gd:55
msgid "Close. So close. Close enough!"
msgstr "Dichtbij. Heel dichtbij. Dichtbij genoeg!"

#: game/content/achievements.gd:55
msgid "Win a round with your very last placement."
msgstr "Win een ronde met je allerlaatste zet."

#: game/content/achievements.gd:56
msgid "Leave the board completely empty after a clear (campaign)."
msgstr "Laat het bord na het wegspelen helemaal leeg achter (campagne)."

#: game/content/achievements.gd:56
msgid "Spotless"
msgstr "Brandschoon"

#: game/content/achievements.gd:56
msgid "You could eat off this board."
msgstr "Van dit bord kun je eten."

#: game/content/achievements.gd:57
msgid "Get dealt a Grand Slam Tray Hand."
msgstr "Krijg een Grand Slam-hand in je bakje."

#: game/content/achievements.gd:57 game/rules/hands.gd:17
msgid "Grand Slam"
msgstr "Grand Slam"

#: game/content/achievements.gd:57
msgid "Three of a kind, one color, all the lights."
msgstr "Drie dezelfde, één kleur, alle lichten aan."

#: game/content/achievements.gd:58
msgid "Full Deck"
msgstr "Compleet spel"

#: game/content/achievements.gd:58
msgid "See all five Tray Hands (across any runs)."
msgstr "Zie alle vijf handen van het bakje (over alle runs)."

#: game/content/achievements.gd:58
msgid "Twins, Staircase, Monochrome, Triplets, Grand Slam. Collected."
msgstr "Tweeling, Trap, Monochroom, Drieling, Grand Slam. Verzameld."

#: game/content/achievements.gd:60
msgid "Arcade Rookie"
msgstr "Nieuweling in de speelhal"

#: game/content/achievements.gd:60
msgid "Put your initials in. Go on."
msgstr "Vul je initialen in. Kom op."

#: game/content/achievements.gd:60
msgid "Score 5,000 points in one Endless game."
msgstr "Scoor 5 000 punten in één Eindeloos-potje."

#: game/content/achievements.gd:61
msgid "Arcade Regular"
msgstr "Vaste gast in de speelhal"

#: game/content/achievements.gd:61
msgid "Score 25,000 points in one Endless game."
msgstr "Scoor 25 000 punten in één Eindeloos-potje."

#: game/content/achievements.gd:61
msgid "The cabinet knows your name."
msgstr "De kast kent je naam."

#: game/content/achievements.gd:62
msgid "Arcade Legend"
msgstr "Legende van de speelhal"

#: game/content/achievements.gd:62
msgid "Score 100,000 points in one Endless game."
msgstr "Scoor 100 000 punten in één Eindeloos-potje."

#: game/content/achievements.gd:62
msgid "They're going to name the cabinet after you."
msgstr "Ze gaan de kast naar jou vernoemen."

#: game/content/achievements.gd:63
msgid "Blockstorm"
msgstr "Blokkenstorm"

#: game/content/achievements.gd:63
msgid "Reach the x10 combo in Endless."
msgstr "Bereik de x10-combo in Eindeloos."

#: game/content/achievements.gd:63
msgid "Ten out of ten. No notes."
msgstr "Tien uit tien. Geen opmerkingen."

#: game/content/achievements.gd:64
msgid "Ahh. That new-board smell."
msgstr "Ahh. Die geur van een nieuw bord."

#: game/content/achievements.gd:64
msgid "Clear the whole board in Endless."
msgstr "Speel in Eindeloos het hele bord leeg."

#: game/content/achievements.gd:64
msgid "Fresh Start"
msgstr "Frisse start"

#: game/content/achievements.gd:65
msgid "BL...CKM...NIA? Where did everything go?"
msgstr "BL...CKM...NIA? Waar is alles gebleven?"

#: game/content/achievements.gd:65
msgid "Have every letter of the BLOCKMANIA logo blown up at once."
msgstr "Laat alle letters van het BLOCKMANIA-logo tegelijk ontploffen."

#: game/content/achievements.gd:65
msgid "The title looks awfully fragile."
msgstr "De titel ziet er vreselijk breekbaar uit."

#: game/content/achievements.gd:65
msgid "Vandal"
msgstr "Vandaal"

#: game/content/achievements.gd:66
msgid "Night Shift"
msgstr "Nachtdienst"

#: game/content/achievements.gd:66
msgid "Place a piece between midnight and 5 AM."
msgstr "Leg een stuk tussen middernacht en 5 uur 's ochtends."

#: game/content/achievements.gd:66
msgid "Some players only come out after dark."
msgstr "Sommige spelers komen pas na zonsondergang tevoorschijn."

#: game/content/achievements.gd:66
msgid "The blocks glow brighter at night. Probably."
msgstr "'S nachts gloeien de blokken feller. Waarschijnlijk."

#: game/content/achievements.gd:67
msgid "Look Ma, No Lines"
msgstr "Kijk mam, zonder lijnen"

#: game/content/achievements.gd:67
msgid "Technically, the rules never said you HAD to."
msgstr "Technisch gezien zeiden de regels nooit dat het MOEST."

#: game/content/achievements.gd:67
msgid "Who needs lines anyway?"
msgstr "Wie heeft er nou lijnen nodig?"

#: game/content/achievements.gd:67
msgid "Win a campaign round without clearing a single line."
msgstr "Win een campagneronde zonder ook maar één lijn weg te spelen."

#: game/content/achievements.gd:68
msgid "Butterfingers"
msgstr "Boterhanden"

#: game/content/achievements.gd:68
msgid "Handle with care."
msgstr "Voorzichtig, breekbaar."

#: game/content/achievements.gd:68
msgid "Shatter a Glass piece."
msgstr "Laat een glazen stuk breken."

#: game/content/achievements.gd:68
msgid "That one's coming out of your allowance."
msgstr "Die gaat van je zakgeld af."

#: game/content/achievements.gd:69
msgid "In case of emergency, break something."
msgstr "Breek in geval van nood iets kapot."

#: game/content/achievements.gd:69
msgid "Through the Window"
msgstr "Door het raam"

#: game/content/achievements.gd:69
msgid "Throw an Emergency Brick."
msgstr "Gooi een noodbaksteen."

#: game/content/achievements.gd:69
msgid "Who's paying for that?"
msgstr "Wie gaat dat betalen?"

#: game/content/achievements.gd:70
msgid "Always read the small text."
msgstr "Lees altijd de kleine lettertjes."

#: game/content/achievements.gd:70
msgid "Get a lost round replayed by Insurance Policy."
msgstr "Laat de Verzekeringspolis een verloren ronde opnieuw spelen."

#: game/content/achievements.gd:70
msgid "Terms and conditions apply. Luckily, they applied to you."
msgstr "Er gelden voorwaarden. Gelukkig golden ze voor jou."

#: game/content/achievements.gd:70
msgid "The Fine Print"
msgstr "De kleine lettertjes"

#: game/content/achievements.gd:71
msgid "Block Maniac"
msgstr "Blokmaniak"

#: game/content/achievements.gd:71
msgid "The whole trophy case. Every last shelf. Take a bow."
msgstr "De hele vitrine. Tot het laatste plankje. Maak een buiging."

#: game/content/achievements.gd:71
msgid "Unlock every other achievement."
msgstr "Ontgrendel alle andere prestaties."

#: game/content/achievements.gd:73
msgid "It hums a little when you hold it."
msgstr "Hij zoemt een beetje als je hem vasthoudt."

#: game/content/achievements.gd:73
msgid "Once Upon a Legend"
msgstr "Er was eens een legende"

#: game/content/achievements.gd:73
msgid "Own a Legendary Joker."
msgstr "Bezit een legendarische Joker."

#: game/content/achievements.gd:74
msgid "Double Legend"
msgstr "Dubbele legende"

#: game/content/achievements.gd:74
msgid "One legend is a story. Two is a problem."
msgstr "Eén legende is een verhaal. Twee is een probleem."

#: game/content/achievements.gd:74
msgid "Own two Legendary Jokers at the same time."
msgstr "Bezit twee legendarische Jokers tegelijk."

#: game/content/achievements.gd:74
msgid "The rack has never looked so smug."
msgstr "Het rek heeft er nog nooit zo zelfvoldaan uitgezien."

#: game/content/achievements.gd:75
msgid "Own each of the four Legendary Jokers (across any runs)."
msgstr "Bezit elk van de vier legendarische Jokers (over alle runs)."

#: game/content/achievements.gd:75
msgid "Pantheon"
msgstr "Pantheon"

#: game/content/achievements.gd:75
msgid "The Avalanche, the Mirrors, the Stone and the Star. All accounted for."
msgstr "De Lawine, de Spiegels, de Steen en de Ster. Allemaal binnen."

#: game/content/achievements.gd:76
msgid "Chain Reaction"
msgstr "Kettingreactie"

#: game/content/achievements.gd:76
msgid "Chain three clear waves in one placement with The Avalanche."
msgstr "Rijg met De Lawine drie wegspeelgolven aan elkaar in één zet."

#: game/content/achievements.gd:76
msgid "Nobody touch anything. Let it fall."
msgstr "Niemand iets aanraken. Laat het vallen."

#: game/content/achievements.gd:77
msgid "How many of you are in there?"
msgstr "Hoeveel van jou zitten daar?"

#: game/content/achievements.gd:77
msgid "Mirror World"
msgstr "Spiegelwereld"

#: game/content/achievements.gd:77
msgid "Score a placement where Hall of Mirrors doubles four other Jokers."
msgstr "Scoor een zet waarbij de Spiegelzaal vier andere Jokers verdubbelt."

#: game/content/achievements.gd:78
msgid "Chrome, neon, gold and glass. Very little plastic left."
msgstr "Chroom, neon, goud en glas. Er is bijna geen plastic meer over."

#: game/content/achievements.gd:78
msgid "Have 15 or more pieces with a material in your bag."
msgstr "Heb 15 of meer stukken met een materiaal in je zak."

#: game/content/achievements.gd:78
msgid "Heavy Metal"
msgstr "Heavy metal"

#: game/content/achievements.gd:79
msgid "Eighteen lines and one very bright star."
msgstr "Achttien lijnen en één heel felle ster."

#: game/content/achievements.gd:79
msgid "Going Nova"
msgstr "Op weg naar nova"

#: game/content/achievements.gd:79
msgid "Score with Supernova at x10 Mult or more."
msgstr "Scoor met Supernova op x10 Mult of meer."

#: game/content/achievements.gd:80
msgid "Grow Snowball to x2 Mult or more."
msgstr "Laat Sneeuwbal groeien tot x2 Mult of meer."

#: game/content/achievements.gd:80
msgid "It started as a pebble of snow."
msgstr "Het begon als een vlokje sneeuw."

#: game/content/achievements.gd:80
msgid "Snowed In"
msgstr "Ingesneeuwd"

#: game/content/achievements.gd:81
msgid "Compound Growth"
msgstr "Samengestelde groei"

#: game/content/achievements.gd:81
msgid "Earn the maximum interest (+5 Credits) after a round."
msgstr "Verdien na een ronde de maximale rente (+5 credits)."

#: game/content/achievements.gd:81
msgid "Your Credits have been working harder than you."
msgstr "Je credits hebben harder gewerkt dan jij."

#: game/content/achievements.gd:82
msgid "Have seven Joker slots."
msgstr "Heb zeven Joker-vakken."

#: game/content/achievements.gd:82
msgid "Two Rack Extenders and a lot of shelf brackets."
msgstr "Twee rekverlengers en een hoop plankdragers."

#: game/content/achievements.gd:82
msgid "Wide Rack"
msgstr "Breed rek"

#: game/content/achievements.gd:83
msgid "Billionaire"
msgstr "Miljardair"

#: game/content/achievements.gd:83
msgid "Nine zeros. The counter had to borrow some."
msgstr "Negen nullen. De teller moest er een paar lenen."

