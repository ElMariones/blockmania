#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Bronze"
msgstr "Bronze"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Gold"
msgstr "Or"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Legendary"
msgstr "Légendaire"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Silver"
msgstr "Argent"

#: game/content/achievements.gd:13
msgid "ARCADE & SECRETS"
msgstr "ARCADE ET SECRETS"

#: game/content/achievements.gd:13
msgid "LEGENDS"
msgstr "LÉGENDES"

#: game/content/achievements.gd:13
msgid "THE BAG & THE SHOP"
msgstr "LE SAC ET LA BOUTIQUE"

#: game/content/achievements.gd:13
msgid "THE CAMPAIGN"
msgstr "LA CAMPAGNE"

#: game/content/achievements.gd:13
msgid "THE SCOREBOARD"
msgstr "LE TABLEAU DES SCORES"

#: game/content/achievements.gd:21
msgid "Clear your first line."
msgstr "Effacez votre première ligne."

#: game/content/achievements.gd:21
msgid "First Crack"
msgstr "Première fissure"

#: game/content/achievements.gd:21
msgid "It's a start. A very satisfying start."
msgstr "C'est un début. Un début très satisfaisant."

#: game/content/achievements.gd:22
msgid "The target never stood a chance."
msgstr "L'objectif n'avait aucune chance."

#: game/content/achievements.gd:22
msgid "Warmed Up"
msgstr "Échauffé"

#: game/content/achievements.gd:22
msgid "Win a round."
msgstr "Gagnez une manche."

#: game/content/achievements.gd:23
msgid "Boss Buster"
msgstr "Chasseur de boss"

#: game/content/achievements.gd:23
msgid "Defeat a boss."
msgstr "Battez un boss."

#: game/content/achievements.gd:23
msgid "They always look bigger on the poster."
msgstr "Sur l'affiche, ils ont toujours l'air plus grands."

#: game/content/achievements.gd:24
msgid "Intermission is over. Back to your seats."
msgstr "L'entracte est terminé. Regagnez vos places."

#: game/content/achievements.gd:24
msgid "Reach Act 2 (round 5)."
msgstr "Atteignez l'acte 2 (manche 5)."

#: game/content/achievements.gd:24
msgid "Second Act"
msgstr "Deuxième acte"

#: game/content/achievements.gd:25
msgid "Final Act"
msgstr "Acte final"

#: game/content/achievements.gd:25
msgid "Reach Act 3 (round 9)."
msgstr "Atteignez l'acte 3 (manche 9)."

#: game/content/achievements.gd:25
msgid "The curtain is starting to twitch."
msgstr "Le rideau commence à frémir."

#: game/content/achievements.gd:26
msgid "Blink and you missed it."
msgstr "Un clignement d'yeux, et c'était fini."

#: game/content/achievements.gd:26
msgid "Speedrunner"
msgstr "Speedrunner"

#: game/content/achievements.gd:26
msgid "Win a round in five placements or fewer."
msgstr "Gagnez une manche en cinq poses ou moins."

#: game/content/achievements.gd:27
msgid "BLOCKMANIA!"
msgstr "BLOCKMANIA !"

#: game/content/achievements.gd:27
msgid "Beat the game: win round 12."
msgstr "Terminez le jeu : gagnez la manche 12."

#: game/content/achievements.gd:27
msgid "Twelve rounds, three bosses, one very full board."
msgstr "Douze manches, trois boss et un plateau bien rempli."

#: game/content/achievements.gd:28
msgid "A good builder never blames the Kit."
msgstr "Un bon bâtisseur n'accuse jamais son kit."

#: game/content/achievements.gd:28
msgid "Beat the game with any Kit other than the Standard Kit."
msgstr "Terminez le jeu avec un autre kit que le kit standard."

#: game/content/achievements.gd:28
msgid "Different Tools"
msgstr "D'autres outils"

#: game/content/achievements.gd:29 game/content/tips.gd:33
msgid "Overtime"
msgstr "Prolongations"

#: game/content/achievements.gd:29
msgid "The arcade was supposed to close an hour ago."
msgstr "La salle d'arcade aurait dû fermer il y a une heure."

#: game/content/achievements.gd:29
msgid "Win a round in Overtime (after beating the game, keep playing)."
msgstr "Gagnez une manche en prolongations (après avoir terminé le jeu, continuez à jouer)."

#: game/content/achievements.gd:30
msgid "Every target is a cliff now."
msgstr "Chaque objectif est désormais une falaise."

#: game/content/achievements.gd:30
msgid "Reach round 20 in Overtime."
msgstr "Atteignez la manche 20 en prolongations."

#: game/content/achievements.gd:30
msgid "Sudden Death"
msgstr "Mort subite"

#: game/content/achievements.gd:31
msgid "No Off Switch"
msgstr "Pas d'interrupteur"

#: game/content/achievements.gd:31
msgid "Reach round 30 in Overtime."
msgstr "Atteignez la manche 30 en prolongations."

#: game/content/achievements.gd:31
msgid "Somebody unplug this thing."
msgstr "Que quelqu'un débranche cette machine."

#: game/content/achievements.gd:32
msgid "Broke the Machine"
msgstr "Machine cassée"

#: game/content/achievements.gd:32
msgid "ERR ERR ERR. Please insert more digits."
msgstr "ERR ERR ERR. Veuillez insérer plus de chiffres."

#: game/content/achievements.gd:32
msgid "Score a single placement past the machine's limit (1,000,000,000,000,000 points)."
msgstr "Dépassez la limite de la machine en une seule pose (1 000 000 000 000 000 points)."

#: game/content/achievements.gd:32
msgid "Some scores are too big for any machine."
msgstr "Certains scores sont trop grands pour n'importe quelle machine."

#: game/content/achievements.gd:34
msgid "Blue Period"
msgstr "Période bleue"

#: game/content/achievements.gd:34
msgid "Feeling a little blue? Feeling VERY blue."
msgstr "Un coup de blues ? Non : un coup de BLEU."

#: game/content/achievements.gd:34
msgid "Have 10 or more blue pieces in your bag."
msgstr "Ayez au moins 10 pièces bleues dans votre sac."

#: game/content/achievements.gd:35
msgid "Have 10 or more Square pieces (2x2 or 3x3) in your bag."
msgstr "Ayez au moins 10 pièces Carré (2x2 ou 3x3) dans votre sac."

#: game/content/achievements.gd:35
msgid "Square Dance"
msgstr "Quadrille"

#: game/content/achievements.gd:35
msgid "Swing your partner, stack your blocks."
msgstr "Faites tourner votre cavalière, empilez vos blocs."

#: game/content/achievements.gd:36
msgid "Full Spectrum"
msgstr "Spectre complet"

#: game/content/achievements.gd:36
msgid "Have at least five pieces of every color in your bag."
msgstr "Ayez au moins cinq pièces de chaque couleur dans votre sac."

#: game/content/achievements.gd:36
msgid "Taste the whole toybox."
msgstr "Goûtez à tout le coffre à jouets."

#: game/content/achievements.gd:37
msgid "Have 40 or more pieces in your bag."
msgstr "Ayez au moins 40 pièces dans votre sac."

#: game/content/achievements.gd:37
msgid "Packrat"
msgstr "Écureuil"

#: game/content/achievements.gd:37
msgid "You never know when you'll need a spare T."
msgstr "On ne sait jamais quand on aura besoin d'un T de rechange."

#: game/content/achievements.gd:38
msgid "Only the essentials."
msgstr "Rien que l'essentiel."

#: game/content/achievements.gd:38
msgid "Shrink your bag to 14 pieces or fewer."
msgstr "Réduisez votre sac à 14 pièces ou moins."

#: game/content/achievements.gd:38
msgid "Travel Light"
msgstr "Voyager léger"

#: game/content/achievements.gd:39
msgid "Alchemist"
msgstr "Alchimiste"

#: game/content/achievements.gd:39
msgid "Own pieces of all five materials at once: Chrome, Neon, Gold, Glass and Prism."
msgstr "Possédez en même temps des pièces des cinq matériaux : chrome, néon, or, verre et prisme."

#: game/content/achievements.gd:39
msgid "Plastic into gold, gold into glass."
msgstr "Le plastique en or, l'or en verre."

#: game/content/achievements.gd:40
msgid "Own pieces with all four stamps at once: Encore, Refund, Tip and Memory."
msgstr "Possédez en même temps des pièces portant les quatre tampons : Rappel, Ristourne, Pourboire et Mémoire."

#: game/content/achievements.gd:40
msgid "Signed, sealed, stamped four times."
msgstr "Signé, scellé, tamponné quatre fois."

#: game/content/achievements.gd:40
msgid "Special Delivery"
msgstr "Livraison spéciale"

#: game/content/achievements.gd:41
msgid "Fill every Joker slot."
msgstr "Remplissez tous les emplacements de Joker."

#: game/content/achievements.gd:41
msgid "Full House"
msgstr "Complet"

#: game/content/achievements.gd:41
msgid "No vacancies at the Joker hotel."
msgstr "Plus une chambre de libre à l'hôtel des Jokers."

#: game/content/achievements.gd:42
msgid "Hold three Rare Jokers at the same time."
msgstr "Possédez trois Jokers rares en même temps."

#: game/content/achievements.gd:42
msgid "Only the finest cardboard."
msgstr "Rien que le carton le plus fin."

#: game/content/achievements.gd:42
msgid "Rare Taste"
msgstr "Goût du rare"

#: game/content/achievements.gd:43
msgid "Master Plan"
msgstr "Plan de maître"

#: game/content/achievements.gd:43
msgid "Raise a shape family to Schematic level 3."
msgstr "Faites monter une famille de formes au niveau de plan 3."

#: game/content/achievements.gd:43
msgid "The blueprints have blueprints."
msgstr "Les plans ont des plans."

#: game/content/achievements.gd:44
msgid "Hold 50 or more Credits."
msgstr "Possédez au moins 50 crédits."

#: game/content/achievements.gd:44
msgid "Oink."
msgstr "Groin."

#: game/content/achievements.gd:44
msgid "Piggy Bank"
msgstr "Tirelire"

#: game/content/achievements.gd:45
msgid "Even a wallet has a limit."
msgstr "Même un portefeuille a ses limites."

#: game/content/achievements.gd:45
msgid "Hold the maximum 99 Credits."
msgstr "Possédez le maximum de 99 crédits."

#: game/content/achievements.gd:45
msgid "Scrooge"
msgstr "Grippe-sou"

#: game/content/achievements.gd:45
msgid "Swimming in coins is harder than it looks."
msgstr "Nager dans les pièces, c'est plus dur qu'il n'y paraît."

#: game/content/achievements.gd:47
msgid "Big Hit"
msgstr "Gros coup"

#: game/content/achievements.gd:47
msgid "Ka-chunk."
msgstr "Ka-tchak."

#: game/content/achievements.gd:47
msgid "Score 1,000 points with one placement."
msgstr "Marquez 1 000 points en une pose."

#: game/content/achievements.gd:48
msgid "Mega Hit"
msgstr "Méga coup"

#: game/content/achievements.gd:48
msgid "Score 10,000 points with one placement."
msgstr "Marquez 10 000 points en une pose."

#: game/content/achievements.gd:48
msgid "The receipt printer is sweating."
msgstr "L'imprimante à tickets transpire."

#: game/content/achievements.gd:49
msgid "Giga Hit"
msgstr "Giga coup"

#: game/content/achievements.gd:49
msgid "Score 1,000,000 points with one placement."
msgstr "Marquez 1 000 000 de points en une pose."

#: game/content/achievements.gd:49
msgid "That's a lot of zeros for one little piece."
msgstr "Ça fait beaucoup de zéros pour une si petite pièce."

#: game/content/achievements.gd:50
msgid "Clear three lines with one placement."
msgstr "Effacez trois lignes en une pose."

#: game/content/achievements.gd:50
msgid "Stacked high and cleared clean."
msgstr "Bien empilé, bien nettoyé."

#: game/content/achievements.gd:50
msgid "Triple Decker"
msgstr "Triple étage"

#: game/content/achievements.gd:51
msgid "Clear four or more lines with one placement."
msgstr "Effacez quatre lignes ou plus en une pose."

#: game/content/achievements.gd:51
msgid "Four-Alarm Fire"
msgstr "Alerte rouge"

#: game/content/achievements.gd:51
msgid "Somebody call the block brigade."
msgstr "Appelez les pompiers des blocs."

#: game/content/achievements.gd:52
msgid "Clear a row and a column with one placement."
msgstr "Effacez une rangée et une colonne en une pose."

#: game/content/achievements.gd:52
msgid "Crossroads"
msgstr "Carrefour"

#: game/content/achievements.gd:52
msgid "X marks the spot."
msgstr "X marque l'endroit."

#: game/content/achievements.gd:53
msgid "Don't touch the board, it's hot."
msgstr "Ne touchez pas le plateau, il est brûlant."

#: game/content/achievements.gd:53
msgid "Reach the maximum combo (x4)."
msgstr "Atteignez le combo maximum (x4)."

#: game/content/achievements.gd:53
msgid "Red Hot"
msgstr "Chauffé à blanc"

#: game/content/achievements.gd:54
msgid "Finish a round with at least three times its target."
msgstr "Terminez une manche avec au moins trois fois son objectif."

#: game/content/achievements.gd:54
msgid "Overkill"
msgstr "Démesure"

#: game/content/achievements.gd:54
msgid "The target asked for a little. You gave a lot."
msgstr "L'objectif demandait un peu. Vous avez donné beaucoup."

#: game/content/achievements.gd:55
msgid "By a Thread"
msgstr "Sur le fil"

#: game/content/achievements.gd:55
msgid "Close. So close. Close enough!"
msgstr "Près. Tout près. Assez près !"

#: game/content/achievements.gd:55
msgid "Win a round with your very last placement."
msgstr "Gagnez une manche avec votre toute dernière pose."

#: game/content/achievements.gd:56
msgid "Leave the board completely empty after a clear (campaign)."
msgstr "Laissez le plateau entièrement vide après un effacement (campagne)."

#: game/content/achievements.gd:56
msgid "Spotless"
msgstr "Impeccable"

#: game/content/achievements.gd:56
msgid "You could eat off this board."
msgstr "On pourrait manger sur ce plateau."

#: game/content/achievements.gd:57
msgid "Get dealt a Grand Slam Tray Hand."
msgstr "Recevez une main Grand Chelem sur le chevalet."

#: game/content/achievements.gd:57 game/rules/hands.gd:17
msgid "Grand Slam"
msgstr "Grand Chelem"

#: game/content/achievements.gd:57
msgid "Three of a kind, one color, all the lights."
msgstr "Trois pareilles, une couleur, toutes les lumières."

#: game/content/achievements.gd:58
msgid "Full Deck"
msgstr "Jeu complet"

#: game/content/achievements.gd:58
msgid "See all five Tray Hands (across any runs)."
msgstr "Obtenez les cinq mains du chevalet (toutes parties confondues)."

#: game/content/achievements.gd:58
msgid "Twins, Staircase, Monochrome, Triplets, Grand Slam. Collected."
msgstr "Jumelles, Escalier, Monochrome, Triplés, Grand Chelem. Collection complète."

#: game/content/achievements.gd:60
msgid "Arcade Rookie"
msgstr "Recrue de l'arcade"

#: game/content/achievements.gd:60
msgid "Put your initials in. Go on."
msgstr "Entrez vos initiales. Allez-y."

#: game/content/achievements.gd:60
msgid "Score 5,000 points in one Endless game."
msgstr "Marquez 5 000 points dans une partie Infinie."

#: game/content/achievements.gd:61
msgid "Arcade Regular"
msgstr "Habitué de l'arcade"

#: game/content/achievements.gd:61
msgid "Score 25,000 points in one Endless game."
msgstr "Marquez 25 000 points dans une partie Infinie."

#: game/content/achievements.gd:61
msgid "The cabinet knows your name."
msgstr "La borne connaît votre nom."

#: game/content/achievements.gd:62
msgid "Arcade Legend"
msgstr "Légende de l'arcade"

#: game/content/achievements.gd:62
msgid "Score 100,000 points in one Endless game."
msgstr "Marquez 100 000 points dans une partie Infinie."

#: game/content/achievements.gd:62
msgid "They're going to name the cabinet after you."
msgstr "On va donner votre nom à la borne."

#: game/content/achievements.gd:63
msgid "Blockstorm"
msgstr "Tempête de blocs"

#: game/content/achievements.gd:63
msgid "Reach the x10 combo in Endless."
msgstr "Atteignez le combo x10 en mode Infini."

#: game/content/achievements.gd:63
msgid "Ten out of ten. No notes."
msgstr "Dix sur dix. Rien à redire."

#: game/content/achievements.gd:64
msgid "Ahh. That new-board smell."
msgstr "Ahh. Cette odeur de plateau neuf."

#: game/content/achievements.gd:64
msgid "Clear the whole board in Endless."
msgstr "Videz entièrement le plateau en mode Infini."

#: game/content/achievements.gd:64
msgid "Fresh Start"
msgstr "Table rase"

#: game/content/achievements.gd:65
msgid "BL...CKM...NIA? Where did everything go?"
msgstr "BL...CKM...NIA ? Où est passé tout le monde ?"

#: game/content/achievements.gd:65
msgid "Have every letter of the BLOCKMANIA logo blown up at once."
msgstr "Faites exploser en même temps toutes les lettres du logo BLOCKMANIA."

#: game/content/achievements.gd:65
msgid "The title looks awfully fragile."
msgstr "Le titre a l'air terriblement fragile."

#: game/content/achievements.gd:65
msgid "Vandal"
msgstr "Vandale"

#: game/content/achievements.gd:66
msgid "Night Shift"
msgstr "Équipe de nuit"

#: game/content/achievements.gd:66
msgid "Place a piece between midnight and 5 AM."
msgstr "Posez une pièce entre minuit et 5 h du matin."

#: game/content/achievements.gd:66
msgid "Some players only come out after dark."
msgstr "Certains joueurs ne sortent qu'à la nuit tombée."

#: game/content/achievements.gd:66
msgid "The blocks glow brighter at night. Probably."
msgstr "Les blocs brillent plus fort la nuit. Probablement."

#: game/content/achievements.gd:67
msgid "Look Ma, No Lines"
msgstr "Regarde, maman, sans lignes"

#: game/content/achievements.gd:67
msgid "Technically, the rules never said you HAD to."
msgstr "Techniquement, les règles n'ont jamais dit qu'il FALLAIT le faire."

#: game/content/achievements.gd:67
msgid "Who needs lines anyway?"
msgstr "Qui a besoin de lignes, de toute façon ?"

#: game/content/achievements.gd:67
msgid "Win a campaign round without clearing a single line."
msgstr "Gagnez une manche de campagne sans effacer une seule ligne."

#: game/content/achievements.gd:68
msgid "Butterfingers"
msgstr "Mains de beurre"

#: game/content/achievements.gd:68
msgid "Handle with care."
msgstr "Fragile, manipuler avec soin."

#: game/content/achievements.gd:68
msgid "Shatter a Glass piece."
msgstr "Brisez une pièce de verre."

#: game/content/achievements.gd:68
msgid "That one's coming out of your allowance."
msgstr "Celle-là, on la retient sur votre argent de poche."

#: game/content/achievements.gd:69
msgid "In case of emergency, break something."
msgstr "En cas d'urgence, cassez quelque chose."

#: game/content/achievements.gd:69
msgid "Through the Window"
msgstr "Par la fenêtre"

#: game/content/achievements.gd:69
msgid "Throw an Emergency Brick."
msgstr "Lancez une brique de secours."

#: game/content/achievements.gd:69
msgid "Who's paying for that?"
msgstr "Qui va payer ça ?"

#: game/content/achievements.gd:70
msgid "Always read the small text."
msgstr "Lisez toujours les petits caractères."

#: game/content/achievements.gd:70
msgid "Get a lost round replayed by Insurance Policy."
msgstr "Faites rejouer une manche perdue grâce à la Police d'assurance."

#: game/content/achievements.gd:70
msgid "Terms and conditions apply. Luckily, they applied to you."
msgstr "Voir conditions générales. Heureusement, elles s'appliquaient à vous."

#: game/content/achievements.gd:70
msgid "The Fine Print"
msgstr "Les petits caractères"

#: game/content/achievements.gd:71
msgid "Block Maniac"
msgstr "Blockmaniaque"

#: game/content/achievements.gd:71
msgid "The whole trophy case. Every last shelf. Take a bow."
msgstr "Toute la vitrine. Jusqu'à la dernière étagère. Saluez."

#: game/content/achievements.gd:71
msgid "Unlock every other achievement."
msgstr "Débloquez tous les autres succès."

#: game/content/achievements.gd:73
msgid "It hums a little when you hold it."
msgstr "Il bourdonne un peu quand on le tient."

#: game/content/achievements.gd:73
msgid "Once Upon a Legend"
msgstr "Il était une légende"

#: game/content/achievements.gd:73
msgid "Own a Legendary Joker."
msgstr "Possédez un Joker légendaire."

#: game/content/achievements.gd:74
msgid "Double Legend"
msgstr "Double légende"

#: game/content/achievements.gd:74
msgid "One legend is a story. Two is a problem."
msgstr "Une légende, c'est une histoire. Deux, c'est un problème."

#: game/content/achievements.gd:74
msgid "Own two Legendary Jokers at the same time."
msgstr "Possédez deux Jokers légendaires en même temps."

#: game/content/achievements.gd:74
msgid "The rack has never looked so smug."
msgstr "Le présentoir n'a jamais eu l'air aussi fier."

#: game/content/achievements.gd:75
msgid "Own each of the four Legendary Jokers (across any runs)."
msgstr "Possédez chacun des quatre Jokers légendaires (toutes parties confondues)."

#: game/content/achievements.gd:75
msgid "Pantheon"
msgstr "Panthéon"

#: game/content/achievements.gd:75
msgid "The Avalanche, the Mirrors, the Stone and the Star. All accounted for."
msgstr "L'Avalanche, les Glaces, la Pierre et l'Étoile. Tous présents."

#: game/content/achievements.gd:76
msgid "Chain Reaction"
msgstr "Réaction en chaîne"

#: game/content/achievements.gd:76
msgid "Chain three clear waves in one placement with The Avalanche."
msgstr "Enchaînez trois vagues d'effacement en une pose avec L'Avalanche."

#: game/content/achievements.gd:76
msgid "Nobody touch anything. Let it fall."
msgstr "Personne ne touche à rien. Laissez tomber."

#: game/content/achievements.gd:77
msgid "How many of you are in there?"
msgstr "Combien êtes-vous là-dedans ?"

#: game/content/achievements.gd:77
msgid "Mirror World"
msgstr "Monde miroir"

#: game/content/achievements.gd:77
msgid "Score a placement where Hall of Mirrors doubles four other Jokers."
msgstr "Marquez une pose où la Galerie des glaces double quatre autres Jokers."

#: game/content/achievements.gd:78
msgid "Chrome, neon, gold and glass. Very little plastic left."
msgstr "Chrome, néon, or et verre. Il ne reste presque plus de plastique."

#: game/content/achievements.gd:78
msgid "Have 15 or more pieces with a material in your bag."
msgstr "Ayez au moins 15 pièces avec un matériau dans votre sac."

#: game/content/achievements.gd:78
msgid "Heavy Metal"
msgstr "Heavy metal"

#: game/content/achievements.gd:79
msgid "Eighteen lines and one very bright star."
msgstr "Dix-huit lignes et une étoile très brillante."

#: game/content/achievements.gd:79
msgid "Going Nova"
msgstr "Vers la nova"

#: game/content/achievements.gd:79
msgid "Score with Supernova at x10 Mult or more."
msgstr "Marquez avec Supernova à x10 Mult ou plus."

#: game/content/achievements.gd:80
msgid "Grow Snowball to x2 Mult or more."
msgstr "Faites grandir Boule de neige jusqu'à x2 Mult ou plus."

#: game/content/achievements.gd:80
msgid "It started as a pebble of snow."
msgstr "Au début, ce n'était qu'un flocon."

#: game/content/achievements.gd:80
msgid "Snowed In"
msgstr "Enneigé"

#: game/content/achievements.gd:81
msgid "Compound Growth"
msgstr "Croissance composée"

#: game/content/achievements.gd:81
msgid "Earn the maximum interest (+5 Credits) after a round."
msgstr "Touchez l'intérêt maximum (+5 crédits) après une manche."

#: game/content/achievements.gd:81
msgid "Your Credits have been working harder than you."
msgstr "Vos crédits ont travaillé plus dur que vous."

#: game/content/achievements.gd:82
msgid "Have seven Joker slots."
msgstr "Ayez sept emplacements de Joker."

#: game/content/achievements.gd:82
msgid "Two Rack Extenders and a lot of shelf brackets."
msgstr "Deux extensions de présentoir et beaucoup d'équerres."

#: game/content/achievements.gd:82
msgid "Wide Rack"
msgstr "Grand présentoir"

#: game/content/achievements.gd:83
msgid "Billionaire"
msgstr "Milliardaire"

#: game/content/achievements.gd:83
msgid "Nine zeros. The counter had to borrow some."
msgstr "Neuf zéros. Le compteur a dû en emprunter."

#: game/content/achievements.gd:83
