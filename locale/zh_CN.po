#: game/content/round_cards.gd:10
msgid "Gold Rush"
msgstr "淘金热"

#: game/content/round_cards.gd:11
msgid "Six Gold blocks start on the board (+1 Credit per Gold cell cleared). +2 Credits if you win."
msgstr "开局时棋盘上有六个黄金方块(每消除一个黄金格子+1代币)。获胜+2代币。"

#: game/content/round_cards.gd:12
msgid "Tight Budget"
msgstr "预算紧张"

#: game/content/round_cards.gd:13
msgid "Three fewer placements. +4 Credits if you win."
msgstr "放置次数减少三次。获胜+4代币。"

#: game/content/round_cards.gd:14
msgid "Rush Hour"
msgstr "高峰时段"

#: game/content/round_cards.gd:15
msgid "Target x0.8, but no Refresh this round."
msgstr "目标x0.8,但本回合不能刷新。"

#: game/content/round_cards.gd:16
msgid "Double or Nothing"
msgstr "加倍或归零"

#: game/content/round_cards.gd:17
msgid "Target x1.4. +6 Credits if you win."
msgstr "目标x1.4。获胜+6代币。"

