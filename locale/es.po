#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Bronze"
msgstr "Bronce"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Gold"
msgstr "Oro"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Legendary"
msgstr "Legendario"

#: game/content/achievements.gd:12
msgctxt "tier"
msgid "Silver"
msgstr "Plata"

#: game/content/achievements.gd:13
msgid "ARCADE & SECRETS"
msgstr "ARCADE Y SECRETOS"

#: game/content/achievements.gd:13
msgid "LEGENDS"
msgstr "LEYENDAS"

#: game/content/achievements.gd:13
msgid "THE BAG & THE SHOP"
msgstr "LA BOLSA Y LA TIENDA"

#: game/content/achievements.gd:13
msgid "THE CAMPAIGN"
msgstr "LA CAMPAÑA"

#: game/content/achievements.gd:13
msgid "THE SCOREBOARD"
msgstr "EL MARCADOR"

#: game/content/achievements.gd:21
msgid "Clear your first line."
msgstr "Limpia tu primera línea."

#: game/content/achievements.gd:21
msgid "First Crack"
msgstr "Primera grieta"

#: game/content/achievements.gd:21
msgid "It's a start. A very satisfying start."
msgstr "Es un comienzo. Un comienzo muy satisfactorio."

#: game/content/achievements.gd:22
msgid "The target never stood a chance."
msgstr "El objetivo no tuvo ninguna oportunidad."

#: game/content/achievements.gd:22
msgid "Warmed Up"
msgstr "Entrando en calor"

#: game/content/achievements.gd:22
msgid "Win a round."
msgstr "Gana una ronda."

#: game/content/achievements.gd:23
msgid "Boss Buster"
msgstr "Revientajefes"

#: game/content/achievements.gd:23
msgid "Defeat a boss."
msgstr "Derrota a un jefe."

#: game/content/achievements.gd:23
msgid "They always look bigger on the poster."
msgstr "En el cartel siempre parecen más grandes."

#: game/content/achievements.gd:24
msgid "Intermission is over. Back to your seats."
msgstr "Se acabó el intermedio. Vuelvan a sus asientos."

#: game/content/achievements.gd:24
msgid "Reach Act 2 (round 5)."
msgstr "Llega al acto 2 (ronda 5)."

#: game/content/achievements.gd:24
msgid "Second Act"
msgstr "Segundo acto"

#: game/content/achievements.gd:25
msgid "Final Act"
msgstr "Acto final"

#: game/content/achievements.gd:25
msgid "Reach Act 3 (round 9)."
msgstr "Llega al acto 3 (ronda 9)."

#: game/content/achievements.gd:25
msgid "The curtain is starting to twitch."
msgstr "El telón empieza a temblar."

#: game/content/achievements.gd:26
msgid "Blink and you missed it."
msgstr "Si parpadeas, te lo pierdes."

#: game/content/achievements.gd:26
msgid "Speedrunner"
msgstr "Speedrunner"

#: game/content/achievements.gd:26
msgid "Win a round in five placements or fewer."
msgstr "Gana una ronda en cinco colocaciones o menos."

#: game/content/achievements.gd:27
msgid "BLOCKMANIA!"
msgstr "¡BLOCKMANIA!"

#: game/content/achievements.gd:27
msgid "Beat the game: win round 12."
msgstr "Pásate el juego: gana la ronda 12."

#: game/content/achievements.gd:27
msgid "Twelve rounds, three bosses, one very full board."
msgstr "Doce rondas, tres jefes y un tablero a rebosar."

#: game/content/achievements.gd:28
msgid "A good builder never blames the Kit."
msgstr "Un buen constructor nunca culpa al kit."

#: game/content/achievements.gd:28
msgid "Beat the game with any Kit other than the Standard Kit."
msgstr "Pásate el juego con cualquier kit que no sea el Kit estándar."

#: game/content/achievements.gd:28
msgid "Different Tools"
msgstr "Otras herramientas"

#: game/content/achievements.gd:29 game/content/tips.gd:33
msgid "Overtime"
msgstr "Prórroga"

#: game/content/achievements.gd:29
msgid "The arcade was supposed to close an hour ago."
msgstr "El salón recreativo tenía que haber cerrado hace una hora."

#: game/content/achievements.gd:29
msgid "Win a round in Overtime (after beating the game, keep playing)."
msgstr "Gana una ronda en la prórroga (tras pasarte el juego, sigue jugando)."

#: game/content/achievements.gd:30
msgid "Every target is a cliff now."
msgstr "Ahora cada objetivo es un precipicio."

#: game/content/achievements.gd:30
msgid "Reach round 20 in Overtime."
msgstr "Llega a la ronda 20 en la prórroga."

#: game/content/achievements.gd:30
msgid "Sudden Death"
msgstr "Muerte súbita"

#: game/content/achievements.gd:31
msgid "No Off Switch"
msgstr "Sin botón de apagado"

#: game/content/achievements.gd:31
msgid "Reach round 30 in Overtime."
msgstr "Llega a la ronda 30 en la prórroga."

#: game/content/achievements.gd:31
msgid "Somebody unplug this thing."
msgstr "Que alguien desenchufe este trasto."

#: game/content/achievements.gd:32
msgid "Broke the Machine"
msgstr "Máquina rota"

#: game/content/achievements.gd:32
msgid "ERR ERR ERR. Please insert more digits."
msgstr "ERR ERR ERR. Inserte más dígitos, por favor."

#: game/content/achievements.gd:32
msgid "Score a single placement past the machine's limit (1,000,000,000,000,000 points)."
msgstr "Supera el límite de la máquina con una sola colocación (1 000 000 000 000 000 puntos)."

#: game/content/achievements.gd:32
msgid "Some scores are too big for any machine."
msgstr "Hay puntuaciones demasiado grandes para cualquier máquina."

#: game/content/achievements.gd:34
msgid "Blue Period"
msgstr "Época azul"

#: game/content/achievements.gd:34
msgid "Feeling a little blue? Feeling VERY blue."
msgstr "¿Un poco de bajón? No: MUY azul."

#: game/content/achievements.gd:34
msgid "Have 10 or more blue pieces in your bag."
msgstr "Ten 10 o más piezas azules en la bolsa."

#: game/content/achievements.gd:35
msgid "Have 10 or more Square pieces (2x2 or 3x3) in your bag."
msgstr "Ten 10 o más piezas Cuadrado (2x2 o 3x3) en la bolsa."

#: game/content/achievements.gd:35
msgid "Square Dance"
msgstr "Cuadrilla"

#: game/content/achievements.gd:35
msgid "Swing your partner, stack your blocks."
msgstr "Gira con tu pareja, apila tus bloques."

#: game/content/achievements.gd:36
msgid "Full Spectrum"
msgstr "Espectro completo"

#: game/content/achievements.gd:36
msgid "Have at least five pieces of every color in your bag."
msgstr "Ten al menos cinco piezas de cada color en la bolsa."

#: game/content/achievements.gd:36
msgid "Taste the whole toybox."
msgstr "Prueba todo el baúl de juguetes."

#: game/content/achievements.gd:37
msgid "Have 40 or more pieces in your bag."
msgstr "Ten 40 o más piezas en la bolsa."

#: game/content/achievements.gd:37
msgid "Packrat"
msgstr "Urraca"

#: game/content/achievements.gd:37
msgid "You never know when you'll need a spare T."
msgstr "Nunca sabes cuándo te hará falta una T de repuesto."

#: game/content/achievements.gd:38
msgid "Only the essentials."
msgstr "Solo lo imprescindible."

#: game/content/achievements.gd:38
msgid "Shrink your bag to 14 pieces or fewer."
msgstr "Reduce la bolsa a 14 piezas o menos."

#: game/content/achievements.gd:38
msgid "Travel Light"
msgstr "Equipaje ligero"

#: game/content/achievements.gd:39
msgid "Alchemist"
msgstr "Alquimista"

#: game/content/achievements.gd:39
msgid "Own pieces of all five materials at once: Chrome, Neon, Gold, Glass and Prism."
msgstr "Ten a la vez piezas de los cinco materiales: cromo, neón, oro, cristal y prisma."

#: game/content/achievements.gd:39
msgid "Plastic into gold, gold into glass."
msgstr "Plástico en oro, oro en cristal."

#: game/content/achievements.gd:40
msgid "Own pieces with all four stamps at once: Encore, Refund, Tip and Memory."
msgstr "Ten a la vez piezas con los cuatro sellos: Bis, Reembolso, Propina y Memoria."

#: game/content/achievements.gd:40
msgid "Signed, sealed, stamped four times."
msgstr "Firmado, lacrado y sellado cuatro veces."

#: game/content/achievements.gd:40
msgid "Special Delivery"
msgstr "Entrega especial"

#: game/content/achievements.gd:41
msgid "Fill every Joker slot."
msgstr "Llena todos los huecos de comodín."

#: game/content/achievements.gd:41
msgid "Full House"
msgstr "Completo"

#: game/content/achievements.gd:41
msgid "No vacancies at the Joker hotel."
msgstr "No quedan habitaciones en el hotel de los comodines."

#: game/content/achievements.gd:42
msgid "Hold three Rare Jokers at the same time."
msgstr "Ten tres comodines raros a la vez."

#: game/content/achievements.gd:42
msgid "Only the finest cardboard."
msgstr "Solo el cartón más fino."

#: game/content/achievements.gd:42
msgid "Rare Taste"
msgstr "Gusto exquisito"

#: game/content/achievements.gd:43
msgid "Master Plan"
msgstr "Plan maestro"

#: game/content/achievements.gd:43
msgid "Raise a shape family to Schematic level 3."
msgstr "Sube una familia de formas al nivel 3 de plano."

#: game/content/achievements.gd:43
msgid "The blueprints have blueprints."
msgstr "Los planos tienen planos."

#: game/content/achievements.gd:44
msgid "Hold 50 or more Credits."
msgstr "Ten 50 créditos o más."

#: game/content/achievements.gd:44
msgid "Oink."
msgstr "Oinc."

#: game/content/achievements.gd:44
msgid "Piggy Bank"
msgstr "Hucha"

#: game/content/achievements.gd:45
msgid "Even a wallet has a limit."
msgstr "Hasta una cartera tiene un límite."

#: game/content/achievements.gd:45
msgid "Hold the maximum 99 Credits."
msgstr "Ten el máximo de 99 créditos."

#: game/content/achievements.gd:45
msgid "Scrooge"
msgstr "El avaro"

#: game/content/achievements.gd:45
msgid "Swimming in coins is harder than it looks."
msgstr "Nadar en monedas es más difícil de lo que parece."

#: game/content/achievements.gd:47
msgid "Big Hit"
msgstr "Gran golpe"

#: game/content/achievements.gd:47
msgid "Ka-chunk."
msgstr "Ka-chunk."

#: game/content/achievements.gd:47
msgid "Score 1,000 points with one placement."
msgstr "Consigue 1 000 puntos con una colocación."

#: game/content/achievements.gd:48
msgid "Mega Hit"
msgstr "Megagolpe"

#: game/content/achievements.gd:48
msgid "Score 10,000 points with one placement."
msgstr "Consigue 10 000 puntos con una colocación."

#: game/content/achievements.gd:48
msgid "The receipt printer is sweating."
msgstr "La impresora de tickets está sudando."

#: game/content/achievements.gd:49
msgid "Giga Hit"
msgstr "Gigagolpe"

#: game/content/achievements.gd:49
msgid "Score 1,000,000 points with one placement."
msgstr "Consigue 1 000 000 de puntos con una colocación."

#: game/content/achievements.gd:49
msgid "That's a lot of zeros for one little piece."
msgstr "Son muchos ceros para una pieza tan pequeña."

#: game/content/achievements.gd:50
msgid "Clear three lines with one placement."
msgstr "Limpia tres líneas con una colocación."

#: game/content/achievements.gd:50
msgid "Stacked high and cleared clean."
msgstr "Bien apilado y bien limpio."

#: game/content/achievements.gd:50
msgid "Triple Decker"
msgstr "Triple piso"

#: game/content/achievements.gd:51
msgid "Clear four or more lines with one placement."
msgstr "Limpia cuatro o más líneas con una colocación."

#: game/content/achievements.gd:51
msgid "Four-Alarm Fire"
msgstr "Incendio de nivel 4"

#: game/content/achievements.gd:51
msgid "Somebody call the block brigade."
msgstr "Que alguien llame a la brigada de bloques."

#: game/content/achievements.gd:52
msgid "Clear a row and a column with one placement."
msgstr "Limpia una fila y una columna con una colocación."

#: game/content/achievements.gd:52
msgid "Crossroads"
msgstr "Encrucijada"

#: game/content/achievements.gd:52
msgid "X marks the spot."
msgstr "La X marca el lugar."

#: game/content/achievements.gd:53
msgid "Don't touch the board, it's hot."
msgstr "No toques el tablero, que quema."

#: game/content/achievements.gd:53
msgid "Reach the maximum combo (x4)."
msgstr "Alcanza el combo máximo (x4)."

#: game/content/achievements.gd:53
msgid "Red Hot"
msgstr "Al rojo vivo"

#: game/content/achievements.gd:54
msgid "Finish a round with at least three times its target."
msgstr "Termina una ronda con al menos el triple de su objetivo."

#: game/content/achievements.gd:54
msgid "Overkill"
msgstr "Exagerado"

#: game/content/achievements.gd:54
msgid "The target asked for a little. You gave a lot."
msgstr "El objetivo pedía poco. Tú diste muchísimo."

#: game/content/achievements.gd:55
msgid "By a Thread"
msgstr "Por los pelos"

#: game/content/achievements.gd:55
msgid "Close. So close. Close enough!"
msgstr "Cerca. Muy cerca. ¡Lo bastante cerca!"

#: game/content/achievements.gd:55
msgid "Win a round with your very last placement."
msgstr "Gana una ronda con tu última colocación."

#: game/content/achievements.gd:56
msgid "Leave the board completely empty after a clear (campaign)."
msgstr "Deja el tablero completamente vacío tras limpiar (campaña)."

#: game/content/achievements.gd:56
msgid "Spotless"
msgstr "Impecable"

#: game/content/achievements.gd:56
msgid "You could eat off this board."
msgstr "Se podría comer en este tablero."

#: game/content/achievements.gd:57
msgid "Get dealt a Grand Slam Tray Hand."
msgstr "Recibe una mano de bandeja Grand Slam."

#: game/content/achievements.gd:57 game/rules/hands.gd:17
msgid "Grand Slam"
msgstr "Grand Slam"

#: game/content/achievements.gd:57
msgid "Three of a kind, one color, all the lights."
msgstr "Tres iguales, un color y todas las luces."

#: game/content/achievements.gd:58
msgid "Full Deck"
msgstr "Baraja completa"

#: game/content/achievements.gd:58
msgid "See all five Tray Hands (across any runs)."
msgstr "Consigue las cinco manos de bandeja (en cualquier partida)."

#: game/content/achievements.gd:58
msgid "Twins, Staircase, Monochrome, Triplets, Grand Slam. Collected."
msgstr "Gemelos, Escalera, Monocromo, Trillizos, Grand Slam. Colección completa."

#: game/content/achievements.gd:60
msgid "Arcade Rookie"
msgstr "Novato del arcade"

#: game/content/achievements.gd:60
msgid "Put your initials in. Go on."
msgstr "Pon tus iniciales. Venga."

#: game/content/achievements.gd:60
msgid "Score 5,000 points in one Endless game."
msgstr "Consigue 5 000 puntos en una partida del modo Infinito."

#: game/content/achievements.gd:61
msgid "Arcade Regular"
msgstr "Habitual del arcade"

#: game/content/achievements.gd:61
msgid "Score 25,000 points in one Endless game."
msgstr "Consigue 25 000 puntos en una partida del modo Infinito."

#: game/content/achievements.gd:61
msgid "The cabinet knows your name."
msgstr "La máquina ya sabe tu nombre."

#: game/content/achievements.gd:62
msgid "Arcade Legend"
msgstr "Leyenda del arcade"

#: game/content/achievements.gd:62
msgid "Score 100,000 points in one Endless game."
msgstr "Consigue 100 000 puntos en una partida del modo Infinito."

#: game/content/achievements.gd:62
msgid "They're going to name the cabinet after you."
msgstr "Van a ponerle tu nombre a la máquina."

#: game/content/achievements.gd:63
msgid "Blockstorm"
msgstr "Tormenta de bloques"

#: game/content/achievements.gd:63
msgid "Reach the x10 combo in Endless."
msgstr "Alcanza el combo x10 en el modo Infinito."

#: game/content/achievements.gd:63
msgid "Ten out of ten. No notes."
msgstr "Un diez de diez. Sin pegas."

#: game/content/achievements.gd:64
msgid "Ahh. That new-board smell."
msgstr "Ahh. Ese olor a tablero nuevo."

#: game/content/achievements.gd:64
msgid "Clear the whole board in Endless."
msgstr "Vacía todo el tablero en el modo Infinito."

#: game/content/achievements.gd:64
msgid "Fresh Start"
msgstr "Borrón y cuenta nueva"

#: game/content/achievements.gd:65
msgid "BL...CKM...NIA? Where did everything go?"
msgstr "¿BL...CKM...NIA? ¿Adónde ha ido todo?"

#: game/content/achievements.gd:65
msgid "Have every letter of the BLOCKMANIA logo blown up at once."
msgstr "Haz estallar a la vez todas las letras del logo de BLOCKMANIA."

#: game/content/achievements.gd:65
msgid "The title looks awfully fragile."
msgstr "El título parece terriblemente frágil."

#: game/content/achievements.gd:65
msgid "Vandal"
msgstr "Vándalo"

#: game/content/achievements.gd:66
msgid "Night Shift"
msgstr "Turno de noche"

#: game/content/achievements.gd:66
msgid "Place a piece between midnight and 5 AM."
msgstr "Coloca una pieza entre la medianoche y las 5 de la mañana."

#: game/content/achievements.gd:66
msgid "Some players only come out after dark."
msgstr "Algunos jugadores solo salen de noche."

#: game/content/achievements.gd:66
msgid "The blocks glow brighter at night. Probably."
msgstr "Los bloques brillan más por la noche. Probablemente."

#: game/content/achievements.gd:67
msgid "Look Ma, No Lines"
msgstr "Mira, mamá, sin líneas"

#: game/content/achievements.gd:67
msgid "Technically, the rules never said you HAD to."
msgstr "Técnicamente, las reglas nunca dijeron que HUBIERA que hacerlo."

#: game/content/achievements.gd:67
msgid "Who needs lines anyway?"
msgstr "¿Quién necesita líneas?"

#: game/content/achievements.gd:67
msgid "Win a campaign round without clearing a single line."
msgstr "Gana una ronda de campaña sin limpiar ni una sola línea."

#: game/content/achievements.gd:68
msgid "Butterfingers"
msgstr "Manos de mantequilla"

#: game/content/achievements.gd:68
msgid "Handle with care."
msgstr "Manéjese con cuidado."

#: game/content/achievements.gd:68
msgid "Shatter a Glass piece."
msgstr "Rompe una pieza de cristal."

#: game/content/achievements.gd:68
msgid "That one's coming out of your allowance."
msgstr "Eso te lo descuento de la paga."

#: game/content/achievements.gd:69
msgid "In case of emergency, break something."
msgstr "En caso de emergencia, rompe algo."

#: game/content/achievements.gd:69
msgid "Through the Window"
msgstr "Por la ventana"

#: game/content/achievements.gd:69
msgid "Throw an Emergency Brick."
msgstr "Lanza un ladrillo de emergencia."

#: game/content/achievements.gd:69
msgid "Who's paying for that?"
msgstr "¿Quién va a pagar eso?"

#: game/content/achievements.gd:70
msgid "Always read the small text."
msgstr "Lee siempre la letra pequeña."

#: game/content/achievements.gd:70
msgid "Get a lost round replayed by Insurance Policy."
msgstr "Haz que la Póliza de seguro te repita una ronda perdida."

#: game/content/achievements.gd:70
msgid "Terms and conditions apply. Luckily, they applied to you."
msgstr "Se aplican términos y condiciones. Por suerte, se aplicaron a ti."

#: game/content/achievements.gd:70
msgid "The Fine Print"
msgstr "La letra pequeña"

#: game/content/achievements.gd:71
msgid "Block Maniac"
msgstr "Blockmaníaco"

#: game/content/achievements.gd:71
msgid "The whole trophy case. Every last shelf. Take a bow."
msgstr "Toda la vitrina. Hasta el último estante. Haz una reverencia."

#: game/content/achievements.gd:71
msgid "Unlock every other achievement."
msgstr "Desbloquea todos los demás logros."

#: game/content/achievements.gd:73
msgid "It hums a little when you hold it."
msgstr "Zumba un poco cuando lo sostienes."

#: game/content/achievements.gd:73
msgid "Once Upon a Legend"
msgstr "Érase una leyenda"

#: game/content/achievements.gd:73
msgid "Own a Legendary Joker."
msgstr "Ten un comodín legendario."

#: game/content/achievements.gd:74
msgid "Double Legend"
msgstr "Doble leyenda"

#: game/content/achievements.gd:74
msgid "One legend is a story. Two is a problem."
msgstr "Una leyenda es una historia. Dos son un problema."

#: game/content/achievements.gd:74
msgid "Own two Legendary Jokers at the same time."
msgstr "Ten dos comodines legendarios a la vez."

#: game/content/achievements.gd:74
msgid "The rack has never looked so smug."
msgstr "El estante nunca había parecido tan engreído."

#: game/content/achievements.gd:75
msgid "Own each of the four Legendary Jokers (across any runs)."
msgstr "Ten cada uno de los cuatro comodines legendarios (en cualquier partida)."

#: game/content/achievements.gd:75
msgid "Pantheon"
msgstr "Panteón"

#: game/content/achievements.gd:75
msgid "The Avalanche, the Mirrors, the Stone and the Star. All accounted for."
msgstr "La Avalancha, los Espejos, la Piedra y la Estrella. Todos presentes."

#: game/content/achievements.gd:76
msgid "Chain Reaction"
msgstr "Reacción en cadena"

#: game/content/achievements.gd:76
msgid "Chain three clear waves in one placement with The Avalanche."
msgstr "Encadena tres oleadas de limpieza en una colocación con La Avalancha."

#: game/content/achievements.gd:76
msgid "Nobody touch anything. Let it fall."
msgstr "Que nadie toque nada. Deja que caiga."

#: game/content/achievements.gd:77
msgid "How many of you are in there?"
msgstr "¿Cuántos de ti hay ahí dentro?"

#: game/content/achievements.gd:77
msgid "Mirror World"
msgstr "Mundo espejo"

#: game/content/achievements.gd:77
msgid "Score a placement where Hall of Mirrors doubles four other Jokers."
msgstr "Puntúa una colocación en la que el Salón de los Espejos duplique otros cuatro comodines."

#: game/content/achievements.gd:78
msgid "Chrome, neon, gold and glass. Very little plastic left."
msgstr "Cromo, neón, oro y cristal. Apenas queda plástico."

#: game/content/achievements.gd:78
msgid "Have 15 or more pieces with a material in your bag."
msgstr "Ten 15 o más piezas con material en la bolsa."

#: game/content/achievements.gd:78
msgid "Heavy Metal"
msgstr "Heavy metal"

#: game/content/achievements.gd:79
msgid "Eighteen lines and one very bright star."
msgstr "Dieciocho líneas y una estrella muy brillante."

#: game/content/achievements.gd:79
msgid "Going Nova"
msgstr "Hacia la nova"

#: game/content/achievements.gd:79
msgid "Score with Supernova at x10 Mult or more."
msgstr "Puntúa con Supernova a x10 Mult o más."

#: game/content/achievements.gd:80
msgid "Grow Snowball to x2 Mult or more."
msgstr "Haz crecer Bola de nieve hasta x2 Mult o más."

#: game/content/achievements.gd:80
msgid "It started as a pebble of snow."
msgstr "Empezó siendo un copito."

#: game/content/achievements.gd:80
msgid "Snowed In"
msgstr "Nevado"

#: game/content/achievements.gd:81
msgid "Compound Growth"
msgstr "Crecimiento compuesto"

#: game/content/achievements.gd:81
msgid "Earn the maximum interest (+5 Credits) after a round."
msgstr "Gana el interés máximo (+5 créditos) tras una ronda."

#: game/content/achievements.gd:81
msgid "Your Credits have been working harder than you."
msgstr "Tus créditos han trabajado más que tú."

#: game/content/achievements.gd:82
msgid "Have seven Joker slots."
msgstr "Ten siete huecos de comodín."

#: game/content/achievements.gd:82
msgid "Two Rack Extenders and a lot of shelf brackets."
msgstr "Dos ampliaciones de estante y muchas escuadras."

#: game/content/achievements.gd:82
msgid "Wide Rack"
msgstr "Estante ancho"

#: game/content/achievements.gd:83
msgid "Billionaire"
msgstr "Milmillonario"

#: game/content/achievements.gd:83
msgid "Nine zeros. The counter had to borrow some."
msgstr "Nueve ceros. El contador tuvo que pedir prestados algunos."

#: game/content/achievements.gd:83
msgid "Score 1,000,000,000 points with one placement."
msgstr "Consigue 1 000 000 000 de puntos con una colocación."

