	"clear_3": [["clear_3"], 0.0, 80],
	"combo_1": [["combo_1"], 0.0, 80],
	"combo_2": [["combo_2"], 0.0, 80],
	"combo_3": [["combo_3"], 0.0, 80],
	"joker_chips": [["joker_chips"], 0.0, 40],
	"joker_mult": [["joker_mult"], 0.0, 40],
	"joker_xmult": [["joker_xmult"], 0.0, 40],
	"coin": [["coin_1", "coin_2"], 0.03, 45],
	"buy": [["buy"], 0.02, 100],
