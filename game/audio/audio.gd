class_name BMAudio
extends Node
## Sound effects and music. Presentation only: nothing here reads or changes rules state, and
## cosmetic randomness (variants, pitch jitter, shuffle) uses the global RNG, never the run's.
##
## Buses: Master -> Music, SFX (created at startup). Every sound file is generated by
## tools/audio/ (gen_sfx.py, gen_music.py); relative loudness is baked into the files.

static var instance: BMAudio

const SFX_DIR := "res://assets/audio/sfx/"
const MUSIC_DIR := "res://assets/audio/music/"

## id -> [file variants, random pitch spread, minimum ms between plays].
const SFX := {
	"hover": [["ui_hover_1", "ui_hover_2"], 0.04, 45],
	"click": [["ui_click_1", "ui_click_2"], 0.03, 40],
	"back": [["ui_back"], 0.02, 60],
	"toggle_on": [["ui_toggle_on"], 0.0, 60],
	"toggle_off": [["ui_toggle_off"], 0.0, 60],
	"tick": [["ui_tick"], 0.0, 25],
	"card_hover": [["card_hover"], 0.08, 70],
	"modal": [["modal_open"], 0.03, 120],
	"pause_in": [["pause_in"], 0.0, 150],
	"pause_out": [["pause_out"], 0.0, 150],
	"bag_open": [["bag_open"], 0.04, 150],
	"bag_close": [["bag_close"], 0.04, 150],
	"select": [["select"], 0.02, 40],
	"deselect": [["deselect"], 0.02, 40],
	"pickup": [["pickup"], 0.05, 50],
	"putback": [["putback"], 0.05, 50],
	"key_move": [["key_move"], 0.03, 20],
	"place_s": [["place_s_1", "place_s_2", "place_s_3"], 0.03, 30],
	"place_m": [["place_m_1", "place_m_2", "place_m_3"], 0.03, 30],
	"place_l": [["place_l_1", "place_l_2", "place_l_3"], 0.03, 30],
	"deny": [["deny"], 0.0, 150],
	"pop": [["pop"], 0.0, 18],
	"glass": [["glass"], 0.06, 60],
	"stamp": [["stamp"], 0.04, 60],
	"clear_1": [["clear_1"], 0.0, 80],
